# Cloudflare Pages — response headers.
#
# Hashed bundles under /_astro can long-cache forever (their filenames change
# with content). Top-level named assets (favicons, og-image, manifest, PDFs)
# must NOT long-cache — they're referenced by stable names, so an aggressive
# cache strands old versions in browsers for up to a year when we update them.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Top-level named assets: short cache so updates propagate within a day.
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/icon-192.png
  Cache-Control: public, max-age=86400, must-revalidate

/icon-512.png
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.jpg
  Cache-Control: public, max-age=86400, must-revalidate
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/og-brand.jpg
  Cache-Control: public, max-age=86400, must-revalidate
/images/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap-*
  Cache-Control: public, max-age=3600, must-revalidate

# Log images: stable filenames — short cache.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate

# Demo files: always revalidate — stable filenames updated in-place on each deploy.
/demos/*
  Cache-Control: no-cache, must-revalidate

# Downloads (skill zips, book PDF/MD): stable filenames updated in-place — short cache.
/downloads/*
  Cache-Control: public, max-age=3600, must-revalidate

# Universal links (#133): iOS fetches this to learn that missionbuilt.io/join opens IronStack.
# No extension, so the type is set here; a short cache, so a change reaches phones within a day.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600, must-revalidate

# The board's QR lands here when IronStack isn't installed (#133). The pairing secret is in the
# URL's fragment, which a browser never sends. This page must never read it: no script may run
# and nothing may be fetched from it, on top of the site-wide policy below (both are enforced).
# Cloudflare joins the two Referrer-Policy values, which may leave the site-wide one in force;
# the page's own <meta name="referrer"> sets no-referrer. A browser never puts the fragment in a
# referrer either way. Outside this file: Web Analytics, Zaraz and any challenge page must stay
# off /join (a challenge page runs Cloudflare's script at this URL).
/join
  Content-Security-Policy: script-src 'none'; connect-src 'none'
  Referrer-Policy: no-referrer
/join/
  Content-Security-Policy: script-src 'none'; connect-src 'none'
  Referrer-Policy: no-referrer

# Content-Security-Policy: Astro and the demo pages use inline <script>/<style>,
# so 'unsafe-inline' is required until those are hashed. Everything else is locked
# to this origin — no third-party script host can execute here, and no page can be
# framed or post a form off-site. Google Fonts is the only external origin allowed.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
