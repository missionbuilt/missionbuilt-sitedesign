/**
 * Cloudflare Pages config for the missionbuilt static site.
 *
 * The site is fully static (Astro `output: 'static'`). `pages_build_output_dir`
 * tells wrangler where the built assets live so `wrangler pages deploy` works
 * without a positional argument.
 */
{
  "name": "missionbuilt",
  "compatibility_date": "2026-05-10",
  "pages_build_output_dir": "./dist",

  // MealStack beta sign-ups (functions/api/beta.js). BETA_KV holds the list;
  // the BETA_ADMIN_KEY secret (set with `npx wrangler pages secret put
  // BETA_ADMIN_KEY --project-name missionbuilt`) unlocks the listing at
  // https://missionbuilt.io/api/beta?key=<BETA_ADMIN_KEY>. Namespace created
  // Sept 13, 2026 with `npx wrangler kv namespace create BETA_KV`.
  "kv_namespaces": [
    { "binding": "BETA_KV", "id": "882bc29d0b19443dbb1605c184f0f799" }
  ]
}
