---
/**
 * BaseLayout — wraps every page with <html>, <head>, fonts, global styles.
 * Uses `bg` slot if a page wants a custom ambient background behind content.
 */
interface Props {
  title?: string;
  description?: string;
  /** og:type — 'website' for marketing pages, 'book' or 'article' for chapters */
  ogType?: 'website' | 'book' | 'article';
  /** Path (or absolute URL) of the share image. Defaults to /og-image.jpg. */
  ogImage?: string;
  /** Alt text for the og:image. */
  ogImageAlt?: string;
  /** Active top-nav link key: 'book' | 'chapters' | 'loadout' | 'rack' | 'logs' | 'about' | 'source' */
  active?: 'home' | 'book' | 'chapters' | 'loadout' | 'rack' | 'coach' | 'plans' | 'logs' | 'about' | 'source' | undefined;
  /** The page's one address, when it is served at more than one (a path, e.g. '/rack/mealstack/privacy/'). */
  canonical?: string;
  /** Keep the page out of search: no canonical, no og:url (the 404 page). */
  noindex?: boolean;
}

const SITE = 'https://missionbuilt.io';

// The defaults are the brand's (launch preview, plan §9, 2026-10-15): the apps lead. The book's
// pages pass BOOK_META (src/data/book-meta.ts) to keep the book's title, line and share card.
const {
  title = 'Lifting, meal timing and gym TV apps · Mission Built',
  description = 'Log every set on iPhone and Apple Watch, time meals around your training, and put the workout on the gym TV. Three apps, launching January 1.',
  ogType = 'website',
  ogImage = '/images/og-brand.jpg',
  ogImageAlt = 'Mission Built. Log every set. Time every meal. Put every workout on the big screen. Three apps, launching January 1.',
  canonical,
  noindex = false,
} = Astro.props;

// Absolute URLs for everything social scrapers need
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE).toString();
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Mission Built" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Twitter / X — summary_large_image so the OG image renders full-width */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Theme color — match charcoal bg so mobile chrome blends */}
    <meta name="theme-color" content="#171513" />

    {/* Fonts: Oswald (display), Merriweather (serif body), JetBrains Mono (mono), self-hosted from
        /fonts since 2026-10-15 (src/styles/fonts.css, imported by global.css): no visitor's IP goes to
        Google for a font (privacy review of the launch preview). */}
    <link rel="preload" href="/fonts/oswald-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Favicon set: barbell mark — oxblood plates, chalk bar, charcoal canvas.
        The ?v=2 cache-buster forces browsers to re-fetch when the icon changes;
        bump it whenever the favicon is updated. */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Per-page head extras, e.g. JSON-LD: <script is:inline slot="head" type="application/ld+json" ...> */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <style is:global>
      @import "../styles/global.css";
    </style>
  </body>
</html>
