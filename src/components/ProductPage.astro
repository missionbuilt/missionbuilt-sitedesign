---
/**
 * One product page (the rebuild, Mike 2026-10-16 08:27 and 08:32): "less is more", one page per
 * app whose only job is the download or the beta join, in the way Apple introduces iPhone Duo
 * (hq/briefs/site/apple-duo-reference.md).
 *
 * Order: a sticky local bar (the name and one button) → the hero (name, one short line, one
 * device) → one chapter per screen (a short headline, one sentence, one big real screen) →
 * works with the other two → the promise (privacy, in one line) → the button again → links to
 * the details. No demos, tours, simulated logging or countdowns (Mike 08:32).
 *
 * Motion is our own CSS only: scroll-driven reveal and a small zoom on the device, inside
 * @supports (animation-timeline: view()) and prefers-reduced-motion: no-preference. The default
 * style is the finished, visible state, so a browser without it just shows the page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from './TopNav.astro';
import SiteFooter from './SiteFooter.astro';
import PhoneFrame from './PhoneFrame.astro';
import WatchFrame from './WatchFrame.astro';
import TabletFrame from './TabletFrame.astro';
import TvFrame from './TvFrame.astro';

type Shot = { src: string; w: number; h: number; alt: string };
type Kind = 'phone' | 'watch' | 'tablet' | 'tv';
type Device = { kind: Kind; shot: Shot };
export type Chapter = {
  /** One to five words, ends with a period. */
  title: string;
  /** One sentence. */
  line: string;
  devices: Device[];
  /** Not in testers' hands yet: true shows "Coming soon"; a string shows that label (e.g. "Coming January 1"). */
  soon?: boolean | string;
  /** One link under the line (to the details page), when the idea needs one more step. */
  link?: Link;
  /** A day drawn as a strip (MealStack): the workout is a row, not a label (the panel 10-16, Mike's fix 10). */
  day?: { time: string; label: string; workout?: boolean }[];
};
export type Link = { label: string; href: string };

interface Props {
  title: string;
  description: string;
  ogImageAlt?: string;
  ld?: object;
  active?: 'rack' | 'coach';
  noindex?: boolean;
  /** The product name in the bar and the hero. */
  name: string;
  icon?: { src: string; src2x: string; alt: string };
  /** The hero's short line (a few words). */
  line: string;
  /** One sentence under it. */
  sub: string;
  hero: Device[];
  cta: Link;
  /** The line under the button (one of Mike's allowed free lines, or a date). */
  ctaNote?: string;
  /** What it needs and runs on, said up front (the panel 10-16: Marcus). */
  heroFacts?: string[];
  chapters: Chapter[];
  family?: { title: string; items: { name: string; line: string; href?: string; icon?: { src: string; src2x: string; alt: string } }[] };
  promise?: { title: string; line: string; href?: string };
  closer: { title: string; line?: string };
  more: Link[];
}

const p = Astro.props;
const hasJoin = Astro.slots.has('join');
---
<BaseLayout title={p.title} description={p.description} ogImageAlt={p.ogImageAlt} active={p.active ?? 'rack'} noindex={p.noindex}>
  {p.ld && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(p.ld)} />}
  <TopNav />

  <div class="localbar">
    <span class="lb-name">{p.name}</span>
    <nav class="lb-links" aria-label={`${p.name} pages`}>
      {p.more.slice(0, 2).map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="lb-cta" href={p.cta.href}>{p.cta.label}</a>
    </nav>
  </div>

  <main id="main" class="pp">
    <section class="pp-hero">
      {p.icon && <img class="pp-icon" src={p.icon.src} srcset={`${p.icon.src} 1x, ${p.icon.src2x} 2x`} width="88" height="88" alt={p.icon.alt} />}
      <h1 class="pp-name">{p.name}</h1>
      <p class="pp-line">{p.line}</p>
      <p class="pp-sub">{p.sub}</p>
      <div class="pp-cta">
        <a class="btn primary" href={p.cta.href}>{p.cta.label} <span aria-hidden="true">→</span></a>
        {p.ctaNote && <p class="pp-note">{p.ctaNote}</p>}
      </div>
      {p.heroFacts && <ul class="pp-facts">{p.heroFacts.map((f) => <li>{f}</li>)}</ul>}
      <div class:list={['pp-stage', 'hero', `n${p.hero.length}`]}>
        {p.hero.map((d, i) => (
          <div class:list={['dev', d.kind, `d${i}`]}>
            {d.kind === 'phone' ? <PhoneFrame shot={d.shot} lazy={false} priority={i === 0} fill />
              : d.kind === 'watch' ? <WatchFrame shot={d.shot} lazy={false} />
              : d.kind === 'tv' ? <TvFrame shot={d.shot} lazy={false} priority={i === 0} fill />
              : <TabletFrame shot={d.shot} lazy={false} priority={i === 0} fill />}
          </div>
        ))}
      </div>
    </section>

    {p.chapters.map((c) => (
      <section class:list={['pp-ch', !c.devices.length && !c.day && 'bare']}>
        <div class="ch-text reveal">
          {c.soon && <p class="soon">{typeof c.soon === 'string' ? c.soon : 'Coming soon'}</p>}
          <h2 class="ch-title">{c.title}</h2>
          <p class="ch-line">{c.line}</p>
          {c.link && <a class="text-link ch-link" href={c.link.href}>{c.link.label} <span aria-hidden="true">→</span></a>}
        </div>
        {c.day && (
          <ol class="day reveal" aria-label="One training day">
            {c.day.map((d) => <li class:list={{ w: d.workout }}><span class="d-t">{d.time}</span><span class="d-dot" aria-hidden="true"></span><span class="d-l">{d.label}</span></li>)}
          </ol>
        )}
        {c.devices.length > 0 && <div class:list={['pp-stage', 'zoom', `n${c.devices.length}`]}>
          {c.devices.map((d, i) => (
            <div class:list={['dev', d.kind, `d${i}`]}>
              {d.kind === 'phone' ? <PhoneFrame shot={d.shot} fill />
                : d.kind === 'watch' ? <WatchFrame shot={d.shot} />
                : d.kind === 'tv' ? <TvFrame shot={d.shot} fill />
                : <TabletFrame shot={d.shot} fill />}
            </div>
          ))}
        </div>}
      </section>
    ))}

    {p.family && (
      <section class="pp-family reveal">
        <h2 class="ch-title">{p.family.title}</h2>
        <ul>
          {p.family.items.map((f) => (
            <li>
              {f.icon && <img src={f.icon.src} srcset={`${f.icon.src} 1x, ${f.icon.src2x} 2x`} width="64" height="64" alt={f.icon.alt} loading="lazy" />}
              <p class="f-name">{f.href ? <a href={f.href}>{f.name}</a> : f.name}</p>
              <p class="f-line">{f.line}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {p.promise && (
      <section class="pp-promise reveal">
        <h2 class="ch-title">{p.promise.title}</h2>
        <p class="ch-line">{p.promise.line}</p>
        {p.promise.href && <a class="text-link" href={p.promise.href}>What leaves your phone, and what doesn't <span aria-hidden="true">→</span></a>}
      </section>
    )}

    <section class="pp-closer reveal" id="join">
      {/* /api/beta's no-JS redirect lands on #beta. */}
      <span id="beta" aria-hidden="true"></span>
      <h2 class="ch-title">{p.closer.title}</h2>
      {p.closer.line && <p class="ch-line">{p.closer.line}</p>}
      {hasJoin ? <slot name="join" /> : <a class="btn primary" href={p.cta.href}>{p.cta.label} <span aria-hidden="true">→</span></a>}
      {p.ctaNote && <p class="pp-note">{p.ctaNote}</p>}
      <slot name="after" />
      <ul class="pp-more">
        {p.more.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .localbar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px var(--pad-page-x); background: rgba(23, 21, 19, 0.82); -webkit-backdrop-filter: saturate(1.4) blur(14px); backdrop-filter: saturate(1.4) blur(14px); border-bottom: var(--border-thin); }
  .lb-name { font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-chalk); }
  .lb-links { display: flex; align-items: center; gap: 22px; }
  .lb-links a { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-chalk-dim); border: 0; }
  .lb-links a:hover { color: var(--color-chalk); }
  .lb-links a.lb-cta { padding: 8px 14px; background: var(--color-blood); color: var(--color-chalk); font-family: var(--font-display); font-weight: 600; font-size: 13px; letter-spacing: 0.06em; }

  .pp { overflow-x: clip; }
  .pp-hero { padding: 72px var(--pad-page-x) 24px; text-align: center; }
  .pp-icon { display: block; margin: 0 auto 22px; border-radius: 20px; }
  .pp-name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(48px, 10vw, 128px); line-height: 0.92; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .pp-line { margin: 14px 0 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.1; letter-spacing: 0.01em; color: var(--color-chalk); }
  .pp-sub { margin: 18px auto 0; max-width: 34ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.55; color: var(--color-chalk-dim); }
  .pp-cta { margin-top: 28px; display: grid; justify-items: center; gap: 10px; }
  .pp-note { margin: 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; color: var(--color-chalk-faint); }

  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 15px 26px; font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--color-rule); color: var(--color-chalk); }
  .btn.primary { background: var(--color-blood); border-color: var(--color-blood); }
  .btn.primary:hover { background: var(--color-blood-bright); }
  .text-link { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-chalk); }

  /* The stage: one, two or three devices, centred and big. */
  .pp-stage { position: relative; margin: 48px auto 0; display: flex; align-items: flex-end; justify-content: center; gap: 28px; max-width: 1100px; }
  .dev.phone { width: min(300px, 62vw); }
  /* WatchFrame is sized in em: one font-size scales the whole watch. */
  .dev.watch { font-size: clamp(11px, 2.2vw, 16px); }
  .zoom.n1 .dev.watch { font-size: clamp(18px, 3.6vw, 27px); }
  .dev.tablet { width: min(860px, 100%); }
  .dev.tv { width: min(980px, 100%); }
  .n2 .dev.phone { width: min(270px, 42vw); }
  .n3 .dev.phone { width: min(240px, 34vw); }
  /* A phone with a watch beside it (the hero): the watch sits low, overlapping. */
  .n2 .dev.watch { margin-left: -64px; margin-bottom: 24px; z-index: 2; }
  /* A tablet with a phone in front. */
  .n2 .dev.tablet + .dev.phone { position: absolute; right: max(2vw, 0px); bottom: -24px; width: min(220px, 30vw); }
  .n2 .dev.tablet { margin-right: 12vw; }

  .pp-ch { min-height: min(92svh, 1100px); display: grid; align-content: center; padding: 96px var(--pad-page-x) 40px; text-align: center; border-top: var(--border-thin); }
  .ch-text { max-width: 760px; margin: 0 auto; }
  /* A chapter with no picture is one short screen, not a tall empty one (the panel 10-16). */
  .pp-ch.bare { min-height: 0; padding-top: 88px; padding-bottom: 88px; }
  .ch-link { display: inline-block; margin-top: 22px; }
  .pp-facts { list-style: none; margin: 22px auto 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 22px; max-width: 760px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--color-chalk-dim); }
  .pp-facts li::before { content: '·'; margin-right: 8px; color: var(--color-chalk-faint); }
  .soon { display: inline-block; margin: 0 0 14px; padding: 4px 10px; border: 1px dashed var(--color-chalk-ghost); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-chalk-dim); }
  .ch-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(40px, 6.4vw, 76px); line-height: 0.98; letter-spacing: -0.015em; text-transform: uppercase; color: var(--color-chalk); }
  .ch-line { margin: 18px auto 0; max-width: 36ch; font-family: var(--font-serif); font-size: clamp(18px, 2vw, 21px); line-height: 1.55; color: var(--color-chalk-dim); }

  /* The day strip: one row per meal, the workout as its own row, lit. */
  .day { list-style: none; margin: 48px auto 0; padding: 0; max-width: 580px; text-align: left; position: relative; }
  .day::before { content: ''; position: absolute; left: 118px; top: 14px; bottom: 14px; width: 1px; background: var(--color-rule); }
  .day li { display: grid; grid-template-columns: 100px 36px minmax(0, 1fr); align-items: center; padding: 10px 0; }
  .d-t { text-align: right; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.06em; color: var(--color-chalk-faint); }
  .d-dot { justify-self: center; width: 10px; height: 10px; background: var(--color-chalk); position: relative; z-index: 1; }
  .d-l { font-family: var(--font-display); font-weight: 500; font-size: 20px; letter-spacing: 0.02em; text-transform: uppercase; color: var(--color-chalk-dim); }
  .day li.w { margin: 8px 0; padding: 16px 16px 16px 0; background: var(--color-panel); border: 1px solid var(--color-rule); }
  .day li.w .d-dot { width: 14px; height: 14px; background: var(--color-blood); }
  .day li.w .d-t, .day li.w .d-l { color: var(--color-chalk); }
  .day li.w .d-l { font-weight: 700; font-size: 24px; }
  .pp-family, .pp-promise, .pp-closer { padding: 112px var(--pad-page-x) 40px; text-align: center; border-top: var(--border-thin); }
  .pp-family ul { list-style: none; margin: 44px auto 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 36px; max-width: 900px; }
  .pp-family img { display: block; margin: 0 auto 14px; border-radius: 14px; }
  .f-name { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-chalk); }
  .f-line { margin: 8px auto 0; max-width: 28ch; font-family: var(--font-serif); font-size: 16px; line-height: 1.55; color: var(--color-chalk-dim); }
  .pp-promise .text-link { display: inline-block; margin-top: 22px; }
  .pp-closer { padding-bottom: 96px; scroll-margin-top: 72px; }
  #beta { display: block; scroll-margin-top: 72px; }
  .pp-closer .btn { margin-top: 30px; }
  .pp-closer .pp-note { margin-top: 12px; }
  .pp-more { list-style: none; margin: 40px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; }
  .pp-more a { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-chalk-dim); }

  /* Motion: our own CSS, only where the browser has it and the person hasn't asked for less. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reveal { animation: rise linear both; animation-timeline: view(); animation-range: entry 5% cover 30%; }
      .zoom { animation: zoomin linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; transform-origin: 50% 80%; }
      .hero { animation: recede linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
    }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(36px); } to { opacity: 1; transform: none; } }
  @keyframes zoomin { from { opacity: 0.2; transform: scale(0.86); } to { opacity: 1; transform: none; } }
  @keyframes recede { from { opacity: 1; transform: none; } to { opacity: 0.35; transform: scale(0.92); } }

  @media (max-width: 1000px) {
    .localbar, .pp-hero, .pp-ch, .pp-family, .pp-promise, .pp-closer { padding-left: var(--pad-page-x-mid); padding-right: var(--pad-page-x-mid); }
  }
  @media (max-width: 720px) {
    .localbar, .pp-hero, .pp-ch, .pp-family, .pp-promise, .pp-closer { padding-left: var(--pad-page-x-mobile); padding-right: var(--pad-page-x-mobile); }
    .lb-links a:not(.lb-cta) { display: none; }
    .pp-ch { min-height: 0; padding-top: 72px; }
    .n2 .dev.watch { margin-left: -40px; }
    .n3 { gap: 10px; }
  }
</style>
