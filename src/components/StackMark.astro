---
/**
 * The Stack mark (plan §3a, Mike 2026-10-16 15:22: "we talked about incorporating the stack icon"):
 * the three real app icons side by side, in stack order. Not a new combined icon; that's Mike's call.
 * Used on The Full Stack row (/rack/plans) and the Stack band on the home and /rack.
 */
import { STACK } from '../data/apps';
interface Props {
  /** Icon size in px. */
  size?: number;
  /** Overlap the icons a little, like a stack. */
  tight?: boolean;
  label?: string;
}
const { size = 64, tight = false, label = 'IronStack, MealStack and MissionStack' } = Astro.props;
---
<span class:list={['mark', tight && 'tight']} role="img" aria-label={label} style={`--s:${size}px`}>
  {STACK.map((a) => (
    <img src={a.icon.src} srcset={`${a.icon.src} 1x, ${a.icon.src2x} 2x`} width={size} height={size} alt="" loading="lazy" />
  ))}
</span>

<style>
  .mark { display: inline-flex; align-items: center; gap: calc(var(--s) * 0.18); }
  .mark img { display: block; width: var(--s); height: var(--s); border-radius: 22.37%; border: 1px solid var(--color-rule); background: var(--color-bg); }
  .mark.tight { gap: 0; }
  .mark.tight img + img { margin-left: calc(var(--s) * -0.16); box-shadow: -4px 0 0 var(--color-bg); }
</style>
