---
/**
 * Doctrine — the boxed set of principles a note rests on.
 * Sunken panel, 2px oxblood rule on top. Children are <Pillar>s.
 */
interface Props { head: string }
const { head } = Astro.props;
---
<div class="doctrine">
  <p class="doctrine-head">{head}</p>
  <slot />
</div>

<style>
  .doctrine {
    background: var(--color-panel);
    border-top: 2px solid var(--color-blood);
    border-bottom: var(--border-thin);
    padding: 26px 22px 10px;
    margin: 32px 0 36px;
  }
  .doctrine-head {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-chalk);
  }
</style>
