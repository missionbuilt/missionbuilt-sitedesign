---
/** Where something stands right now: sunken panel with an army left rail. Dated content lives here. */
interface Props { tag: string }
const { tag } = Astro.props;
---
<div class="status">
  <span class="tag">{tag}</span>
  <slot />
</div>

<style>
  .status {
    background: var(--color-panel);
    border-left: 3px solid var(--color-army);
    padding: 20px 20px 4px;
    margin: 30px 0;
  }
  .tag {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-army);
  }
  .status :global(p) { font-size: 16px; }
</style>
