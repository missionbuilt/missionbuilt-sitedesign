---
/** A ruled aside: mono tag in army green, then a paragraph or two. */
interface Props { tag: string }
const { tag } = Astro.props;
---
<div class="aside">
  <span class="tag">{tag}</span>
  <slot />
</div>

<style>
  .aside {
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    padding: 18px 0;
    margin: 30px 0;
  }
  .tag {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-army);
  }
  .aside :global(p) { font-size: 16px; color: var(--color-chalk-dim); }
  .aside :global(p:last-child) { margin-bottom: 0; }
</style>
