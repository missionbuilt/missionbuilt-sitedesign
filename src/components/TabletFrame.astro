---
/**
 * TabletFrame.astro: an iPad, held landscape, drawn around a real iPad screenshot, in the same
 * titanium as PhoneFrame and WatchFrame so every device on the site matches (#193).
 *
 * Only the frame is drawn: a case with a 1px edge, an even black bezel, the front camera on the
 * long top edge and the top button on the top right. The screen inside is always a real
 * screenshot (never draw app screens in HTML); until it is captured, a slot with the file name
 * stands in.
 *
 * Sized in em, so one font-size on the parent scales the whole iPad: the frame is 24 em wide
 * (case padding 0.3 em at radius 1.5 em, bezel padding 0.7 em at radius 1.2 em), and its height
 * follows the screenshot. `fill` sizes it to the width of its box (font-size = box width / 24).
 */
import { hasScreen, slotName } from '../data/screens';

type Shot = { src: string; w: number; h: number; alt: string };
interface Props {
  shot: Shot;
  lazy?: boolean;
  priority?: boolean;
  fill?: boolean;
}
const { shot, lazy = true, priority = false, fill = false } = Astro.props;
const ready = hasScreen(shot.src);
---
<div class:list={['tablet-box', fill && 'fill']}>
  <div class="tablet">
    <span class="btn top" aria-hidden="true"></span>
    <div class="case">
      <div class="bezel">
        <span class="cam" aria-hidden="true"></span>
        {ready
          ? <img src={shot.src} width={shot.w} height={shot.h} alt={shot.alt} loading={lazy ? 'lazy' : 'eager'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
          : <div class="screen-slot" role="img" aria-label={shot.alt} style={`aspect-ratio:${shot.w}/${shot.h}`}><b>Screen to capture</b><span>{slotName(shot.src)}</span></div>}
      </div>
    </div>
  </div>
</div>

<style>
  .tablet-box.fill { width: 100%; container-type: inline-size; }
  .tablet-box.fill .tablet { font-size: calc(100cqi / 24.2); }
  .tablet { --ti: #3b3834; --ti-edge: #5a564f; position: relative; isolation: isolate; width: 24em; }
  .case { position: relative; z-index: 1; padding: 0.3em; background: var(--ti); border-radius: 1.5em; outline: 1px solid var(--ti-edge); }
  .bezel { position: relative; padding: 0.7em; background: #000; border-radius: 1.2em; }
  .cam { position: absolute; top: 0.27em; left: 50%; width: 0.22em; height: 0.22em; transform: translateX(-50%); background: #1c1c1e; border-radius: 50%; }
  .bezel img { display: block; width: 100%; height: auto; border-radius: 0.55em; }
  .bezel .screen-slot { border-radius: 0.55em; font-size: max(12px, 0.5em); }
  .btn { position: absolute; z-index: 0; height: 0.3em; background: var(--ti); outline: 1px solid var(--ti-edge); border-radius: 0.1em; }
  .btn.top { top: -0.14em; right: 2.4em; width: 1.9em; }
</style>
