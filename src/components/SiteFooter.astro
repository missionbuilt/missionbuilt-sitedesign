---
import { MISSIONSTACK_ANNOUNCED } from '../data/missionstack-gate.mjs';
/**
 * SiteFooter — the one footer every page shares.
 *
 * Row 1 (optional): links for the page you're on (a repo, release notes).
 * Row 2: the tagline left, site links right. Source and Download live here
 * so the TopNav can stay short.
 *
 * Place it after </main> so it reads as the page's contentinfo landmark.
 */
interface FootLink {
  label: string;
  href: string;
  /** Opens in a new tab (repos, outside sites). */
  external?: boolean;
}

interface Props {
  links?: FootLink[];
  /** Leave the email address out. Cloudflare's Email Address Obfuscation (on, Mike 2026-10-11)
   * injects a script into any page with an address, and /join must run none (#133). */
  noEmail?: boolean;
}

const { links = [], noEmail = false } = Astro.props;

const site: FootLink[] = [
  // Launch preview (plan §2): Compare · Support · Press · Get in first, then the book's and the
  // Loadout's links (the Loadout left the top nav).
  // Mike 2026-10-16 08:34: the book and the Logs stay the story behind the apps, linked here.
  { label: 'The book', href: '/chapters' },
  { label: 'Logs', href: '/logs' },
  { label: 'About Mike', href: '/about' },
  { label: 'Get in first', href: '/first' },
  { label: 'Compare', href: '/rack/compare' },
  { label: 'Support', href: '/rack/support' },
  { label: 'Press', href: '/press' },
  { label: 'The Loadout', href: '/loadout' },
  { label: 'Download', href: '/download' },
  { label: 'Source',   href: '/source' },
  { label: 'RSS',      href: '/logs/rss.xml' },
];
---
<footer class="site-foot">
  {links.length > 0 && (
    <nav class="sf-row sf-page" aria-label="More on this page">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
        >{l.label}{l.external && <span class="ext" aria-hidden="true"> ↗</span>}</a>
      ))}
    </nav>
  )}

  <div class="sf-row sf-main">
    <p class="sf-tag">Real strength is lifting others</p>
    <nav class="sf-site" aria-label="Site">
      {site.map((l) => <a href={l.href}>{l.label}</a>)}
      {!noEmail && <a href="mailto:mike@missionbuilt.io" class="sf-mail">mike@missionbuilt.io</a>}
    </nav>
  </div>

  <p class="sf-fine">
    {/* Mission Built LLC (2026-10-15). Mike 2026-10-16 09:3x: "just put the company on the site", so
        Mission Built joins the line; MissionStack is in it wherever its name is public (the gate). */}
    © 2026 Mission Built LLC. The book is by Mike Nichols,
    <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener license">CC BY-NC-SA 4.0</a>.
    {MISSIONSTACK_ANNOUNCED ? 'Mission Built, IronStack, MealStack and MissionStack' : 'Mission Built, IronStack and MealStack'} are trademarks of Mission Built LLC. <a href="/rack/acknowledgements">Acknowledgements</a>.
  </p>
</footer>

<style>
  .site-foot {
    margin-top: 56px;
    padding: 24px var(--pad-page-x) 40px;
    border-top: var(--border-thin);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-chalk-faint);
    position: relative;
    z-index: 1;
  }

  .sf-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 28px;
  }
  .sf-page {
    justify-content: flex-start;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: var(--border-dashed);
  }

  .sf-tag { margin: 0; }

  .sf-site {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  a {
    color: var(--color-chalk-dim);
    transition: color 120ms ease-out;
  }
  a:hover { color: var(--color-chalk); }
  .sf-mail { text-transform: none; letter-spacing: 0.06em; }
  .ext { color: var(--color-chalk-faint); }

  .sf-fine {
    margin: 18px 0 0;
    max-width: none;
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--color-chalk-faint);
  }
  .sf-fine a {
    color: var(--color-chalk-dim);
    border-bottom: 1px solid var(--color-chalk-ghost);
  }

  @media (max-width: 1099px) {
    .site-foot { padding: 22px var(--pad-page-x-mid) 36px; }
  }
  @media (max-width: 720px) {
    .site-foot { padding: 22px var(--pad-page-x-mobile) 32px; margin-top: 40px; }
    .sf-main { flex-direction: column; align-items: flex-start; }
  }
</style>
