---
/**
 * Ironstack landing page (/rack/ironstack). Short on purpose: what is different,
 * the key features with real screens, how to get it. Everything else is on
 * /rack/ironstack/details (the full page as of Sept 19, 2026). See AppLanding.astro.
 *
 * Sept 20, 2026: Mike's rule, no competitor named in the hero. His story leads: he used them
 * all, each was missing something, this puts it in one place. The "Most apps:" lines are
 * neutral on purpose (a Pro user read the old free-tier lines as snide); named comparisons
 * live on /details, where people ask for them.
 */
import AppLanding from '../../components/AppLanding.astro';

const IMG = '/images/ironstack/';
const s = (f: string, alt: string, h = 1188) => ({ src: `${IMG}${f}.webp`, w: 540, h, alt });

const title = 'Ironstack: the lifting log for chalky hands · Mission Built';
const description = 'Ironstack is a lifting log for iPhone. Tap last time\'s numbers, type 225x8, or say the set. The rest clock talks in your earbuds. Bring your Hevy or Strong history and keep the app you use now. Free during the private beta.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ironstack',
  url: 'https://missionbuilt.io/rack/ironstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built', url: 'https://missionbuilt.io' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', description: 'Free during the private beta. Launch price not yet set.' },
};
---
<AppLanding
  app="ironstack"
  name="Ironstack"
  title={title}
  description={description}
  ogImageAlt="Ironstack. Log it. Time it. Lift each other up. A lifting log for iPhone, by Mission Built."
  ld={ld}
  promise="Log fast. See progress."
  promiseAccent="A coach in your corner."
  sub="I used them all, and every one was missing something. Ironstack puts it in one place: sets you tap, type or say, big rest and EMOM clocks, insights that show you getting stronger, a crew that lifts you up, and a Coach that picks your opener, your next jump, or a swap when the rack is taken, from your own sets. Bring your history; your old app is never touched."
  subShort="I used them all. Each was missing something. This puts the log, your progress, your crew and a Coach in one place."
  trust={['Free during the beta', 'iPhone, iOS 26+', 'No account to log', 'Bring your history']}
  hero={[
    s('log-session', 'Ironstack mid-session: Comp Squat, two sets logged at 275 for 5, the third ready to confirm with one tap, and the rest clock at 1:52.', 1174),
    s('coach-swap', 'Ironstack Coach with the squat rack taken: swap Comp Squat for SSB Box Squat, and open at 220 for 5 at RPE 6.5, under a ceiling of 302 lb from your own sets.', 1176),
  ]}
  soft={{ label: 'Switching apps? Bring your history →', href: '/rack/ironstack/details#from-hevy' }}
  diffLabel="Why Ironstack"
  diffH2="Everything I needed, in one app."
  themLabel="Most apps:"
  diffs={[
    { claim: 'Built to log.', body: 'Nothing else gets in the way. Last time is already in the set, so most sets are one tap. Or type 225x8 @7, or say it when your hands are covered in chalk. Big rest and EMOM clocks start themselves and call time in your earbuds.', them: 'A keypad for every set, and a timer that beeps.' },
    { claim: 'See yourself progress.', body: 'Not just history. This month against last, your estimated max over twelve weeks, records by name, and how your lifting lines up with your sleep. Measured against you and nobody else.', them: 'Graphs. Working out what they mean is your job.' },
    { claim: 'Lift each other up.', body: 'Only the people you train with. Share a session card and back each other up. Badges for showing up and for supporting others, earned over years: In their corner, Road Warrior, Four plate deadlift.', them: 'A feed of followers and strangers.' },
    { claim: 'A spotter in your corner.', body: 'Coach is one tap away on every screen. Ask for your opener, your next jump, or a swap when the rack is taken. Every weight comes from your own sets, stays under a ceiling it shows you, and nothing lands until you tap.' },
  ]}
  featH2="Real screens, from my own training."
  features={[
    { ...s('log-session', 'Ironstack mid-session: sets logged, the next one ready to confirm, the rest clock running.', 1174), k: 'Log', title: 'Tap, type or talk.', body: 'Last time is already in the set, so most sets are one tap. Or type 225x8 @7, or hold and say it.' },
    { ...s('clock-closing-sim', 'The Ironstack rest clock at 0:04, the whole top of the screen gone oxblood.', 1174), k: 'Timers', title: 'Read it from the platform.', body: 'Rest and EMOM clocks start themselves, call time in your earbuds, and fill the screen at the end.' },
    { ...s('insights-sim', 'Ironstack Insights: sessions, weekly streak, estimated max and pounds moved, each against your own log.', 1174), k: 'Insights', title: 'See yourself progress.', body: 'This month against last, estimated max, records by name, sleep against lifting. You against you.' },
    { ...s('badges', 'Ironstack Badges: 78 earned, next up Fifty thousand in a day and Four plate deadlift, with consistency badges below.', 1174), k: 'Badges', title: 'Earned over years.', body: 'Road Warrior, Four plate deadlift, In their corner. Nothing scolds you for a missed week.' },
    { ...s('social-sim', 'Ironstack Social sample feed: a Bench day card with a heaviest triple, supported by two spotters.', 1174), k: 'Social', title: 'Lift each other up.', body: 'Only the people you train with. Share a session card and back each other up. Optional.' },
    { ...s('coach-swap', 'Ironstack Coach: a Swap it card for SSB Box Squat when the rack is taken, and a Load card, 220x5 at RPE 6.5, with the ceiling and the sets it came from.', 1176), k: 'Coach', title: 'A spotter in your corner.', body: 'Rack taken? It swaps in a lift you already train and names a starting weight from your own sets, under a ceiling. Nothing lands until you tap.' },
  ]}
  featNote="Real screens: a debug build in the iPhone Simulator loaded with my own training history, and Coach on my iPhone, Sept 20, 2026. Social is the app's sample feed."
  steps={[
    { title: 'Leave your Apple ID email.', body: 'Testers come in small batches, added by hand. Training with someone? Put their name in the note and you come in together.' },
    { title: 'Install from TestFlight.', body: 'Apple emails you an invite. TestFlight is Apple\'s own app for betas; Ironstack installs like any other app.' },
    { title: 'Bring your Hevy file, or just start.', body: 'In Hevy: Settings, Export & Import Data, then open the file in Ironstack. A preview shows what it found before anything is saved.' },
  ]}
  noteLabel="What do you log in now?"
  notePlaceholder="Hevy, Strong, a notebook · signing up with my partner"
  details={[
    { label: 'Try it', body: 'Tap the voice examples and run the rest clock, right in the page.', href: '/rack/ironstack/details#try' },
    { label: 'Side by side', body: 'Every line against Hevy and Strong, including what they do better.', href: '/rack/ironstack/details#compare' },
    { label: 'Questions', body: 'Quitting Hevy, what comes over, watch and Android, pounds or kilos.', href: '/rack/ironstack/details#faq' },
    { label: 'Price, license, your data', body: 'What is free, what is not settled yet, and why. MIT at 1.0.', href: '/rack/ironstack/details#fine-print' },
    { label: 'Privacy', body: 'What stays on your phone and what leaves it for Coach and Social.', href: '/rack/ironstack/privacy' },
    { label: 'Better with MealStack', body: 'Meal timing built around the session. What the two share today.', href: '/rack/mealstack/details#better-together' },
  ]}
  closer={{ four: 'Log it · Time it · Lift each other up', line: 'Stacked.' }}
  footLinks={[{ label: 'The details', href: '/rack/ironstack/details' }, { label: 'Privacy', href: '/rack/ironstack/privacy' }]}
/>
