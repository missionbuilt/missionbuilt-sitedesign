---
/**
 * IronStack (/rack/ironstack): the rebuild (Mike 2026-10-16 08:27 and 08:32). One page whose only
 * job is the beta join: a short line, one idea per screen, a real screen each, in the way Apple
 * introduces iPhone Duo (hq/briefs/site/apple-duo-reference.md). Detail lives on
 * /rack/ironstack/details. No demos, tours or try-it clocks.
 *
 * Rules kept: no competitor in the hero; "Coach" is a person, Stack AI the AI; only what's in
 * testers' hands; Social is in the opening (Mike 08:27, fix 6). COPY strings are drafts for
 * Mike's yes.
 */
import ProductPage from '../../components/ProductPage.astro';
import BetaForm from '../../components/BetaForm.astro';
import { STACK } from '../../data/apps';

const IMG = '/images/ironstack/';
const phone = (f: string, alt: string) => ({ kind: 'phone' as const, shot: { src: `${IMG}${f}.webp`, w: 540, h: 1174, alt } });
const watch = (f: string, alt: string) => ({ kind: 'watch' as const, shot: { src: `${IMG}${f}.webp`, w: 422, h: 514, alt } });
const [, meal, mission] = STACK;

const description = 'IronStack is a lifting log for iPhone and Apple Watch. Log a set in a tap, train with the people you lift with, follow a coach\'s plan and see yourself get stronger. Logging in IronStack is free. In a private beta; on the App Store January 1.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'IronStack',
  url: 'https://missionbuilt.io/rack/ironstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS 26, watchOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built LLC', url: 'https://missionbuilt.io' },
};
---
<ProductPage
  title="IronStack: the lifting log for iPhone and Apple Watch · Mission Built"
  description={description}
  ogImageAlt="IronStack, the lifting log for iPhone and Apple Watch, by Mission Built."
  ld={ld}
  name="IronStack"
  icon={STACK[0].icon}
  line="Log every set."
  sub="On your iPhone or your Apple Watch. With the people you train with, and the coach in your corner."
  hero={[
    phone('hero-session', 'IronStack on iPhone mid-workout: Box Squat, set 1 of 5, 275 for 3, with Log lit.'),
    watch('watch-set', 'The same set on Apple Watch: Box squat, 275 lb for 3, the rest clock and Log set.'),
  ]}
  cta={{ label: 'Join the beta', href: '#join' }}
  ctaNote="Logging in IronStack is free."
  chapters={[
    { title: 'One tap a set.', line: 'Last time\'s numbers are already in the set, so most sets are one tap. Or type 225x8 @7 (eight reps at an effort of 7 out of 10), or just say it.',
      devices: [phone('log-session', 'IronStack logging bench sets of 225 for 8, with the rest clock at the top and Log on the third set.')] },
    { title: 'Right on your wrist.', line: 'Log the set and run the rest clock from Apple Watch. Your phone can stay in your bag.',
      devices: [watch('watch-emom', 'IronStack on Apple Watch running an EMOM: the round, the clock and your heart rate.')] },
    { title: 'Lift with your people.', line: 'Share your workout card with the friends you train with and back each other up. Only the people you invite, no strangers. Sign up together and you come in together.',
      devices: [phone('social', 'IronStack Social: a friend\'s Bench day card with a heaviest triple and two new badges, supported by training partners.')] },
    { title: 'Your coach, in your corner.', line: 'A coach sends the plan and sees every set against it. You say yes first.',
      devices: [phone('coach-plan', 'Today on a coach\'s plan: Max Effort Lower, Box Squat 5 sets of 275 for 3, and Start workout.')] },
    { title: 'You against you.', line: 'Every lift you log, charted. Records by name, and this month against last.',
      devices: [phone('progress', 'IronStack Progress: every exercise with its trend line, pullups up 60 percent.')] },
    { title: 'Bring your history.', line: 'Bring your log from another lifting app or a spreadsheet, and keep the old app as long as you like.', link: { label: 'How to bring it over', href: '/rack/ironstack/details#from-hevy' }, devices: [] },
  ]}
  family={{ title: 'Better as a stack.', items: [
    { name: meal.name, line: 'Knows when you train, and times your meals around it.', href: meal.href, icon: meal.icon },
    { name: mission.name, line: 'Puts your live workout on the gym TV, an iPad or a Mac.', href: mission.href || undefined, icon: mission.icon },
  ] }}
  promise={{ title: 'Your log stays yours.', line: 'It lives on your phone. No ads, nothing sold. Stack AI, the app\'s AI, stays off until you turn it on, and sees what you share with a coach only if that coach asks it to sum up your week.', href: '/rack/ironstack/privacy' }}
  closer={{ title: 'Every lift is a mission.', line: 'Join the beta and train on it now. It reaches the App Store January 1.' }}
  more={[
    { label: 'Details', href: '/rack/ironstack/details' },
    { label: 'Compare', href: '/rack/compare/hevy-strong' },
    { label: 'Privacy', href: '/rack/ironstack/privacy' },
    { label: 'Release notes', href: '/rack/ironstack/changelog' },
    { label: 'Support', href: '/rack/support' },
  ]}
>
  <BetaForm slot="join" page="/rack/ironstack" name="IronStack" noteLabel="What do you log in now?" notePlaceholder="a notebook · with a friend" />
  <p slot="after" class="first-alt">IronStack is for lifters 18 and over. Not ready for a beta? <a href="/first">Get the App Store link first</a>.</p>
</ProductPage>

<style>
  .first-alt { margin: 18px 0 0; font-family: var(--font-serif); font-size: 15px; color: var(--color-chalk-dim); }
  .first-alt a { color: var(--color-chalk); border-bottom: 1px solid var(--color-chalk-ghost); }
</style>
