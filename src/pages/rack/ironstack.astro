---
/**
 * IronStack (/rack/ironstack): the rebuild (Mike 2026-10-16 08:27 and 08:32). One page whose only
 * job is the beta join: a short line, one idea per screen, a real screen each, in the way Apple
 * introduces iPhone Duo (hq/briefs/site/apple-duo-reference.md). Detail lives on
 * /rack/ironstack/details. No demos, tours or try-it clocks.
 *
 * Rules kept: no competitor in the hero; "Coach" is a person, Stack AI the AI; only what's in
 * testers' hands; Social is in the opening (Mike 08:27, fix 6). COPY strings are drafts for
 * Mike's yes.
 */
import ProductPage from '../../components/ProductPage.astro';
import { WHY_POST } from '../../data/community';
import BetaForm from '../../components/BetaForm.astro';
import { STACK } from '../../data/apps';

const IMG = '/images/ironstack/';
const phone = (f: string, alt: string) => ({ kind: 'phone' as const, shot: { src: `${IMG}${f}.webp`, w: 540, h: 1174, alt } });
const watch = (f: string, alt: string) => ({ kind: 'watch' as const, shot: { src: `${IMG}${f}.webp`, w: 422, h: 514, alt } });
const [, meal, mission] = STACK;

const description = 'IronStack is a lifting log for iPhone and Apple Watch. Log a set in a tap, train with the people you lift with, follow a coach\'s plan and see yourself get stronger. Free to log, with no cap on programs or workouts. In a private beta; on the App Store January 1.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'IronStack',
  url: 'https://missionbuilt.io/rack/ironstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS 26, watchOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built LLC', url: 'https://missionbuilt.io' },
};
---
<ProductPage
  title="IronStack: the lifting log for iPhone and Apple Watch · Mission Built"
  description={description}
  ogImageAlt="IronStack, the lifting log for iPhone and Apple Watch, by Mission Built."
  ld={ld}
  name="IronStack"
  icon={STACK[0].icon}
  line="Log every set."
  sub="I built it so the log gets out of your way. On your iPhone or your Apple Watch, with the people you train with and the coach in your corner."
  hero={[
    phone('hero-session', 'IronStack on iPhone mid-workout: Box Squat, set 1 of 5, 275 for 3, with Log lit.'),
    watch('watch-set', 'The same set on Apple Watch: Box squat, 275 lb for 3, the rest clock and Log set.'),
  ]}
  cta={{ label: 'Join the beta', href: '#join' }}
  ctaNote="Free to log, with no cap on programs or workouts. Pro adds Stack AI and your whole history."
  chapters={[
    { title: 'One tap a set.', line: 'Last time\'s numbers are already in the set, so most sets are one tap. Or type 225x8 @7 (eight reps at an effort of 7 out of 10), or just say it.',
      devices: [phone('log-session', 'IronStack logging bench sets of 225 for 8, with the rest clock at the top and Log on the third set.')] },
    { title: 'Right on your wrist.', line: 'Log the set and run the rest clock from Apple Watch. Your phone can stay in your bag.',
      devices: [watch('watch-emom', 'IronStack on Apple Watch running an EMOM: the round, the clock and your heart rate.')] },
    { title: 'Lift with your people.', line: 'Share your workout card with the friends you train with and back each other up. Only the people you invite, no strangers. Sign up together and you come in together.',
      devices: [phone('social', 'IronStack Social: a friend\'s Bench day card with a heaviest triple and two new badges, supported by training partners.')] },
    { title: 'Your coach, in your corner.', line: 'A coach sends the plan and sees every set against it. You say yes first.',
      devices: [phone('coach-plan', 'Today on a coach\'s plan: Max Effort Lower, Box Squat 5 sets of 275 for 3, and Start workout.')] },
    { title: 'Know the lift.', line: 'Tap Info on an exercise for a cue card: the setup, how it should feel, the usual miss. 410 exercises so far.', devices: [] },
    { title: 'Ask your log.', line: 'Your best lift, last time on a lift, plate math and swaps, answered from your phone at no cost. Stack AI is there when you want more.', devices: [] },
    { title: 'You against you.', line: 'Every lift you log, charted. Records by name, and this month against last.',
      devices: [phone('progress', 'IronStack Progress: every exercise with its trend line, pullups up 60 percent.')] },
    { title: 'Bring your history.', line: 'Bring your Hevy or Strong history, or any spreadsheet you kept. Keep the old app as long as you like.', link: { label: 'How to bring it over', href: '#from-hevy' }, devices: [] },
  ]}
  family={{ title: 'Also from Mission Built.', items: [
    { name: meal.name, line: 'Times your meals around your training. In beta.', href: meal.href, icon: meal.icon },
    { name: mission.name, line: 'On the big screen, and at the coach\'s desk. Coming soon, included.', href: mission.href || undefined, icon: mission.icon },
  ] }}
  promise={{ title: 'Your log stays yours.', line: 'It lives on your phone. No ads, nothing sold. Stack AI, the app\'s AI, stays off until you turn it on, and sees what you share with a coach only if that coach asks it to sum up your week.', href: '/rack/ironstack/privacy' }}
  closer={{ title: 'Join the beta.', line: 'Train on it now. It reaches the App Store January 1.' }}
  more={[
    { label: 'Why I built it', href: WHY_POST },
    { label: 'Compare', href: '/compare' },
    { label: 'Privacy', href: '/rack/ironstack/privacy' },
    { label: 'Release notes', href: '/rack/ironstack/changelog' },
    { label: 'Support', href: '/rack/support' },
  ]}
>
  <BetaForm slot="join" page="/rack/ironstack" name="IronStack" noteLabel="What do you log in now?" notePlaceholder="a notebook · with a friend" />

  <section slot="faq" class="pp-faq" id="faq" aria-labelledby="faq-h">
    {/* Moved in from /rack/ironstack/details (launch-day site map, #289). Left out on purpose: the watch answer (waits on Logbook, #251), the price and 1.0 date answers (see /pricing), TestFlight. */}
    <h2 id="faq-h" class="ch-title">The ones I get asked.</h2>
    <dl>
      <dt id="from-hevy">Do I have to quit Hevy or Strong?</dt>
      <dd>No. IronStack reads a file you export. It never signs in there or changes anything, so if you go back, your app is exactly as you left it. One limit: IronStack exports a documented JSON file, not a Hevy or Strong CSV, so workouts you log here will not load back into them. Run both for a couple of weeks if an unbroken history matters to you.</dd>
      <dt>What comes over?</dt>
      <dd>Workouts and routines (routines become saved workouts), supersets paired the way you had them, warm-ups as prep sets, drop sets tagged as what they were, and your custom exercise names kept exactly. A preview shows what it found, and any names to check, before anything is saved. In Hevy: Settings, then Export and Import Data. JuggernautAI and any spreadsheet come over the same way, with a preview to match the columns.</dd>
      <dt>Does it need an account?</dt>
      <dd>Not to log. Everything you log is a file on your phone. Social is the one part that needs you to be someone, and it uses Sign in with Apple without asking for your name or email.</dd>
      <dt>What leaves my phone?</dt>
      <dd>Nothing goes to Anthropic until you turn Stack AI on, and then only what you send it, when you ask. The cards you choose to share, if you use Social. Coach mode shares only what you say yes to. <a href="/rack/ironstack/privacy">The privacy page</a> says exactly what, where and for how long.</dd>
      <dt>Can I take my data with me?</dt>
      <dd>Yes. One tap exports everything in the Mission Built Schema, a documented, versioned format, and it imports back on a new phone. The app is closed. Your data is open.</dd>
      <dt>Pounds or kilos?</dt>
      <dd>Both. Pick one for the app and switch any single exercise the other way. The keypad shows the other unit under every number.</dd>
      <dt>Is Stack AI a doctor, or my coach?</dt>
      <dd>No to both. Coach means a person. Stack AI is an AI and can be wrong: it answers from your own sets, never names a weight above a ceiling it can show you, and points any question about pain or injury to a qualified person. Nothing it suggests changes your log until you tap.</dd>
      <dt>What is Coach mode?</dt>
      <dd>Training with a real person who also uses IronStack. Your coach invites you with a link or a code. Nothing is shared until you say yes, and you choose what they see. Either of you can end it, and their copy goes with it. <a href="/rack/ironstack/privacy#coach-mode">What Coach mode shares</a>.</dd>
      <dt>How old do I have to be?</dt>
      <dd>Eighteen. IronStack, Stack AI and Social are for adults.</dd>
    </dl>
  </section>
  <p slot="after" class="first-alt">IronStack is for lifters 18 and over.</p>
</ProductPage>

<style>
  .first-alt { margin: 18px auto 0; max-width: 460px; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .first-alt a { color: var(--color-chalk); border-bottom: 1px solid var(--color-chalk-ghost); white-space: nowrap; }
</style>
