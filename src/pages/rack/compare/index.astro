---
/**
 * /rack/compare: the hub for the three line-by-line pages (plan §8). noindex and out of the
 * sitemap until Mike's word yes on the launch preview. The gym board's comparison waits for the
 * MissionStack name to clear.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopNav from '../../../components/TopNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { COMPARE_PAGES, CHECKED, CHECKED_ISO } from '../../../data/compare';

const blurbs: Record<string, string> = {
  'hevy-strong': 'Importing your history, the watch, the rest clock, prep sets, programs, demos, social and privacy.',
  macrofactor: 'Meals timed around your training, set against the trackers people already use.',
  truecoach: 'Logging on the floor, plan against actual, where you build, notes and how many lifters.',
};
---
<BaseLayout
  title="How they compare · Mission Built"
  description={`IronStack, MealStack and Coach mode, line by line against Hevy, Strong, MacroFactor, Cronometer, MyFitnessPal, TrueCoach, Hevy Coach and TrainHeroic, including what they do better. Checked ${CHECKED}.`}
  noindex={true}
>
  <TopNav active="rack" />
  <main id="main" class="page">
    <section class="hero">
      <p class="eyebrow"><span class="dots" aria-hidden="true">▮▮▮</span><span>Compare</span><span class="dots" aria-hidden="true">▮▮▮</span></p>
      <h1 class="display">How they compare.</h1>
      <p class="subtitle">Line by line, including what they do better. Checked against their own pages, <time datetime={CHECKED_ISO}>{CHECKED}</time>.</p>
      <p class="pricing">Pricing coming soon.</p>
    </section>
    <ul class="cards">
      {COMPARE_PAGES.map((p) => (
        <li>
          <a href={`/rack/compare/${p.slug}`}>
            <span class="k">{p.usName}</span>
            <span class="t">{p.h1}</span>
            <span class="b">{blurbs[p.slug]}</span>
            <span class="go">Line by line →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <SiteFooter links={[{ label: 'The apps', href: '/rack' }, { label: 'Support', href: '/rack/support' }]} />
</BaseLayout>

<style>
  .page { padding-bottom: 72px; }
  .hero { padding: 48px var(--pad-page-x) 8px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 14px; margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.22em; color: var(--color-chalk-dim); text-transform: uppercase; }
  .eyebrow .dots { letter-spacing: 0.04em; color: var(--color-blood-bright); }
  .display { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(44px, 8vw, 96px); line-height: 0.95; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .subtitle { margin: 18px 0 0; max-width: 60ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.6; color: var(--color-chalk-dim); }
  .pricing { margin: 10px 0 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .cards { list-style: none; margin: 40px var(--pad-page-x) 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: var(--border-thin); border-left: var(--border-thin); }
  .cards li { min-width: 0; border-right: var(--border-thin); border-bottom: var(--border-thin); }
  /* A column, not a stretched grid: every card starts its heading at the same height (QA 10-16). */
  .cards a { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 24px 24px 28px; transition: background 120ms ease-out; }
  .cards a:hover { background: var(--color-panel); }
  .cards a > :last-child { margin-top: auto; }
  .k { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .t { font-family: var(--font-display); font-weight: 600; font-size: 22px; line-height: 1.1; text-transform: uppercase; color: var(--color-chalk); }
  .b { font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .go { margin-top: 6px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-blood-text); }
  @media (max-width: 1099px) {
    .hero { padding-left: var(--pad-page-x-mid); padding-right: var(--pad-page-x-mid); }
    .cards { margin-left: var(--pad-page-x-mid); margin-right: var(--pad-page-x-mid); grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .hero { padding: 32px var(--pad-page-x-mobile) 8px; }
    .cards { margin-left: var(--pad-page-x-mobile); margin-right: var(--pad-page-x-mobile); }
  }
</style>
