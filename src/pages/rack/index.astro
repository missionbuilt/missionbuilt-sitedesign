---
/**
 * The Rack — overview page (/rack).
 *
 * Rebuilt Sept 20, 2026 to match the lean app landing pages (AppLanding.astro).
 * The old page was a text overview with a meta strip and two text rows; its copy
 * described the Kibana-era Ironstack ("a training partner with your whole history
 * in its head") and named Hevy. Backup: Claude outputs/rack-index-before-2026-09-20.astro.bak.
 *
 * One job: show the two apps side by side, each with its real screens, its promise
 * and a way in. Order: hero (short) → two app cards → better together → why (one
 * paragraph, below the fold) → closer. Each card uses the same promise, oxblood
 * phrase and hero screens as its own landing page, so the family reads as one.
 * No competitor is named. Oxblood: the brand dot, the two promise phrases, the
 * Join buttons. "Better together" claims only what is live (both write to Apple Health);
 * travel mode and the training signal are Ironstack-ready, MealStack next (Sept 19 audit).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TopNav from '../../components/TopNav.astro';

type Shot = { src: string; w: number; h: number; alt: string };
interface App {
  name: string;
  href: string;
  promise: string;
  accent: string;
  sub: string;
  points: string[];
  shots: [Shot, Shot];
}

const apps: App[] = [
  {
    name: 'Ironstack',
    href: '/rack/ironstack',
    promise: 'Log fast. See progress.',
    accent: 'A coach in your corner.',
    sub: 'A lifting log for iPhone. Every lifting app I used was missing something; this one puts it in one place.',
    points: ['Tap, type or say the set', 'Big rest and EMOM timers', 'Insights, badges, your crew', 'A Coach that picks your next weight'],
    shots: [
      { src: '/images/ironstack/log-session.webp', w: 540, h: 1174, alt: 'Ironstack mid-session: Comp Squat, two sets logged, the third ready to confirm with one tap, and the rest clock at 1:52.' },
      { src: '/images/ironstack/coach-swap.webp', w: 540, h: 1176, alt: 'Ironstack Coach with the squat rack taken: swap in SSB Box Squat and open at 220 for 5, under a ceiling from your own sets.' },
    ],
  },
  {
    name: 'MealStack',
    href: '/rack/mealstack',
    promise: 'Your tracker says what you ate.',
    accent: 'This says when.',
    sub: 'Meal timing for iPhone, built backward from your training session. Eat late and the day re-flows; your pre-workout meal still lands before you train.',
    points: ['Anchored to your session', 'Log when you actually ate', 'Holds up on the road', 'A Coach for eating out'],
    shots: [
      { src: '/images/mealstack/today-training.webp', w: 540, h: 1176, alt: 'MealStack Today on a training day: next is yogurt and berries at 12:03 PM, with totals against the day\'s target.' },
      { src: '/images/mealstack/session-moved.webp', w: 540, h: 1174, alt: 'MealStack after the session moved to 6:30 PM: the meals tied to it move with it, with an Undo.' },
    ],
  },
];
---
<BaseLayout
  title="The Rack · Mission Built"
  description="Two iPhone apps for people who train, from Mission Built. Ironstack: log fast, see progress, a coach in your corner. MealStack: meal timing built around your training session. Both free during the private beta."
  active="rack"
>
  <TopNav active="rack" />

  <main id="main" class="page">
    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>Tools for the barbell, from Mission Built</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>
      <h1 class="display">The Rack<span class="dot">.</span></h1>
      <p class="subtitle">Two iPhone apps for people who train: one for the lifting, one for the eating around it.</p>
      <ul class="trust" aria-label="The short version">
        <li>Private beta</li><li>Free during the beta</li><li>iPhone, iOS 26+</li><li>Your data stays yours</li>
      </ul>
    </section>

    <section class="apps" aria-label="The apps">
      {apps.map((a) => (
        <article class="app">
          <a class="shots" href={a.href} tabindex="-1" aria-hidden="true">
            <img class="ph back" src={a.shots[1].src} width={a.shots[1].w} height={a.shots[1].h} alt="" loading="lazy" decoding="async" />
            <img class="ph front" src={a.shots[0].src} width={a.shots[0].w} height={a.shots[0].h} alt={a.shots[0].alt} decoding="async" />
          </a>
          <div class="app-body">
            <p class="app-name">{a.name}<span class="dot">.</span></p>
            <h2 class="promise">{a.promise} <span class="accent">{a.accent}</span></h2>
            <p class="sub">{a.sub}</p>
            <ul class="points">
              {a.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <div class="ctas">
              <a class="cta" href={`${a.href}#beta`}>Join the beta →</a>
              <a class="soft" href={a.href}>See {a.name} →</a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="block together">
      <p class="section-label">Better together</p>
      <p class="line">Each stands on its own. Both write to Apple Health today; a shared travel switch and a training signal are next.</p>
      <a class="soft" href="/rack/mealstack/details#better-together">What they share today →</a>
    </section>

    <section class="block why">
      <p class="section-label">Why these exist</p>
      <p class="prose">
        The first edition of the book was subtitled <em>Lessons from the Barbell and the Boardroom</em>, and that split still holds. The Loadout is the boardroom
        half: skills for product leaders. The Rack is the barbell half: the tools I train with. I built them
        for one lifter, in a home gym, during a meet prep, because nothing I tried did the whole job. Both open
        their source with 1.0, and your data stays on your phone unless you switch something on.
        For the boardroom, see <a class="inline-link" href="/loadout">the Loadout</a>.
      </p>
    </section>

    <section class="closer">
      <p>The book is the plan. <strong>The Rack is the work.</strong></p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .hero { padding: 48px var(--pad-page-x) 8px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 14px; margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em; color: var(--color-chalk-dim); text-transform: uppercase; }
  .eyebrow .dots { letter-spacing: 0.04em; color: var(--color-blood-bright); }
  .display { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(48px, 8vw, 96px); line-height: 0.95; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .dot { color: var(--color-blood-bright); }
  .subtitle { margin: 18px 0 0; max-width: 60ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.6; color: var(--color-chalk-dim); }
  .trust { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; color: var(--color-chalk-dim); }
  .trust li::before { content: '✓'; margin-right: 7px; color: var(--color-army); }

  /* the two apps */
  .apps { margin: 40px var(--pad-page-x) 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--border-thin); border-left: var(--border-thin); }
  .app { min-width: 0; border-right: var(--border-thin); border-bottom: var(--border-thin); display: grid; grid-template-rows: auto 1fr; }
  .shots { display: flex; justify-content: center; align-items: flex-start; padding: 36px 24px 0; background: var(--color-panel); border-bottom: var(--border-thin); height: 360px; overflow: hidden; }
  .ph { display: block; height: auto; border-radius: 22px 22px 0 0; outline: 1px solid var(--color-rule); background: var(--color-bg); }
  .ph.front { width: min(230px, 46%); position: relative; z-index: 2; order: 1; margin-left: -28px; }
  .ph.back { width: min(210px, 42%); margin-top: 40px; order: 0; }
  .app-body { padding: 28px 32px 32px; display: grid; gap: 14px; align-content: start; }
  .app-name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 22px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-chalk); }
  .promise { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 3vw, 40px); line-height: 1; letter-spacing: -0.01em; text-transform: uppercase; color: var(--color-chalk); }
  .promise .accent { color: var(--color-blood-bright); }
  .sub { margin: 0; max-width: 52ch; font-family: var(--font-serif); font-size: 16px; line-height: 1.6; color: var(--color-chalk-dim); }
  .points { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--color-chalk-dim); }
  .points li { padding-left: 16px; position: relative; }
  .points li::before { content: ''; position: absolute; left: 0; top: 6px; width: 6px; height: 6px; border: 1px solid var(--color-chalk-faint); }
  .ctas { margin-top: 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .cta { display: inline-flex; padding: 13px 20px; background: var(--color-blood); color: var(--color-chalk); font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; transition: background 120ms ease-out; }
  .cta:hover { background: var(--color-blood-bright); }
  .soft { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-dim); border-bottom: 1px solid var(--color-chalk-ghost); padding-bottom: 2px; }
  .soft:hover { color: var(--color-chalk); border-bottom-color: var(--color-chalk); }

  /* below the fold */
  .block { padding: 56px var(--pad-page-x) 0; }
  .section-label { margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em; color: var(--color-blood-text); text-transform: uppercase; }
  .together .line { margin: 0 0 14px; max-width: 60ch; font-family: var(--font-display); font-weight: 500; font-size: 22px; line-height: 1.25; text-transform: uppercase; letter-spacing: 0.01em; color: var(--color-chalk); }
  .prose { margin: 0; max-width: 68ch; font-family: var(--font-serif); font-size: 16px; line-height: 1.65; color: var(--color-chalk-dim); }
  .prose em { color: var(--color-chalk); }
  .inline-link { color: var(--color-chalk); border-bottom: 1px solid var(--color-chalk-ghost); }
  .inline-link:hover { border-bottom-color: var(--color-chalk); }
  .closer { margin-top: 64px; padding: 44px var(--pad-page-x); border-top: var(--border-thin); text-align: center; }
  .closer p { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 22px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-chalk); }
  .closer strong { font-weight: 500; color: var(--color-blood-text); }

  @media (max-width: 1099px) {
    .hero, .block, .closer { padding-left: var(--pad-page-x-mid); padding-right: var(--pad-page-x-mid); }
    .apps { margin-left: var(--pad-page-x-mid); margin-right: var(--pad-page-x-mid); grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .hero, .block, .closer { padding-left: var(--pad-page-x-mobile); padding-right: var(--pad-page-x-mobile); }
    .hero { padding-top: 32px; }
    .subtitle { font-size: 17px; }
    .apps { margin: 28px var(--pad-page-x-mobile) 0; }
    .shots { height: 260px; padding-top: 24px; }
    .app-body { padding: 22px 20px 26px; }
    .points { grid-template-columns: minmax(0, 1fr); }
    .together .line { font-size: 19px; }
    .closer p { font-size: 18px; }
  }
</style>
