---
/**
 * The Rack — overview page.
 *
 * The barbell half of the site. The Loadout is the boardroom kit: skills for
 * product leaders, installed over MCP, MIT. The Rack holds the tools Mike
 * trains with: Ironstack (two Claude skills, seven Kibana dashboards and a
 * coach over an Elasticsearch you own, MIT) and MealStack (an iPhone app,
 * open source with 1.0, license not yet settled). Both in testing as of Sept 2026.
 * Each card opens on the tool's own line ("Fueling is training." / "Weight is a
 * number. Heavy is a feeling."); MealStack's wording follows the Log
 * "Fueling is training" (src/content/logs/fueling-is-training.mdx). Ironstack and MealStack moved
 * here from /loadout on Sept 13, 2026; public/_redirects carries the 301s.
 *
 * Same skeleton as the Loadout index, minus the install section: each tool
 * installs its own way and its page says how.
 *
 * Pattern: TopNav → Hero (eyebrow + h1 + subtitle) → Meta strip →
 * What this is → Dashed divider → The tools (2 rows) → Closer → Footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TopNav from '../../components/TopNav.astro';

/** A phone outline for the iPhone rows. Our own drawing: Apple's logo and the App Store badge are not ours to use until the app is on the store. */
const PHONE = '<svg class="ph-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 18.5h4"/></svg>';

const stats = [
  { key: 'Tools',   value: '2',             href: undefined },
  { key: 'Status',  value: 'Pre-release',   href: undefined },
  { key: 'License', value: 'Open source', href: undefined },
  { key: 'Source',  value: 'GitHub',        href: 'https://github.com/missionbuilt/ironstack' },
];

type ToolStatus = 'live' | 'beta' | 'testing' | 'planned';
interface Tool {
  name: string;
  status: ToolStatus;
  /** What kind of thing it is: the second tag on the row. */
  kind: string;
  blurb: string;
  href: string;
  cta: string;
}

const tools: Tool[] = [
  {
    name: 'MealStack',
    status: 'beta',
    kind: 'iPhone app',
    blurb:
      'Fueling is training. A meal timing tracker for people who train: protein stacked across the day, a pre-workout meal that holds its time, a day you can change on the road, and a log of when you actually ate. Not a nutrition app. Open source with 1.0.',
    href: '/rack/mealstack',
    cta: 'Join the beta →',
  },
  {
    name: 'Ironstack',
    status: 'testing',
    kind: 'Claude skills + Kibana',
    blurb:
      'Weight is a number. Heavy is a feeling. A training partner with your whole history in its head: two Claude skills, seven Kibana dashboards, and a coach with a ceiling, over an Elasticsearch you own. Nothing phones home. MIT.',
    href: '/rack/ironstack',
    cta: 'Preview →',
  },
];
---
<BaseLayout
  title="The Rack · Mission Built"
  description="Open-source tools for the barbell: a training partner with your whole history in its head, and a meal timing tracker for people who train. The other half of Mission Built."
  active="rack"
>
  <TopNav active="rack" />

  <main id="main" class="page">
    {/* ---------- HERO ---------- */}
    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>Open-source tools for the barbell, from Mission Built</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>

      <h1 class="display">
        <span class="line">The</span>
        <span class="line">Rack<span class="dot">.</span></span>
      </h1>

      <p class="subtitle">Open-source tools for the other half of the book.</p>
    </section>

    {/* ---------- META STRIP ---------- */}
    <section class="meta-strip" aria-label="The Rack at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          {s.href ? (
            <a
              class="stat-value linked"
              href={s.href}
              target="_blank"
              rel="noopener"
            >{s.value}<span class="ext" aria-hidden="true"> ↗</span></a>
          ) : (
            <div class="stat-value">{s.value}</div>
          )}
        </div>
      ))}
    </section>

    {/* ---------- WHAT THIS IS ---------- */}
    <section class="block">
      <p class="section-label">What this is</p>
      <h2 class="section-h2">The other half of the book.</h2>
      <p class="prose">
        The book is subtitled <em>Lessons from the Barbell and the Boardroom</em>.
        The Loadout is the boardroom half: skills for product leaders. The Rack is
        the barbell half: the tools I train with. A training partner with your whole
        history in its head, and an iPhone app that times your meals to the session.
        Both were built for one lifter, in a home gym, during a meet prep.
      </p>
      <p class="prose">
        <strong>Open source, and your data stays yours.</strong> Ironstack is MIT and
        never phones home. MealStack will be open source too, the license settled with 1.0, and it sends nothing you
        have not switched on. Each one installs its own way, and its page says how. For the boardroom,
        see <a class="inline-link" href="/loadout">the Loadout</a>.
      </p>
    </section>

    <hr class="dashed" />

    {/* ---------- THE TOOLS ---------- */}
    <section class="block">
      <header class="block-head">
        <h2 class="section-h2">The tools.</h2>
        <span class="block-count">2 total · 1 in beta</span>
      </header>

      <div class="skills">
        {tools.map((t) => (
          <a
            href={t.href}
            class:list={['skill-row', t.status === 'planned' && 'dim']}
          >
            <div class="skill-name">
              <h3>{t.name}</h3>
              {t.status === 'live' ? (
                <span class="tag live"><span class="tag-sq" aria-hidden="true"></span>Live</span>
              ) : t.status === 'beta' ? (
                <span class="tag beta"><span class="tag-sq" aria-hidden="true"></span>Private beta</span>
              ) : t.status === 'testing' ? (
                <span class="tag testing"><span class="tag-sq" aria-hidden="true"></span>In testing</span>
              ) : (
                <span class="tag planned">In development</span>
              )}
              <span class="tag kind">{t.kind === 'iPhone app' && <Fragment set:html={PHONE} />}{t.kind}</span>
            </div>
            <p class="skill-blurb">{t.blurb}</p>
            <div class="skill-cta">{t.cta}</div>
          </a>
        ))}
      </div>
    </section>

    {/* ---------- CLOSER ---------- */}
    <section class="closer">
      <p>
        The book is the plan. <strong>The Rack is the work.</strong>
      </p>
    </section>

  </main>
  <SiteFooter links={[{ label: 'github.com/missionbuilt/ironstack', href: 'https://github.com/missionbuilt/ironstack', external: true }]} />
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero {
    padding: 56px var(--pad-page-x) 28px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--color-chalk-dim);
    text-transform: uppercase;
  }
  .eyebrow .dots {
    letter-spacing: 0.04em;
    color: var(--color-blood-bright);
  }

  .display {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(56px, 11vw, 108px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: var(--color-chalk);
    text-transform: uppercase;
  }
  .display .line { display: block; }
  .display .dot { color: var(--color-blood-bright); }

  .subtitle {
    margin: 22px 0 0;
    max-width: 760px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(15px, 2.2vw, 22px);
    color: var(--color-chalk-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ============ META STRIP ============ */
  .meta-strip {
    margin: 28px var(--pad-page-x) 0;
    padding: 14px 0;
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .stat-key {
    color: var(--color-chalk-faint);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .stat-value {
    margin-top: 2px;
    color: var(--color-chalk);
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.04em;
    display: inline-block;
  }
  /* Linked stat values get a subtle underline on hover, same color */
  .stat-value.linked {
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 120ms ease-out, color 120ms ease-out;
  }
  .stat-value.linked:hover { border-bottom-color: currentColor; }
  .stat-value .ext {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-chalk-faint);
    letter-spacing: 0;
    transition: color 120ms ease-out;
  }
  .stat-value.linked:hover .ext { color: var(--color-chalk); }

  /* ============ BLOCKS ============ */
  .block {
    padding: 56px var(--pad-page-x) 0;
  }

  .section-label {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--color-blood-text);
    text-transform: uppercase;
  }

  .section-h2 {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--color-chalk);
    text-transform: uppercase;
  }

  .prose {
    margin: 0 0 14px;
    max-width: 720px;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-chalk-dim);
  }
  .prose strong { color: var(--color-chalk); font-weight: 700; }
  .prose em { color: var(--color-chalk); font-style: italic; }
  .inline-link {
    color: var(--color-chalk);
    border-bottom: 1px solid var(--color-chalk-ghost);
    transition: border-color 120ms ease-out;
  }
  .inline-link:hover { border-bottom-color: var(--color-chalk); }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 22px;
  }
  .block-count {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-chalk-faint);
  }

  /* ============ SKILL CARDS (row form) ============ */
  .skills {
    border-top: var(--border-thin);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 200px 1fr 140px;
    gap: 36px;
    align-items: center;
    padding: 22px 0;
    border-bottom: var(--border-thin);
    text-decoration: none;
    transition: background 120ms ease-out;
  }
  .skill-row:hover {
    background: rgba(255, 255, 255, 0.015);
  }
  .skill-row.dim { cursor: default; }

  .skill-name { display: flex; flex-direction: column; gap: 8px; }
  .skill-name h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-chalk);
  }
  .skill-row.dim .skill-name h3 { color: var(--color-chalk-faint); }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .tag.live { color: var(--color-army); }
  .tag.live .tag-sq {
    width: 6px;
    height: 6px;
    background: var(--color-army);
    display: inline-block;
  }
  .tag.beta { color: var(--color-chalk); }
  .tag.beta .tag-sq { background: transparent; border: 1px solid var(--color-chalk); }
  .tag.testing { color: var(--color-chalk-dim); }
  .tag.testing .tag-sq {
    width: 6px;
    height: 6px;
    border: 1px solid var(--color-chalk-dim);
    display: inline-block;
  }
  .tag.planned { color: var(--color-chalk-faint); }
  .tag.kind { color: var(--color-chalk-faint); border: 1px solid var(--color-rule); padding: 3px 7px; align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; }
  .tag.kind :global(.ph-glyph) { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }

  .skill-blurb {
    margin: 0;
    max-width: 68ch;
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-chalk-dim);
  }
  .skill-row.dim .skill-blurb { color: var(--color-chalk-faint); }

  .skill-cta {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-chalk);
    text-align: right;
    white-space: nowrap;
    transition: color 120ms ease-out;
  }
  .skill-row.dim .skill-cta { color: var(--color-chalk-faint); }
  a.skill-row:hover .skill-cta { color: var(--color-blood-text); }

  /* ============ DASHED DIVIDER ============ */
  .dashed {
    margin: 48px var(--pad-page-x) 0;
    border: none;
    border-top: 1px dashed var(--color-rule-soft);
  }

  /* ============ CLOSER ============ */
  .closer {
    margin-top: 56px;
    padding: 48px var(--pad-page-x);
    border-top: var(--border-thin);
    text-align: center;
  }
  .closer p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-chalk);
  }
  .closer p strong {
    font-weight: 500;
    color: var(--color-blood-text);
  }

  /* ============ FOOTER ============ */

  /* ============ Responsive ============ */
  @media (max-width: 1099px) {
    .meta-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .skill-row {
      grid-template-columns: 180px 1fr 110px;
      gap: 24px;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding: 36px var(--pad-page-x-mobile) 20px;
    }
    .meta-strip {
      margin: 24px var(--pad-page-x-mobile) 0;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .block {
      padding: 40px var(--pad-page-x-mobile) 0;
    }
    .section-h2 { font-size: 28px; }
    .skill-row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 22px 0;
    }
    .skill-cta { text-align: left; }
    .dashed { margin: 36px var(--pad-page-x-mobile) 0; }
    .closer { padding: 36px var(--pad-page-x-mobile); }
    .closer p { font-size: 18px; }
  }
</style>
