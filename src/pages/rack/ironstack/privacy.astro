---
/**
 * IronStack — privacy.
 *
 * The page App Store Connect points at (Privacy Policy URL) and the app should link to
 * from Settings › Your data. Written from the code, not from a template, and rewritten
 * Sept 29, 2026 against the app, its Stack AI server and its Social server, and updated
 * Sept 30, 2026 for Stack AI's permission screen, and Oct 3, 2026 for Coach mode
 * (social-server/COACH.md: scope, the server's copy, ending a link, The read). Same shape and
 * voice as /rack/mealstack/privacy, so the two read as one family. Draft for review by a
 * lawyer before public launch.
 *
 * Apple's App Review Guidelines 5.1.1(i) want what is collected and every use, that
 * third parties protect it at least as well, and retention, deletion and how consent is
 * withdrawn; 5.1.1(v) wants in-app account deletion (Social has it); 5.1.2(i) wants
 * third-party AI named and permission asked first; 5.1.3 wants the health data named
 * and never used for marketing; 1.2 wants reporting and blocking for Social.
 *
 * Every sentence here must be true of the build that is live. The Stack AI cell says what
 * the app's Stack AI permission screen says, in the same order. The publisher line stays "Mission Built, which
 * is Mike Nichols" until the LLC exists.
 *
 * Color discipline: oxblood for the hero period, section labels and the one
 * emphasised word. No army green on this page.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TopNav from '../../../components/TopNav.astro';

const EFFECTIVE = 'October 3, 2026';
const ASK = 'mailto:support@missionbuilt.io?subject=IronStack%20data%20request';

const stats = [
  { key: 'Account to log',     value: 'None' },
  { key: 'Your training log',  value: 'On your phone' },
  { key: 'Leaves the phone',   value: 'Stack AI questions. Cards you share. Sessions for a coach you link.' },
  { key: 'Sold or advertised', value: 'Never' },
];

type Party = { who: string; role: string; what: string; where: string };
const parties: Party[] = [
  { who: 'Cloudflare', role: 'Runs the Stack AI and Social servers', what: 'Sees each Stack AI request in transit. Stores the device record and allowance counters for Stack AI, an answer for 10 minutes in case your connection drops, the Social account and everything Social holds (including what Coach mode sends your coach, in its D1 database), and the log copy if you turn that on. Keeps a count-and-cost record of Stack AI use for about ninety days.', where: 'Global edge, US account' },
  { who: 'Anthropic', role: 'Runs the Claude model behind Stack AI, and gives Social reports about a name a first look', what: 'Receives what the app sends when you ask Stack AI something, after you turn Stack AI on, and produces the answer. If you have a coach, receives your sessions for a week when your coach asks Stack AI for The read. For Social moderation, receives the reported words when a handle or a card\'s title is reported (up to 60 characters), for a first look before a person decides. Deletes it within 30 days and does not train its models on it; keeps it longer (up to 2 years) only if a request is flagged for breaking its usage policy. Handles it under its commercial terms and Data Processing Addendum.', where: 'United States' },
  { who: 'Apple', role: 'Health, Sign in with Apple, notifications, weather, maps, TestFlight', what: 'Health holds what you allow the app to read and the workouts it writes. Sign in with Apple identifies your Social account. Push notifications for Social and Coach mode go through Apple. WeatherKit and Apple Maps receive a rounded location to return the weather and a town name. Apple\'s own privacy terms cover these.', where: 'Per Apple' },
];

type Keep = { what: string; how: string };
const keeps: Keep[] = [
  { what: 'Your training log, plan, notes, gear, profile', how: 'On your phone until you delete them or delete the app. Included in your iPhone backup like any other app data.' },
  { what: 'Your Stack AI chats', how: 'On your phone until you delete them. Not synced anywhere.' },
  { what: 'What you send Stack AI, including photos and files', how: 'Mission Built never keeps what you said. The answer is held on the server for 10 minutes in case your connection drops, then deleted. Anthropic deletes what you sent within 30 days and doesn\'t train its models on it. It keeps it longer (up to 2 years) only if a request is flagged for breaking its usage policy.' },
  { what: 'The Stack AI device record (App Attest key id, public key, receipt, timestamps)', how: 'While the install exists. Removed when you delete your data in the app, or on request.' },
  { what: 'Stack AI allowance counters', how: 'Reset at the start of each month.' },
  { what: 'Count-and-cost record of Stack AI use (Cloudflare)', how: 'One line per Stack AI question: when, which model, how many tokens, roughly what it cost, filed under a one-way hash of the install key. No question, answer or training data. About ninety days, then gone.' },
  { what: 'Social account, handle, spotters, shared cards, support given', how: 'Until you delete your Social account or all your data in the app. Your sign-in on the phone lasts 180 days; an unused invite link expires after 7.' },
  { what: 'Coach mode: the link, the scope you chose, the sessions sent to your coach, your coach\'s plans and notification settings', how: 'On the server until the link ends, from either side, or you delete the session in the app. Ending the link, blocking either way, or deleting either Social account deletes the coach\'s copy on the server, and your coach\'s phone deletes its copy when it sees the link has ended.' },
  { what: 'Notification token (Social)', how: 'Until you sign out of Social or delete it.' },
  { what: 'Reports you file', how: 'Until the report is closed, then up to one year for moderation. If you delete your Social account, they stay, with your account removed from them.' },
  { what: 'Reports about you, and moderation decisions', how: 'Until the report is closed, then up to one year. If you delete your Social account, the text quoted from you is removed from them.' },
  { what: 'The log copy (only if you turn it on)', how: 'Until you delete your data in the app, or ask.' },
];
---
<BaseLayout
  title="Privacy · IronStack · Mission Built"
  description="What IronStack keeps on your phone, what leaves it for Stack AI and Social, who touches it, how long it lasts, and how to make it all go away."
  active="rack"
  ogImage="/images/ironstack/og.jpg"
  ogImageAlt="IronStack. Log it. Time it. Lift each other up. A lifting log for iPhone, by Mission Built, with a real screen of a session in progress."
>
  <TopNav active="rack" />

  <main id="main" class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/rack">The Rack</a>
      <span aria-hidden="true"> / </span>
      <a href="/rack/ironstack">IronStack</a>
      <span aria-hidden="true"> / </span>
      <span class="here">Privacy</span>
    </nav>

    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>IronStack</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>
      <h1 class="display"><span>Privacy</span><span class="dot">.</span></h1>
      <p class="subtitle">
        <span class="line1">What the app keeps, what leaves your phone, and how to make it all go away.</span>
        <span class="line2">Your training log is yours. Here is everything else.</span>
      </p>
      <p class="effective">Effective {EFFECTIVE} · Mission Built · Mike Nichols · Pittsburgh, PA</p>
    </section>

    <section class="meta-strip" aria-label="IronStack privacy at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          <div class="stat-value">{s.value}</div>
        </div>
      ))}
    </section>

    {/* ---------- WHO ---------- */}
    <section class="block">
      <p class="section-label">Who this is</p>
      <h2 class="section-h2">Mission Built makes IronStack. This page is the whole policy.</h2>
      <div class="prose-block">
        <p>IronStack is made by Mission Built, which is Mike Nichols, in Pittsburgh, Pennsylvania. For the purposes of privacy law, Mission Built is the controller of whatever this page says leaves your phone. There is no parent company, no subsidiary and no partner with access to your data. The app is not open source; this page is where to read what it does with your data, and the What the server holds screen shows you the rest, live.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- NO ACCOUNT ---------- */}
    <section class="block">
      <p class="section-label">No account to log</p>
      <h2 class="section-h2">Logging never asks who you are.</h2>
      <div class="prose-block">
        <p>You can log every set you will ever do without signing up, logging in or giving a name, an email address or a phone number. The only identity Stack AI's server ever sees is a key your phone creates in its secure hardware, which proves a request came from a real copy of IronStack and nothing more.</p>
        <p><strong>Social is the one exception, and it is optional.</strong> To share sessions with the people you train with, you sign in with Apple. IronStack asks Apple for neither your name nor your email, and stores neither if Apple sends them. The Social server keeps the stable, anonymous user id Apple gives it, and a sealed token it uses for one thing: disconnecting Sign in with Apple when you delete your account.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- ON YOUR PHONE ---------- */}
    <section class="block">
      <p class="section-label">On your phone</p>
      <h2 class="section-h2">Your training log lives in files on the phone.</h2>
      <div class="prose-block">
        <p>Every set, session, note and correction; your programs, workouts and exercises; your gear and home gym; the details you give for a session (bodyweight, sleep); your Stack AI chats; and your Social settings. All of it lives in files in the app's own container on your iPhone, written under the phone's encryption and protected until the first unlock after a restart. Those files are included in your iCloud or computer backup the way any app's data is; Mission Built has no access to your backups.</p>
        <p><strong>Apple Health, if you allow it.</strong> IronStack reads your weigh-ins, sleep, height, date of birth and biological sex, so the questions it asks before a session answer themselves and Insights can line your sleep up with your lifting. It only fills empty fields; you can always type over them. If you turn on the separate switch in Settings (off until you do), it saves each finished session to Health as a strength workout. It never writes your weight or your sleep. Nothing from Health is used for marketing, advertising or anything but the log and your own Insights.</p>
        <p><strong>Location, if you allow it.</strong> From your second session on, the app asks once. During a session it asks for roughly a kilometre of accuracy and rounds the coordinates to two decimal places the moment they arrive. The session keeps the town name, those rounded coordinates, whether you were away from home, and the weather. To get the weather and the town name, the rounded point goes to Apple's WeatherKit and Apple Maps. Logging never needs location, and an export leaves coordinates out unless you switch them on.</p>
        <p><strong>Automatic travel, only if you turn it on.</strong> Set travel automatically, in Settings, is off until you turn it on. On, the app remembers where home is, rounded to about a kilometre, and watches for large moves in location (not a live track), even when a session is not running, so it can switch you to Away when you are farther from home than the distance you pick (50 miles unless you change it) and back when you return. The check happens on the phone; no location is sent anywhere for it. Turning the switch off stops the watching; Forget home erases the home area.</p>
        <p><strong>Your voice, only while you hold the button.</strong> Speech is turned into text on the phone, by Apple's on-device speech recognition, only while you hold the talk button. No audio is kept or sent anywhere.</p>
        <p><strong>MealStack, if it is on the same phone.</strong> The two apps share a private shelf on your phone that only Mission Built apps can open. On it: the travel switch (Home or Away, which app flipped it, and your rounded home area if you use automatic travel); today's session time when you move it, so the other app can offer to follow, Sync or Skip; and, only after a separate yes for each, when your last session started and how long it ran, and when you usually train. Each app also leaves a note that it is installed and when it was last used, which is how the Double Stacked badges know you used both. Neither app moves anything in the other without asking, and nothing crosses to a server to do this. Turn a share off and IronStack takes it back off the shelf.</p>
        <p class="note" id="health-data">This section also serves as the consumer health data notice some states require. The health data involved: bodyweight, sleep, height, date of birth and biological sex read from Apple Health with your permission, the workouts written to it with your permission, and the sets, effort ratings and notes you log. Source: you and Apple Health. Purpose: the log, your Insights, and Stack AI when you turn it on and ask it. Shared with: nobody, except what goes to Anthropic for Stack AI, only after you turn Stack AI on and then only when you ask it something; the session card you choose to share on Social; and, only if you link a coach, your sessions, plus the notes, sleep and bodyweight you choose on the consent screen, sent to that coach (and through The read, to Anthropic), as described next.</p>
        <p class="note"><strong>Consent and withdrawal.</strong> Nothing in this notice is read or shared until you allow it: Health access in iOS Settings › Health › Data Access &amp; Devices, and Stack AI only after you turn it on, and then only when you ask. Stack AI is off until you turn it on from its permission screen; Settings › Stack AI turns it off. Coach mode shares nothing until you accept a coach's request on its consent screen; ending the link withdraws it and deletes the coach's copy on the server. Turning any of these off withdraws your consent from then on, and Delete all IronStack data removes what was collected. Your rights under Washington's My Health My Data Act and similar laws (to confirm, access, delete and withdraw consent) are the ones in Your rights below, at the same address. Mission Built does not sell consumer health data.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- WHAT LEAVES ---------- */}
    <section class="block">
      <p class="section-label">What leaves your phone</p>
      <h2 class="section-h2">Only what you use, and only when you use it.</h2>

      <div class="two">
        <div class="cell">
          <p class="k">Stack AI</p>
          <p class="v">Off until you turn it on. Then only when you ask.</p>
          <p class="body">Stack AI is off until you turn it on. The first time you open it, the app shows a permission screen that says what goes to Anthropic, asks you to confirm you are 18 or older, and asks first. Nothing goes to Anthropic until you turn Stack AI on, and then only when you ask it something. Turn it off any time in Settings › Stack AI; off, it sends nothing.</p>
          <p class="body"><strong>Sent to Anthropic, only when you ask:</strong></p>
          <ul class="list">
            <li>Your question and this chat</li>
            <li>Your last 90 days of training and today's session: sets, weights, reps, RPE and notes</li>
            <li>The bodyweight and sleep you logged, typed in or from Apple Health</li>
            <li>Where you are in your program, including a meet date</li>
            <li>Photos (up to 5) with location removed, and PDFs and files you attach, with their names</li>
          </ul>
          <p class="body"><strong>Never sent:</strong> your name, email, Apple ID, location, contacts or gear. Stack AI never sees anything from Social.</p>
          <p class="body">It goes to Mission Built's server at ironstack-ai.missionbuilt.io (earlier builds use ironstack-coach.missionbuilt.io until they update; it is the same server code), which runs on Cloudflare. The server passes it to Anthropic's Claude model, checks every weight the model names against a ceiling from your own sets, and sends the answer back.</p>
          <p class="body"><strong>What happens to it.</strong> Anthropic deletes it within 30 days and doesn't train its models on it. It keeps it longer (up to 2 years) only if a request is flagged for breaking its usage policy. Mission Built keeps a cost count for your phone, never what you said. An answer is held for 10 minutes in case your connection drops, then deleted. Your chats stay on your phone until you delete them; they are not synced anywhere. Stack AI can be wrong. It isn't medical advice.</p>
          <p class="body">To run Stack AI without accounts, the server keeps one small device record per install, for the allowance: the App Attest key id and the public half of the key your phone created, the receipt Apple issued for it, when it registered and was last seen, and how many Stack AI requests that install has made today and this month and roughly what they cost. It identifies the install, not you, and never holds your name.</p>
        </div>
        <div class="cell">
          <p class="k">Social</p>
          <p class="v">The cards you choose to share, to people you invite.</p>
          <p class="body">If you sign in to Social, the Social server at social.missionbuilt.io (on Cloudflare) holds your handle, your spotters and invitations, the session cards you share, the support you give and get, who you have muted or blocked, reports you file, and a notification token so a new spotter or support can reach your phone. Notifications are asked for only when you have something to be notified about.</p>
          <p class="body">A card carries no messages and no comments. It holds the date and start time, how long you trained, how many working sets, the lifts by name from the app's list, the day's best moments, up to three badges, a title if you type one (up to 30 characters), and a place: your home gym as a phrase you pick, or the city name. Never coordinates. Your handle, a title and a city name go through a word filter on the server before they are accepted. Weights are left off unless you turn them on. You approve every card before it goes, and only your spotters, people you invited or who invited you, can see it. Anyone you send an invite link to sees your handle on it. You can take a card back at any time.</p>
          <p class="body">You can report a handle, a card title or a person, and block anyone, at any time. Reports use a fixed list of reasons (an offensive name or title, harassment, spam, impersonation, or something else), and the person reported is not told who reported them. Reports about a handle or a card's name are reviewed with help from Anthropic's Claude: the reported words (a handle or a card's title, up to 60 characters) are sent to Anthropic for a first look before a person decides. Nothing else goes with them: not your training log, not the card, not who reported it. Other reports go to a person only. A person at Mission Built decides every report before anything lasting happens, and can hide a card, reset or release a handle, or suspend an account. If you think a decision was wrong, email the address below.</p>
        </div>
      </div>

      <div class="fine" id="coach-mode">
        <p class="k">Coach mode: only if you link a coach</p>
        <p>Coach mode is for training with a real person, a coach who also uses IronStack. It uses your Social sign-in and does nothing until a coach asks to coach you and you say yes. You can have one coach at a time, and being someone's spotter has nothing to do with coaching them.</p>
        <p><strong>You choose what your coach sees, on the consent screen,</strong> before anything is sent: every set (always, since that is the point), your notes and how you felt (on unless you turn it off), your sleep and bodyweight (off unless you turn it on), and your MealStack fueling summary (off unless you turn it on; see <a href="/rack/mealstack/privacy">MealStack privacy</a>). You also choose where it starts: today, the last 12 weeks, or all your history. The app filters each session to that choice on your phone before it leaves, and the server strips anything outside it again.</p>
        <p><strong>Where it goes.</strong> When a session ends, it is sent to Mission Built's Social server at social.missionbuilt.io, on Cloudflare, stored in its database, and passed to your coach's phone. Edits and deletes follow. Plans your coach sends you, and the short note with them, come the same way, and stay suggestions until you accept them. Coach mode may send you or your coach a notification, through Apple, never between 9 PM and 7 AM unless you change the quiet hours.</p>
        <p><strong>The read.</strong> Your coach can ask Stack AI for a weekly summary of your training. That request comes from your coach's phone, runs on your coach's Stack AI allowance, and sends up to three weeks of your shared sessions, and the plan for that week, to Anthropic, on the same terms as any Stack AI request: deleted within 30 days and never used to train its models.</p>
        <p><strong>Ending it.</strong> Either of you can end the link at any time. Ending it, blocking each other, or deleting either Social account deletes your coach's copy on the server (the sessions and the plans), and your coach's phone deletes its copy as soon as it sees the link is gone. Until then, the server keeps each session until the link ends or you delete that session in the app.</p>
      </div>

      <div class="fine">
        <p class="k">And one switch almost nobody needs</p>
        <p><strong>Settings › Your data › Advanced › Copy my log to the server</strong> is off for new installs. It exists for reading your log with tools on a computer; nothing in the app, Stack AI included, needs it. On, it sends your raw log (including rounded location, bodyweight, sleep and notes) to storage Mission Built runs on Cloudflare, filed under a one-way hash of the install key. History you brought in from another app is never sent. It stays until you erase it from The server's copy on the same screen, or delete your data in the app.</p>
      </div>

      <div class="fine">
        <p class="k">Nothing else</p>
        <p>Notifications and the Home Screen widget are made on the phone from the same files the app reads. No advertising identifiers, no third-party software kits in the app, no usage analytics sent to anyone, no tracking in Apple's sense of the word, no selling, no sharing for anyone else's marketing. The App Store privacy label says the same.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- WHO TOUCHES IT ---------- */}
    <section class="block">
      <p class="section-label">Who touches it</p>
      <h2 class="section-h2">Three companies, each for its jobs.</h2>
      <p class="prose">Each of them is bound by its own terms and, where it processes data for Mission Built, by a data processing agreement, to protect your data at least as well as this page promises. None of them may use it for their own marketing.</p>
      <div class="parties">
        <div class="ph"><span>Who</span><span>Job</span><span>What they see</span><span>Where</span></div>
        {parties.map((p) => (
          <div class="pr">
            <span class="pk">{p.who}</span>
            <span class="role">{p.role}</span>
            <span>{p.what}</span>
            <span class="where">{p.where}</span>
          </div>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- HOW LONG ---------- */}
    <section class="block">
      <p class="section-label">How long</p>
      <h2 class="section-h2">What is kept, and for how long.</h2>
      <div class="keeps">
        {keeps.map((k) => (
          <div class="kr">
            <span class="kk">{k.what}</span>
            <span>{k.how}</span>
          </div>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- DELETE ---------- */}
    <section class="block">
      <p class="section-label">Seeing, taking and deleting your data</p>
      <h2 class="section-h2">It is all in Settings. No email needed.</h2>
      <div class="prose-block">
        <p><strong>Settings › Your data › Export all my data</strong> writes every session you have ever logged, your plan and your own exercises into one file, in the Mission Built Schema, a documented format you can read anywhere or bring back into IronStack. <strong>Export the raw log</strong> gives you the log itself, line for line.</p>
        <p><strong>What the server holds</strong> asks the Stack AI server, live, for everything it keeps for your install and shows it to you. The request is signed by your phone's key, so the server can only ever answer for the install that asked.</p>
        <p><strong>Delete all IronStack data</strong> is one screen that erases everything, everywhere, in order: first the server's copy (the device record, the counters, and the log copy if you had it on), then your Social account if you have one (which ends any coach link and deletes the coach's copy on the server), then everything on the phone. It reports each one. If the server or Social cannot be reached, it stops before touching the phone and says so, so nothing is left behind that you can no longer ask to erase; you can try again or delete the phone's data anyway. <strong>Social › Delete Social account</strong> deletes only the Social side: your handle, spotters, shared cards and support, and disconnects Sign in with Apple, and ends any coach link along with the coach's copy. Your log is not touched. Ending a coach link in the app ends just the link and deletes the coach's copy.</p>
        <p>Two things those buttons do not remove: workouts IronStack wrote to Apple Health stay in Health, where you can delete them in the Health app; and the count-and-cost record of Stack AI use expires on its own within about ninety days. Turning Stack AI off in Settings › Stack AI stops it from sending anything from then on; signing out of Social stops notifications.</p>
        <p>If the app was deleted before you asked, nothing on the Stack AI server can be matched to you, which also means nothing there can identify you. For that, for your Social account, or for anything else about your data, email <a href={ASK}>support@missionbuilt.io</a>. Mission Built will confirm within ten days and finish within thirty.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- RIGHTS ---------- */}
    <section class="block">
      <p class="section-label">Your rights</p>
      <h2 class="section-h2">Wherever you are, the same answer.</h2>
      <div class="prose-block">
        <p>You can ask what Mission Built holds that relates to your install or your Social account, ask for it to be corrected or deleted, ask for a copy, object to or restrict its use, and withdraw any consent you gave, all at the address above, and you will not be treated differently for asking. Under the GDPR, the legal bases are your explicit consent for anything involving health data (Stack AI, Apple Health, the log copy, Coach mode), your consent for Social and location, and Mission Built's legitimate interest in running the Stack AI allowance, keeping Social safe and keeping the service from being abused. Mission Built has not appointed an EU or UK representative; write to the address above. If you are in the EU, the EEA or the UK you may also complain to your supervisory authority. Under California law, Mission Built does not sell or share personal information and has not done so in the past twelve months.</p>
        <p>Mission Built operates from the United States and the companies above process data there, so anything that leaves your phone leaves your country if you are outside the US. Cloudflare and Anthropic each rely on recognised transfer mechanisms such as standard contractual clauses or the EU–US Data Privacy Framework for that.</p>
      </div>
    </section>

    <hr class="dashed" />

    <section class="block">
      <div class="two">
        <div class="cell">
          <p class="k">Stack AI is not a clinician</p>
          <p class="body">Stack AI can be wrong, and it isn't medical advice. It gives general training information from your own log. It will not name a weight above a ceiling drawn from your own sets, it does not make programs up (it writes down one you send it, for you to check), and it points any question about pain, injury or a medical condition to a qualified person. Check with your physician before making decisions about your health, and treat what Stack AI says as a starting point, not an instruction.</p>
        </div>
        <div class="cell">
          <p class="k">Age</p>
          <p class="body">IronStack is for adults, 18 and over. It is not directed at anyone under 18 and does not knowingly collect anything from them. If you believe someone under 18 has used the app, email the address above and the device record and any Social account will be removed.</p>
        </div>
      </div>
    </section>

    <hr class="dashed" />

    <section class="block">
      <p class="section-label">Changes</p>
      <h2 class="section-h2">This page changes when the app does.</h2>
      <div class="prose-block">
        <p>If what the app collects or shares changes, this page changes first, with a new effective date at the top. A change that widens what leaves your phone will be asked about in the app before it applies to you. Effective {EFFECTIVE}.</p>
      </div>
    </section>
  </main>
  <SiteFooter links={[{ label: 'Back to IronStack', href: '/rack/ironstack' }, { label: 'MealStack privacy', href: '/rack/mealstack/privacy' }, { label: 'Terms', href: '/rack/ironstack/terms' }, { label: 'Support', href: '/rack/support' }]} />
</BaseLayout>

<style>
  .page { max-width: 1280px; margin: 0 auto; }

  .breadcrumb {
    padding: 18px var(--pad-page-x) 0;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-chalk-faint);
  }
  .breadcrumb a { color: var(--color-chalk-dim); transition: color 120ms ease-out; }
