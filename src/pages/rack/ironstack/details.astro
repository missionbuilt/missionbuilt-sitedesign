---
/**
 * THE DETAILS PAGE (/rack/ironstack/details). Since Sept 20, 2026 /rack/ironstack is a short landing page
 * (what is different, the features with real screens, how to get it); this is the full page it links to.
 *
 * Ironstack — product page on the Rack.
 *
 * An iPhone app for logging lifting: say the set, the rest clock runs itself, and a
 * feed that is only the people you train with. The app's own line, from its welcome
 * screen (Views/Welcome.swift): "Log it. Time it. Lift each other up."
 *
 * Rebuilt Sept 19, 2026 for the iPhone app, on MealStack's page skeleton so the two
 * read as one family: hero → what it does differently (six cards, each with its real
 * screen, then more screens) → why (four pillars) → try it (the voice card and the rest
 * clock, live) → how you use
 * it → side by side → fine print → join the beta → at the table (the open-source
 * CLI and Kibana stack the app grew out of) → the kit → FAQ → better together → related.
 * (Order since the Jess session: hero → coming from Hevy → six cards → why → try it → how →
 * side by side → fine print → beta → FAQ → at the table → the kit → related, with MealStack
 * as a card linking to its page's Better Together section.)
 * The Kibana-era page is kept at "Claude outputs/ironstack-kibana-page-2026-09-13.astro.bak".
 *
 * Every claim here was checked against ~/Projects/ironstack on Sept 19, 2026:
 * voice examples are the app's own (Voice/VoiceExamples.swift), the award count is
 * Progress/Awards.swift, the importers are Data/DataPorts.swift + Workouts/TrackerCSV.swift.
 *
 * The phone screens are real screenshots (public/images/ironstack/*.webp): Mike's iPhone
 * through iPhone Mirroring on Sept 19, 2026, and Social from the Simulator's sample feed.
 * Never redraw app screens in HTML here; capture them.
 *
 * Sept 19, 2026, evening: reworked after a research session with a three-year Hevy Pro
 * user (Claude-simulated participant "Jess"; notes in the Ironstack project). What moved her:
 * the Hevy import done right, "keep Hevy", never having to talk to it, and the clock in her
 * earbuds. What cost trust: "other apps" lines that were not true of Hevy. So the Hevy
 * section sits under the hero, every "other apps" line is written against Hevy's and
 * Strong's free tiers, and the full Better Together section lives on MealStack's page.
 * The pre-interview page is kept at "Claude outputs/ironstack-page-before-jess-2026-09-19.astro.bak".
 *
 * Color discipline: oxblood for the hero period, eyebrows, section labels, the one
 * marked card (Logging), the Join buttons and the closer accent. Army green for the
 * "Free" stat and "it landed" only. No em-dashes in UI strings.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TopNav from '../../../components/TopNav.astro';

const MAILTO = 'mailto:mike@missionbuilt.io?subject=Ironstack%20beta&body=Apple%20ID%20email%3A%20';

const stats = [
  { key: 'Runs on',           value: 'iPhone',  sub: 'iOS 26 and up',             army: false },
  { key: 'From Hevy or Strong', value: 'Bring it', sub: 'supersets, warm-ups', army: false },
  { key: 'Account to log',    value: 'None',    sub: 'Social is optional',        army: false },
  { key: 'During the beta',   value: 'Free',    sub: 'Coach included',            army: true  },
];

/** Real screens. Captured Sept 19, 2026 from Mike's iPhone via iPhone Mirroring (his own log),
 *  Social from the Simulator's signed-out sample feed. Sources: Claude outputs/ironstack-captures. */
type Shot = { file: string; h: number; k: string; cap: string; alt: string };
const shots: Shot[] = [
  { file: 'home', h: 1188, k: 'Home', cap: 'Stacked for today: what is on the docket, your people, the best thing from your last session, how it is going.', alt: 'Ironstack Home screen: Stacked for today, a Start a session button, an Ask Coach prompt, and how it is going.' },
  { file: 'exercise', h: 1188, k: 'An exercise', cap: 'Today\'s aim from your own history. Load the bar in competition plate colours.', alt: 'Ironstack Comp Deadlift page: 225 lb for 8 at RPE 6 from history, and plate math for 225.' },
  { file: 'progress', h: 1188, k: 'Progress', cap: 'Every exercise you have done, with its line and the change.', alt: 'Ironstack Progress list filtered to deadlift, each exercise with a sparkline and a percent change.' },
  { file: 'sessions', h: 1188, k: 'Sessions', cap: 'Every session, searchable, records called out by name.', alt: 'Ironstack Sessions list with a record: Conventional Deadlift, heaviest set of 5 ever, 275 lb.' },
];

type Card = { label: string; pillar: string; verdict: string; evidence: string; them: string; img: string; h: number; alt: string; mark?: boolean };
const cards: Card[] = [
  { mark: true, img: 'today', h: 1188, alt: 'Ironstack Today: where you are in the program, last session, a type-it field and a large Hold to talk button.', label: 'Logging', pillar: 'Chalk on your hands', verdict: 'Tap it, type it, or say it.', evidence: 'Last time\'s numbers are already in the set: tap to confirm. Changed something? Type 225x8 @7 in the one field. Or hold the talk button and say "two twenty five for eight at seven"; "same again" and "switch to hack squat" work too. Speech is turned into text on the phone, offline, and only while you hold the button.', them: 'Tap the numbers in, set by set, with a keypad.' },
  { img: 'clock-final', h: 1188, alt: 'An E3MOM clock at 0:01: the top of the screen solid oxblood with white numbers, the day\'s lifts below.', label: 'The clock', pillar: 'Chalk on your hands', verdict: 'A rest clock you can read from the platform.', evidence: 'The set lands and rest starts itself, at the length the program asked for. With earbuds in, it says "Thirty seconds" and then "Get to work", and your music dips under it and comes back. On screen the last ten seconds go oxblood and the last three fill the top and beat. On the Lock Screen, "same again" logs another set like the last without unlocking the phone.', them: 'A timer that buzzes, and a phone to unlock to log the next set.' },
  { img: 'plan', h: 1188, alt: 'Ironstack Plan tab on Exercises, with Training, Muscle and Equipment filters and recently done exercises.', label: 'Plan', pillar: 'Capture cannot fail', verdict: 'Bring the plan you already have.', evidence: 'Programs, workouts and exercises, on one tab. Bring your history and routines over from Hevy, Strong or JuggernautAI, open a plan file Claude wrote, or save today\'s session as a workout. Next time, last session\'s numbers are already in every set. Logging becomes confirming.', them: 'Routines and custom exercises capped on the free tier.' },
  { img: 'insights', h: 1188, alt: 'Ironstack Insights: You against you, 14 sessions in 4 weeks, 5 week streak, Comp Deadlift up 4 percent, 12.0 million pounds all time.', label: 'Insights', pillar: 'You against you', verdict: 'Every number is you against you.', evidence: 'Sessions this month against last, your estimated max over twelve weeks, records by name, a progress line on every exercise, and how your lifting lines up with your sleep. Measured against your own log and nobody else\'s. When the data is thin, it says so instead of guessing.', them: 'Graphs, only the last three months of them on Hevy\'s free tier. Working out what they mean is your job.' },
  { img: 'social', h: 1174, alt: 'Ironstack Social sample feed: @dana_lifts Bench day, Comp Bench heaviest triple ever, supported by two spotters.', label: 'Social', pillar: 'Lift each other up', verdict: 'A quiet way to share with the people you train with.', evidence: 'Invite a training partner by text. Share a session as a card: time, sets, the best thing you did. No strangers, and no comments, on purpose: the one thing to give is support, and you see who gave it. If your crew lives in the comments, this is not trying to replace that. Social is optional, and nothing else here needs it.', them: 'Followers, strangers, likes and comments.' },
  { img: 'coach', h: 1188, alt: 'Ironstack Coach proposing a Comp Deadlift opener of 225x8 at RPE 6, with the ceiling and the sets it came from, and a Fill the weight in button.', label: 'Coach', pillar: 'You against you', verdict: 'A coach with a ceiling.', evidence: 'Ask what to open at, what covers a taken rack, or how today went. Every weight it names comes from your own sets, under a ceiling it can show you, with the set the ceiling came from. Nothing it suggests lands in your log until you tap. Not a doctor, and it says so.', them: 'A chatbot that invents a number, or no number at all.' },
];

/** Coming from Hevy. Checked against Data/DataPorts.swift + Workouts/TrackerCSV.swift:
 *  set_type warmup/dropset, superset_id pairs, unknown names kept as "my.<slug>" with the
 *  name as logged, and a preview (IncomingData) before anything is saved. The Hevy menu path
 *  is the one the app's own error message gives. */
type Switch = { k: string; v: string; body: string };
const switching: Switch[] = [
  { k: 'Bring it', v: 'All of it comes over.', body: 'Export from Hevy (Settings, Export & Import Data) or Strong (Settings, Export Data) and open the file in Ironstack. Sessions, routines, supersets paired the way you paired them, warm-ups and drop sets tagged as what they were. Names it knows are matched; names it does not are kept exactly as you had them. A preview shows what it found before anything is saved.' },
  { k: 'Keep your app', v: 'Nothing here needs you to quit.', body: 'The import reads a file you exported. It never signs in to Hevy or Strong, never touches your account, and bringing the same file twice adds nothing. Run both for a couple of weeks and keep whichever earns it.' },
  { k: 'Tap, type or say it', v: 'You never have to talk to it.', body: 'Last time\'s weight and reps are already in every set, so most sets are one tap to confirm. Or type 225x8 in the one field. Voice is there for the days your hands are covered in chalk, and only while you hold the button.' },
];

type Step = { n: string; title: string; body: string };
const steps: Step[] = [
  { n: '01', title: 'Bring your history, or just start.', body: 'Coming from Hevy, Strong or JuggernautAI? Export, open the file, and the preview says what it found before anything lands: sessions, routines, and names to check. Or skip it and log your first set. That starts the session.' },
  { n: '02', title: 'Log it. Time it.', body: 'Tap the number that is already there, type it, or say it. Rest starts itself. Bodyweight and last night\'s sleep come from Apple Health if you let them, and you can always type over them. Tap the weight to change it; the keypad converts pounds and kilos on the spot.' },
  { n: '03', title: 'Stacked.', body: 'Finish and the session closes on what mattered: time, working sets, records by name, a badge if you earned one. Share the card with your spotters, or don\'t. Next time, today\'s lifts are waiting with what you hit.' },
];

type Versus = { k: string; them: string; us: string; honest?: boolean };
/** Written against Hevy's and Strong's free tiers as of Sept 2026 (Hevy free: unlimited
 *  workouts, 4 routines, 7 custom exercises, 3 months of graphs). Keep every "them" line
 *  true of Hevy; a Hevy user reads a wrong one as a reason to distrust the rest. */
const versus: Versus[] = [
  { k: 'Logging a set', them: 'Tap the numbers in, or check off last time\'s.', us: 'The same, plus type 225x8 in one field, or say it.' },
  { k: 'Rest', them: 'A timer that buzzes.', us: 'Starts itself, says "Thirty seconds" and "Get to work" in your earbuds, and fills the screen at the end.' },
  { k: 'A new exercise', them: 'Make a custom one first; the free tier allows seven.', us: 'Say or type any name. It is kept exactly as you said it. Match it later, or never.' },
  { k: 'What is free', them: 'Every workout, but four routines and three months of graphs.', us: 'Every session, every routine, every chart, free in the beta. The launch price is not set; the fine print says why.' },
  { k: 'Social', them: 'Followers, strangers, likes and comments.', us: 'Only partners you invite. Support, no comments, on purpose.' },
  { k: 'Best at', them: 'A watch app, Android, and exercise videos.', us: 'None of those yet. Keep the other app for them; nothing here needs you to quit it.', honest: true },
];

type Faq = { q: string; a: string };
const faqs: Faq[] = [
  { q: 'Do I have to quit Hevy or Strong?', a: 'No. Ironstack reads a file you export; it never signs in there or changes anything. Run both for a couple of weeks. If you go back, your app is exactly as you left it. One honest limit: Ironstack exports your log as a documented JSON file, not a Hevy or Strong CSV, so sessions you log here will not load into them on their own. If an unbroken Hevy history matters to you, log in both while you try it.' },
  { q: 'What comes over from Hevy?', a: 'Sessions and routines, with supersets paired the way Hevy paired them, warm-ups and drop sets tagged as what they were, and your custom exercise names kept exactly. The preview shows what it found, and any names it wants you to check, before anything is saved. In Hevy: Settings, Export & Import Data.' },
  { q: 'What is TestFlight?', a: 'Apple\'s own app for beta testing. I add your Apple ID email, Apple sends you an invite, and TestFlight installs Ironstack like an App Store app. Updates arrive through it until 1.0 lands in the store.' },
  { q: 'Is it free?', a: 'During the beta, yes, Coach included, on an allowance. The launch price is not settled, for the same reason as MealStack: every Coach question runs on a server I pay for. Logging, the clock, your history, Insights and Social cost nothing to run and will not be what you pay for.' },
  { q: 'Does it need an account?', a: 'Not to log. Everything you log is a file on your phone. Social is the one part that needs you to be someone, and it uses Sign in with Apple without asking for your name or email. Skip Social and there is nothing to sign up for.' },
  { q: 'What leaves my phone?', a: 'What you send Coach, when you ask it something. The cards you choose to share with your spotters, if you use Social. Nothing else unless you switch it on. The privacy page says exactly what, where, and for how long.' },
  { q: 'Can I bring my history?', a: 'Yes. Hevy and Strong exports bring history and routines; JuggernautAI brings history. Imported sessions count in your records, Insights and "last time", are labelled as imported, and never go on a card. Bringing the same file twice adds nothing.' },
  { q: 'Pounds or kilos?', a: 'Both. Pick one for the app, and switch any single exercise the other way, because the dumbbells at a hotel gym do not care where you live. The keypad shows the other unit under every number, and one tap types in it.' },
  { q: 'Streaks and badges?', a: 'A weekly streak on Insights and 167 badges that take years to finish: Road Warrior for training on the road, Dawn patrol, a thousand feet of carries, In their corner for supporting others. Earned, never shamed. Miss a week and nothing scolds you.' },
  { q: 'Is Coach a doctor?', a: 'No. Coach is an AI. It answers from your own sets, never names a weight above a ceiling it can show you, and points any question about pain or injury to a qualified person. Nothing it suggests changes your log until you tap.' },
  { q: 'Android, iPad, watch?', a: 'iPhone only, iOS 26 and up. No Android, no iPad layout, and no watch app yet. What covers some of the watch: the clock talks in your earbuds, and the Lock Screen has a "same again" button that logs a set without unlocking. If your phone lives in a locker, that is not enough, and I would rather say so.' },
  { q: 'Which license?', a: 'MIT, like the Loadout skills, and the source goes public with 1.0. Then read it, change it, ship it. The Ironstack name and marks stay with Mission Built.' },
  { q: 'When is 1.0?', a: 'When a fresh install has been proven on phones that are not mine, and two lifters who are not me have used Social against each other. The date lands on this page before it lands in the store.' },
];

const title = 'Ironstack, the details: log it, time it, lift each other up · Mission Built';
const description = 'Ironstack is a lifting log for iPhone. Bring your Hevy or Strong history, supersets and warm-ups included, and keep the app you use now. Tap, type or say the set; the rest clock talks in your earbuds; Insights compare you only to you; and a feed that is only the people you train with. Free during the private beta.';

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Ironstack',
      url: 'https://missionbuilt.io/rack/ironstack/details',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS 26',
      description,
      author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
      publisher: { '@type': 'Organization', name: 'Mission Built', url: 'https://missionbuilt.io' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', description: 'Free during the private beta. Launch price not yet set.' },
    },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  ogImageAlt="Ironstack. Log it. Time it. Lift each other up. A lifting log for iPhone, by Mission Built."
  active="rack"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <TopNav active="rack" />

  <main id="main" class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/rack">The Rack</a>
      <span aria-hidden="true"> / </span>
      <a href="/rack/ironstack">Ironstack</a>
      <span aria-hidden="true"> / </span>
      <span class="here">The details</span>
    </nav>

    {/* ---------- HERO ---------- */}
    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>An iPhone app from the Rack</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>
      <h1 class="display"><span>Ironstack</span><span class="dot">.</span></h1>
      <div class="testing-tag" aria-label="Private beta, for iPhone">
        <span class="tag-sq" aria-hidden="true"></span>
        <span>Private beta</span>
        <span class="tag-sep" aria-hidden="true">·</span>
        <svg class="ph-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 18.5h4"/></svg>
        <span>iPhone</span>
      </div>
      <p class="subtitle">
        <span class="line1">Log it. Time it. Lift each other up.</span>
        <span class="line2">A lifting log that brings your history, talks you through rest, and stays out of your way.</span>
      </p>
      <div class="hero-ctas">
        <a class="cta" href="#beta">Join the beta →</a>
        <a class="cta-soft" href="#from-hevy">Coming from Hevy or Strong? ↓</a>
      </div>
      <p class="hero-note">Free during the beta · Keep the app you use now · Your whole log exports any time</p>
    </section>

    <section class="meta-strip" aria-label="Ironstack at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          <div class:list={['stat-value', s.army && 'army']}>{s.value}{s.sub && <span class="stat-sub">{s.sub}</span>}</div>
        </div>
      ))}
    </section>

    {/* ---------- COMING FROM HEVY ---------- */}
    <section class="block" id="from-hevy">
      <p class="section-label">Coming from Hevy or Strong</p>
      <h2 class="section-h2">Bring your history. Keep your app. Try it for two weeks.</h2>
      <div class="lic three switch">
        {switching.map((w) => (
          <div class="lic-cell">
            <p class="k">{w.k}</p>
            <p class="v">{w.v}</p>
            <p class="body">{w.body}</p>
          </div>
        ))}
      </div>
      <p class="note">JuggernautAI history comes over the same way. What it will not do yet: a watch app, Android, or exercise videos. If you need those, keep the other app for them.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- WHAT IT DOES DIFFERENTLY: each with its real screen ---------- */}
    <section class="block" id="see">
      <p class="section-label">What it does differently</p>
      <h2 class="section-h2">Six things a logging app should have done already.</h2>
      <p class="prose">Every screen here is the real app on my phone, with my own training behind it. Social is the app's sample feed, because my spotters' sessions are theirs to share, not mine.</p>
      <div class="feats">
        {cards.map((c) => (
          <article class:list={['feat', c.mark && 'mark']}>
            <img src={`/images/ironstack/${c.img}.webp`} width="540" height={c.h} alt={c.alt} loading="lazy" decoding="async" />
            <div class="feat-body">
              <p class="label">{c.label}<span class="pillar"> · {c.pillar}</span></p>
              <p class="verdict">{c.verdict}</p>
              <p class="evidence">{c.evidence}</p>
              <p class="them"><b>Other apps:</b> {c.them}</p>
            </div>
          </article>
        ))}
      </div>

      <h3 class="sub-h3">More of the app</h3>
      <div class="phones" tabindex="0" aria-label="Four more Ironstack screens.">
        {shots.map((s) => (
          <figure class="phone">
            <img src={`/images/ironstack/${s.file}.webp`} width="540" height={s.h} alt={s.alt} loading="lazy" decoding="async" />
            <figcaption><span class="k">{s.k}</span>{s.cap}</figcaption>
          </figure>
        ))}
      </div>
      <p class="note">Screenshots from Ironstack on iPhone, Sept 19, 2026, mirrored to a Mac, during a live E3MOM. The Social screen is the Simulator, on the sample spotters the app shows before you sign in.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- WHY ---------- */}
    <section class="block" id="why">
      <p class="section-label">Why it exists</p>
      <h2 class="section-h2">A set that happened gets written down.</h2>
      <div class="story">
        <p>The first Ironstack lived on my laptop, and it was good at telling me what a week meant. Then one day I named an exercise it had never heard of, and it would not take the set. A log that can refuse a set you did is not a log.</p>
        <p>So I rebuilt it around one rule, and put it on my phone, because the rack is where the set happens and my hands are covered in chalk. I wanted a log that takes whatever you did, reads the clock to you, and treats the people you train with as partners rather than an audience. Four ideas hold up everything it does.</p>
      </div>
      <ol class="pillars" aria-label="The four pillars">
        <li><span class="num">01</span><span class="label">Capture cannot fail</span><span class="say">A set you did is a fact. A name the app does not know is kept exactly as you said it, never refused.</span></li>
        <li><span class="num">02</span><span class="label">Chalk on your hands</span><span class="say">Tap, type or say the set. Big targets. A clock you can read from the platform and hear in your earbuds.</span></li>
        <li><span class="num">03</span><span class="label">You against you</span><span class="say">Every number is measured against your own log. No leaderboards, no strangers, no one else's PR.</span></li>
        <li><span class="num">04</span><span class="label">Lift each other up</span><span class="say">Only the people you invite. Cards carry no free text. The one thing you can give is support.</span></li>
      </ol>
    </section>

    <hr class="dashed" />

    {/* ---------- TRY IT: voice card + clock ---------- */}
    <section class="block" id="try">
      <p class="section-label">Try it</p>
      <h2 class="section-h2">Say it the way you would say it to a partner.</h2>
      <p class="prose">Voice is optional; typing the same words works too. These are the examples on the app's own voice card. Tap one to see what it writes down. Then start a rest and watch the end of it.</p>
      <div class="try">
        <div class="voice" id="voice">
          <p class="k">You say</p>
          <div class="chips" role="group" aria-label="Voice examples">
            <button type="button" class="chip on" data-said="two twenty five for eight at seven" data-parse="225x8 @7" data-means="225 lb for 8 reps at RPE 7, on the lift you are doing.">"two twenty five for eight at seven"</button>
            <button type="button" class="chip" data-said="same again" data-parse="225x8 @7" data-means="The same set again. The rest clock restarts.">"same again"</button>
            <button type="button" class="chip" data-said="four oh five for three with two in the tank" data-parse="405x3 @8" data-means="Two reps in the tank is RPE 8. &quot;Oh&quot; is zero.">"four oh five for three with two in the tank"</button>
            <button type="button" class="chip" data-said="three fifteen for three with chains" data-parse="315x3 +chains" data-means="The chains ride on the set, so it never counts against a straight-bar best.">"three fifteen for three with chains"</button>
            <button type="button" class="chip" data-said="switch to hack squat" data-parse="→ Hack Squat" data-means="What you log next goes there.">"switch to hack squat"</button>
            <button type="button" class="chip" data-said="note, lower back aware" data-parse="note · lower back aware" data-means="Kept in your own words, on this lift.">"note, lower back aware"</button>
          </div>
          <p class="k">Ironstack writes</p>
          <p class="parse" id="v-parse" aria-live="polite">225x8 @7</p>
          <p class="means" id="v-means">225 lb for 8 reps at RPE 7, on the lift you are doing.</p>
        </div>
        <div class="clockdemo" id="clockdemo">
          <p class="k">Rest</p>
          <p class="cd-time" id="cd-time" aria-live="off">0:20</p>
          <div class="cd-bar"><i id="cd-bar"></i></div>
          <p class="cd-note" id="cd-note">Twenty seconds here; three minutes in the gym. Watch the last ten.</p>
          <button type="button" class="cta small" id="cd-go">Start rest</button>
        </div>
      </div>
      <p class="note">Speech becomes text on the phone, offline, and only while you hold the button. Weight comes before reps, the way lifters say it; RPE is how hard it was on a scale to 10, and the app explains it wherever you rate a set. The rest clock is the length your program asked for. The app never records what you actually rested, because it does not know.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- HOW YOU USE IT ---------- */}
    <section class="block" id="how">
      <p class="section-label">How you use it</p>
      <h2 class="section-h2">Open it, log the first set, get on with it.</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step"><span class="step-n">{s.n}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></li>
        ))}
      </ol>
      <h3 class="sub-h3">And the rest</h3>
      <p class="prose">
        An exercise is not always a lift: the collection covers barbell, machines and bodybuilding, conditioning (twenty minutes on the air bike is a session too) and strongman, browsable by muscle group.
        Every exercise page has plate math in competition colours, with the bar and the plates in their own units, hidden in one tap for anything without a bar.
        Travel mode for sessions on the road, a Home Screen widget, and 167 badges that grow with you over years, not just the first week.
        Apple Health fills in your weigh-in and last night's sleep, and can take each session as a strength workout. Your whole log exports in one file, in a documented format, any time.
      </p>
