---
import { SHOW_APP_SCREENS, hasScreen, slotName } from '../../../data/screens';
/**
 * THE DETAILS PAGE (/rack/ironstack/details). /rack/ironstack is the short landing page
 * (what is different, the features with real screens, how to get it); this is the full page.
 *
 * An iPhone app for logging lifting: tap, type or say the set, the rest clock runs itself,
 * and a feed that is only the people you train with. The app's own line: "Log it. Time it.
 * Lift each other up." Built on MealStack's page skeleton so the two read as one family.
 *
 * Order: hero → coming from Hevy → six cards → why → try it → how → side by side →
 * fine print → beta → FAQ → at the table (your log as files, and what reads them) →
 * the kit → related, with MealStack as a card linking to its Better Together section.
 *
 * Every "other apps" line is written against Hevy's and Strong's free tiers; a Hevy user
 * reads a wrong one as a reason to distrust the rest. Every claim is checked against the
 * app before it goes up. Phone screens are real screenshots (public/images/ironstack/*.webp);
 * never redraw app screens in HTML here. Skills are not mentioned on the Rack; they live
 * on the Loadout (/loadout/plans).
 *
 * Color discipline: oxblood for the hero period, eyebrows, section labels, the one
 * marked card (Logging), the Join buttons and the closer accent. Army green for the
 * "Free" stat and "it landed" only. No em-dashes in UI strings.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { getCollection as getReleases } from 'astro:content';
import { newestBuild, releaseUrl, when } from '../../../data/releases';
import TopNav from '../../../components/TopNav.astro';

const build = newestBuild(await getReleases('releases'), 'ironstack');
const MAILTO = 'mailto:support@missionbuilt.io?subject=IronStack%20beta&body=Apple%20ID%20email%3A%20';

const stats = [
  { key: 'Runs on',           value: 'iPhone',  sub: '+ Apple Watch · iOS 26 and up', army: false },
  { key: 'From any app',      value: 'Bring it', sub: 'supersets, prep sets',     army: false },
  { key: 'Account to log',    value: 'None',    sub: 'Social is optional',        army: false },
  { key: 'During the beta',   value: 'Free',    sub: 'Stack AI included',            army: true  },
];

/** Real screens, from Mike's own log; Social from the app's signed-out sample feed. */
type Shot = { file: string; h: number; k: string; cap: string; alt: string };
const shots: Shot[] = [
  { file: 'home', h: 1174, k: 'Home', cap: 'Today first: what is on the docket, loaded in one tap. Then your people, who lifted you, your progress, and Stack AI.', alt: 'IronStack Home: the Mission Built header, Today with Heavy lower and a Load it button, Your people, and Progress.' },
  { file: 'exercise', h: 1174, k: 'An exercise', cap: 'Add any exercise to today\'s workout or to a day of your program, in one tap.', alt: 'IronStack Comp Deadlift: Powerlifting, Hamstrings, then Add to a workout with Today\'s workout first, the four days of Shaw Elite, and A new workout.' },
  { file: 'progress', h: 1174, k: 'Progress', cap: 'Every exercise you have done, with its line and the change.', alt: 'IronStack Progress: every exercise with its sparkline and the change.' },
  { file: 'set-sheet-load', h: 1174, k: 'The set sheet', cap: 'The load card fits the lift: a barbell drawn the way it is loaded, 45 bar and 90 per side, plates a tap each, RPE in one row.', alt: 'IronStack Log a set for Comp Deadlift: Loaded, Barbell 45 lb, the bar drawn with its plates, 45 bar + 90 per side, 225 lb for 8, and an RPE row above Log.' },
  { file: 'today-circuit', h: 1174, k: 'A circuit', cap: 'Exercises done together, lettered A1 to A4. Log one and the next is up.', alt: 'IronStack Today on a Strongman circuit: Log Clean and Press logged, Farmers Walk up next at 278 for 1 from the plan, then Sandbag Carry and Kettlebell Swing.' },
  { file: 'settings-training-days', h: 1174, k: 'Training days', cap: 'Your training days and workout time. Today plans from them, and MealStack can follow.', alt: 'IronStack Settings: Remind me to train, training days Wednesday and Friday, and a workout time of 6:55 PM.' },
  { file: 'sessions', h: 1174, k: 'Workouts', cap: 'Every workout, searchable, records called out by name.', alt: 'IronStack Workouts: each workout with its program day, time, working sets and top sets, and a record called out by name.' },
];

type Card = { label: string; pillar: string; verdict: string; evidence: string; them: string; img: string; h: number; alt: string; mark?: boolean };
const cards: Card[] = [
  { mark: true, img: 'today', h: 1174, alt: 'IronStack Today before the start: Shaw Elite week 3, day 1 of 4, Heavy lower with Change, Comp Deadlift first up at 225 for 8, and one Start workout button.', label: 'Logging', pillar: 'Chalk on your hands', verdict: 'Tap it, type it, or say it.', evidence: 'Last time\'s numbers are already in the set: tap to confirm. Changed something? Type 225x8 @7 in the one field. Or hold the talk button and say "two twenty five for eight at seven"; "same again" and "switch to hack squat" work too. Speech is turned into text on the phone, offline, and only while you hold the button. Logged the wrong set? Swipe left on it and Unlog puts it back to planned. Rack taken? Swipe left on the exercise and Swap it, for today or for every time.', them: 'Tap the numbers in, set by set, with a keypad.' },
  { img: 'clock-final', h: 1174, alt: 'The IronStack rest clock at 0:02: the top of the screen solid oxblood, with the squares row under it.', label: 'The clock', pillar: 'Chalk on your hands', verdict: 'A rest clock you can read from the platform.', evidence: 'The set lands and rest starts itself, at the length the program asked for. With earbuds in, a recorded voice calls "Thirty seconds", "Five seconds" and "Get to work", and your music dips under it and comes back. Voice, buzz or off, and it minds the silent switch. On screen the last ten seconds go oxblood and the last three fill the top and beat. On the Lock Screen, "same again" logs another set like the last without unlocking the phone. A timed set, a plank or a carry, gets a timer: tap to start, and at zero it holds the time until you log. It never logs for you.', them: 'A timer that buzzes, and a phone to unlock to log the next set.' },
  { img: 'plan', h: 1174, alt: 'IronStack Plan: one search for programs, workouts and exercises, Your program Shaw Elite with Heavy lower next and Start Heavy lower, then Other programs and Workouts that need no program.', label: 'Plan', pillar: 'Capture cannot fail', verdict: 'Bring the plan you already have.', evidence: 'Programs, workouts and exercises, on one tab: a program holds its workouts, a workout holds its exercises, and one search finds all three. Bring your history over from Hevy, Strong, JuggernautAI or any spreadsheet you kept, send Stack AI a photo or PDF of your program and it writes it down, or save today\'s workout to do again. Workouts hold your targets, 3 × 8 · 135 lb, and next time last workout\'s numbers are already in every set. Logging becomes confirming.', them: 'Routines and custom exercises capped on the free tier.' },
  { img: 'insights', h: 1174, alt: 'IronStack Insights on my own log: 7 workouts in 4 weeks, 30 percent down on the 4 before, a weekly streak with the longest at 40 weeks, 2 records in 90 days, and 13.8 million pounds all time across 650 workouts.', label: 'Insights', pillar: 'You against you', verdict: 'Every number is you against you.', evidence: 'Workouts this month against last, your estimated max over twelve weeks, records by name, a progress line on every exercise, and how you lift on the days you feel good against the flat ones. Measured against your own log and nobody else\'s. When the data is thin, it says so instead of guessing.', them: 'Graphs, only the last three months of them on Hevy\'s free tier. Working out what they mean is your job.' },
  { img: 'social', h: 1174, alt: 'IronStack Social before you sign in: a sample Bench day card with a heaviest triple and two new badges, supported by spotters.', label: 'Social', pillar: 'Lift each other up', verdict: 'A quiet way to share with the people you train with.', evidence: 'Invite a training partner by text. Share a workout as a card: time, sets, the best thing you did. No strangers, and no comments, on purpose: the one thing to give is support, and you see who gave it. If your crew lives in the comments, this is not trying to replace that. Social is optional, and nothing else here needs it.', them: 'Followers, strangers, likes and comments.' },
  { img: 'stackai-chat', h: 1174, alt: 'Stack AI in IronStack, turned on and waiting for a question: it reads what you have logged and answers, nothing lands in your log until you tap accept, every weight comes from your own sets, and under the box the line Stack AI is an AI and can be wrong.', label: 'Stack AI', pillar: 'You against you', verdict: 'An AI with a ceiling.', evidence: 'Turn it on, then ask what to open at, what covers a taken rack, or how today went. Send it a photo or PDF of the program your coach wrote and it writes it down for you to check. Every weight it names comes from your own sets, under a ceiling it can show you, with the set the ceiling came from. Nothing it suggests lands in your log until you tap. Not a doctor, and it says so.', them: 'A chatbot that invents a number, or no number at all.' },
];

/** Coming from Hevy. Checked against the app's importers: warm-up and drop set types, superset
 *  pairs, unknown names kept as logged, and a preview before anything is saved. The Hevy menu
 *  path is the one the app's own error message gives. */
type Switch = { k: string; v: string; body: string };
const switching: Switch[] = [
  { k: 'Bring it', v: 'All of it comes over.', body: 'Export from Hevy (Settings, Export & Import Data) or Strong (Settings, Export Data) and open the file in IronStack, or bring any spreadsheet you kept. Workouts, routines as saved workouts, supersets paired the way you paired them, prep sets and drop sets tagged as what they were. Names it knows are matched; names it does not are kept exactly as you had them. A preview shows what it found before anything is saved.' },
  { k: 'Keep your app', v: 'Nothing here needs you to quit.', body: 'The import reads a file you exported. It never signs in to Hevy or Strong, never touches your account, and bringing the same file twice adds nothing. Run both for a couple of weeks and keep whichever earns it.' },
  { k: 'Tap, type or say it', v: 'You never have to talk to it.', body: 'Last time\'s weight and reps are already in every set, so most sets are one tap to confirm. Or type 225x8 in the one field. Voice is there for the days your hands are covered in chalk, and only while you hold the button.' },
];

type Step = { n: string; title: string; body: string };
const steps: Step[] = [
  { n: '01', title: 'Bring your history, or just start.', body: 'Coming from Hevy, Strong, JuggernautAI or a spreadsheet? Export, open the file, and the preview says what it found before anything lands: workouts, saved workouts, and names to check. Or skip it and log your first set. That starts the workout.' },
  { n: '02', title: 'Log it. Time it.', body: 'Tap the number that is already there, type it, or say it. Rest starts itself. Bodyweight comes from Apple Health if you let it, and you can always type over it. Tap the weight to change it; the keypad converts pounds and kilos on the spot.' },
  { n: '03', title: 'Stacked.', body: 'Finish and the workout closes on what mattered: time, working sets, records by name, a badge if you earned one. Share the card with your spotters, or don\'t. Next time, today\'s lifts are waiting with what you hit.' },
];

type Versus = { k: string; them: string; us: string; honest?: boolean };
/** Written against Hevy's and Strong's free tiers as of Sept 2026 (Hevy free: unlimited
 *  workouts, 4 routines, 7 custom exercises, 3 months of graphs). Keep every "them" line
 *  true of Hevy; a Hevy user reads a wrong one as a reason to distrust the rest. */
const versus: Versus[] = [
  { k: 'Logging a set', them: 'Tap the numbers in, or check off last time\'s.', us: 'The same, plus type 225x8 in one field, or say it.' },
  { k: 'Rest', them: 'A timer that buzzes.', us: 'Starts itself, calls "Thirty seconds", "Five seconds" and "Get to work" in your earbuds, and fills the screen at the end.' },
  { k: 'A new exercise', them: 'Make a custom one first; the free tier allows seven.', us: 'Say or type any name. It is kept exactly as you said it. Match it later, or never.' },
  { k: 'What is free', them: 'Every workout, but four routines and three months of graphs.', us: 'Every workout you log, every saved workout, every chart, free in the beta. The launch price is not set; the fine print says why.' },
  { k: 'Social', them: 'Followers, strangers, likes and comments.', us: 'Only partners you invite. Support, no comments, on purpose.' },
  { k: 'Coaching', them: 'Hevy Coach, a separate app for trainers; clients log in Hevy.', us: 'Coach mode, inside IronStack: the plan comes in as a suggestion, workouts go out, every change from the plan is marked. In the beta, a few coaches and their lifters at a time.' },
  { k: 'Best at', them: 'Android and exercise videos.', us: 'Neither yet. Keep the other app for them; nothing here needs you to quit it.', honest: true },
];

type Faq = { q: string; a: string; link?: { label: string; href: string } };
const faqs: Faq[] = [
  { q: 'Do I have to quit Hevy or Strong?', a: 'No. IronStack reads a file you export; it never signs in there or changes anything. Run both for a couple of weeks. If you go back, your app is exactly as you left it. One honest limit: IronStack exports your log as a documented JSON file, not a Hevy or Strong CSV, so workouts you log here will not load into them on their own. If an unbroken Hevy history matters to you, log in both while you try it.' },
  { q: 'What comes over from Hevy?', a: 'Workouts and routines (routines come in as saved workouts), with supersets paired the way Hevy paired them, warm-ups as prep sets and drop sets tagged as what they were, and your custom exercise names kept exactly. The preview shows what it found, and any names it wants you to check, before anything is saved. In Hevy: Settings, Export & Import Data.' },
  { q: 'What is TestFlight?', a: 'Apple\'s own app for beta testing. I add your Apple ID email, Apple sends you an invite, and TestFlight installs IronStack like an App Store app. Updates arrive through it until 1.0 lands in the store.' },
  { q: 'Is it free?', a: 'During the TestFlight beta, yes. Stack AI runs on a monthly allowance per phone, because every Stack AI question runs on a server I pay for. The launch price is not set, and it lands on this page before it lands in the store.' },
  { q: 'Does it need an account?', a: 'Not to log. Everything you log is a file on your phone. Social is the one part that needs you to be someone, and it uses Sign in with Apple without asking for your name or email. Skip Social and there is nothing to sign up for.' },
  { q: 'What leaves my phone?', a: 'Nothing goes to Anthropic until you turn Stack AI on, and then only what you send it, when you ask. The cards you choose to share with your spotters, if you use Social. Nothing else unless you switch it on. The privacy page says exactly what, where, and for how long.' },
  { q: 'Can I bring my history?', a: 'Yes. Hevy and Strong exports bring history and routines; JuggernautAI and any spreadsheet you kept bring history, with a preview to match the columns. Imported workouts count in your records, Insights and "last time", are labelled as imported, and never go on a card. Bringing the same file twice adds nothing.' },
  { q: 'Pounds or kilos?', a: 'Both. Pick one for the app, and switch any single exercise the other way, because the dumbbells at a hotel gym do not care where you live. The keypad shows the other unit under every number, and one tap types in it.' },
  { q: 'Streaks and badges?', a: 'A weekly streak on Insights and badges that take years to finish: Road Warrior for training on the road, Dawn patrol, a thousand feet of carries, In their corner for supporting others. Earned, never shamed. Miss a week and nothing scolds you.' },
  { q: 'Is Stack AI a doctor?', a: 'No. It is an AI, and it can be wrong. It answers from your own sets, never names a weight above a ceiling it can show you, and points any question about pain or injury to a qualified person. Nothing it suggests changes your log until you tap.' },
  { q: 'Apple Watch, Android, iPad?', a: 'Apple Watch, yes. The watch app comes with the iPhone app (watchOS 26 and up), and it is a remote for the workout on your phone: start on either one, and both show the same set. The watch shows the set you are on and the clock, a swipe apart: tap the card to log, tap the time to pause, hold the card and turn the Crown to change the weight. A timed set runs its timer there too, and after the last set you finish from your wrist. The whole workout lands in Health as one, with heart rate. Keep your phone nearby, in a bag or on the bench; if the watch loses it, the clock keeps running and what you logged is sent when it reconnects. No Android and no iPad layout yet.' },
  { q: 'What is Coach mode?', a: 'Training with a real person who also uses IronStack. Your coach asks by your handle; nothing is shared until you say yes, and you choose what they see: every set always, your notes unless you turn them off, and sleep, bodyweight and MealStack fueling only if you switch them on. Their plans arrive as suggestions. Either of you can end it, and their copy goes with it. In the beta it opens to a few coaches and their lifters at a time; if you train with a coach, say so when you sign up.', link: { label: 'What Coach mode shares →', href: '/rack/ironstack/privacy#coach-mode' } },
  { q: 'Is Stack AI my coach?', a: 'No. Coach means a person. Stack AI is the AI: it picks weights from your own sets under a ceiling, and it writes down a program you already have, but it does not design one.' },
  { q: 'How old do I have to be?', a: 'Eighteen, the same as MealStack. IronStack, Stack AI and Social are for adults.' },
  { q: 'Is the code open?', a: 'No. IronStack is a closed app. Your data is open: one tap exports everything in the Mission Built Schema, and it imports back. The IronStack name and marks stay with Mission Built.' },
  { q: 'When is 1.0?', a: 'When a fresh install has been proven on phones that are not mine, and two lifters who are not me have used Social against each other. The date lands on this page before it lands in the store.' },
];

const title = 'IronStack, the details: log fast, see progress, a coach in your corner · Mission Built';
const description = 'IronStack is a lifting log for iPhone and Apple Watch. Bring your history from Hevy, Strong or any spreadsheet, supersets and prep sets included, and keep the app you use now. Tap, type or say the set; the rest clock talks in your earbuds; Insights compare you only to you; and a feed that is only the people you train with. Free during the TestFlight beta.';

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'IronStack',
      url: 'https://missionbuilt.io/rack/ironstack/details',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS 26, watchOS 26',
      description,
      author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
      publisher: { '@type': 'Organization', name: 'Mission Built', url: 'https://missionbuilt.io' },
    },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  ogImage="/images/ironstack/og.jpg"
  ogImageAlt="IronStack. Log fast. See progress. A coach in your corner. A lifting log for iPhone and Apple Watch, by Mission Built."
  active="rack"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <TopNav active="rack" />

  <main id="main" class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/rack">The Rack</a>
      <span aria-hidden="true"> / </span>
      <a href="/rack/ironstack">IronStack</a>
      <span aria-hidden="true"> / </span>
      <span class="here">The details</span>
    </nav>

    {/* ---------- HERO ---------- */}
    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>An iPhone app from the Rack</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>
      <h1 class="display"><span>IronStack</span><span class="dot">.</span></h1>
      <div class="testing-tag" aria-label="Private beta, for iPhone and Apple Watch">
        <span class="tag-sq" aria-hidden="true"></span>
        <span>Private beta</span>
        <span class="tag-sep" aria-hidden="true">·</span>
        <svg class="ph-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 18.5h4"/></svg>
        <span>iPhone + Apple Watch</span>
      </div>
      <p class="subtitle">
        <span class="line1">Log fast. See progress. A coach in your corner.</span>
        <span class="line2">A lifting log that brings your history, talks you through rest, and stays out of your way.</span>
      </p>
      <div class="hero-ctas">
        <a class="cta" href="#beta">Join the beta →</a>
        <a class="cta-soft" href="#from-hevy">Coming from Hevy or Strong? ↓</a>
      </div>
      <p class="hero-note">Free during the beta · Keep the app you use now · Your whole log exports any time</p>
    </section>

    <section class="meta-strip" aria-label="IronStack at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          <div class:list={['stat-value', s.army && 'army']}>{s.value}{s.sub && <span class="stat-sub">{s.sub}</span>}</div>
        </div>
      ))}
    </section>

    {/* ---------- COMING FROM HEVY ---------- */}
    <section class="block" id="from-hevy">
      <p class="section-label">Coming from Hevy or Strong</p>
      <h2 class="section-h2">Bring your history. Keep your app. Try it for two weeks.</h2>
      <div class="lic three switch">
        {switching.map((w) => (
          <div class="lic-cell">
            <p class="k">{w.k}</p>
            <p class="v">{w.v}</p>
            <p class="body">{w.body}</p>
          </div>
        ))}
      </div>
      <p class="note">JuggernautAI history comes over the same way. What it will not do yet: Android or exercise videos. If you need those, keep the other app for them.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- WHAT IT DOES DIFFERENTLY: each with its real screen ---------- */}
    <section class="block" id="see">
      <p class="section-label">What it does differently</p>
      <h2 class="section-h2">Six things a logging app should have done already.</h2>
      <p class="prose">Every screen here is the real app on my phone, with my own training behind it. Social is the app's sample feed, because my spotters' workouts are theirs to share, not mine.</p>
      <div class="feats">
        {cards.map((c) => (
          <article class:list={['feat', c.mark && 'mark']}>
            {SHOW_APP_SCREENS && (hasScreen(`/images/ironstack/${c.img}.webp`)
              ? <img src={`/images/ironstack/${c.img}.webp`} width="540" height={c.h} alt={c.alt} loading="lazy" decoding="async" />
              : <div class="screen-slot" role="img" aria-label={c.alt} style={`aspect-ratio:540/${c.h}`}><b>Screen to capture</b><span>{slotName(`/images/ironstack/${c.img}.webp`)}</span></div>)}
            <div class="feat-body">
              <p class="label">{c.label}<span class="pillar"> · {c.pillar}</span></p>
              <p class="verdict">{c.verdict}</p>
              <p class="evidence">{c.evidence}</p>
              <p class="them"><b>Other apps:</b> {c.them}</p>
            </div>
          </article>
        ))}
      </div>

      {SHOW_APP_SCREENS && <h3 class="sub-h3">More of the app</h3>}
      {SHOW_APP_SCREENS && <div class="phones" tabindex="0" aria-label={`${shots.length} more IronStack screens.`}>
        {shots.map((s) => (
          <figure class="phone">
            <img src={`/images/ironstack/${s.file}.webp`} width="540" height={s.h} alt={s.alt} loading="lazy" decoding="async" />
            <figcaption><span class="k">{s.k}</span>{s.cap}</figcaption>
          </figure>
        ))}
      </div>}
      {SHOW_APP_SCREENS && <p class="note">Screens from the October 3 build of IronStack 0.1.1 in the iPhone Simulator, loaded with my own training log. The Social screen is the sample feed the app shows before you sign in.</p>}
    </section>

    <hr class="dashed" />

    {/* ---------- WHY ---------- */}
    <section class="block" id="why">
      <p class="section-label">Why it exists</p>
      <h2 class="section-h2">A set that happened gets written down.</h2>
      <div class="story">
        <p>The first IronStack lived on my laptop, and it was good at telling me what a week meant. Then one day I named an exercise it had never heard of, and it would not take the set. A log that can refuse a set you did is not a log.</p>
        <p>So I rebuilt it around one rule, and put it on my phone, because the rack is where the set happens and my hands are covered in chalk. I wanted a log that takes whatever you did, reads the clock to you, and treats the people you train with as partners rather than an audience. Four ideas hold up everything it does.</p>
      </div>
      <ol class="pillars" aria-label="The four pillars">
        <li><span class="num">01</span><span class="label">Capture cannot fail</span><span class="say">A set you did is a fact. A name the app does not know is kept exactly as you said it, never refused.</span></li>
        <li><span class="num">02</span><span class="label">Chalk on your hands</span><span class="say">Tap, type or say the set. Big targets. A clock you can read from the platform and hear in your earbuds.</span></li>
        <li><span class="num">03</span><span class="label">You against you</span><span class="say">Every number is measured against your own log. No leaderboards, no strangers, no one else's PR.</span></li>
        <li><span class="num">04</span><span class="label">Lift each other up</span><span class="say">Only the people you invite. Cards carry no comments, and a name you type is checked before it goes. The one thing you can give is support.</span></li>
      </ol>
    </section>

    <hr class="dashed" />

    {/* ---------- TRY IT: voice card + clock ---------- */}
    <section class="block" id="try">
      <p class="section-label">Try it</p>
      <h2 class="section-h2">Say it the way you would say it to a partner.</h2>
      <p class="prose">Voice is optional; typing the same words works too. These are the examples on the app's own voice card. Tap one to see what it writes down. Then start a rest and watch the end of it.</p>
      <div class="try">
        <div class="voice" id="voice">
          <p class="k">You say</p>
          <div class="chips" role="group" aria-label="Voice examples">
            <button type="button" class="chip on" data-said="two twenty five for eight at seven" data-parse="225x8 @7" data-means="225 lb for 8 reps at RPE 7, on the lift you are doing.">"two twenty five for eight at seven"</button>
            <button type="button" class="chip" data-said="same again" data-parse="225x8 @7" data-means="The same set again. The rest clock restarts.">"same again"</button>
            <button type="button" class="chip" data-said="four oh five for three with two in the tank" data-parse="405x3 @8" data-means="Two reps in the tank is RPE 8. &quot;Oh&quot; is zero.">"four oh five for three with two in the tank"</button>
            <button type="button" class="chip" data-said="three fifteen for three with chains" data-parse="315x3 +chains" data-means="The chains ride on the set, so it never counts against a straight-bar best.">"three fifteen for three with chains"</button>
            <button type="button" class="chip" data-said="switch to hack squat" data-parse="→ Hack Squat" data-means="What you log next goes there.">"switch to hack squat"</button>
            <button type="button" class="chip" data-said="note, lower back aware" data-parse="note · lower back aware" data-means="Kept in your own words, on this lift.">"note, lower back aware"</button>
          </div>
          <p class="k">IronStack writes</p>
          <p class="parse" id="v-parse" aria-live="polite">225x8 @7</p>
          <p class="means" id="v-means">225 lb for 8 reps at RPE 7, on the lift you are doing.</p>
        </div>
        <div class="clockdemo" id="clockdemo">
          <p class="k">Rest</p>
          <p class="cd-time" id="cd-time" aria-live="off">0:20</p>
          <div class="cd-bar"><i id="cd-bar"></i></div>
          <p class="cd-note" id="cd-note">Twenty seconds here; three minutes in the gym. Watch the last ten.</p>
          <button type="button" class="cta small" id="cd-go">Start rest</button>
        </div>
      </div>
      <p class="note">Speech becomes text on the phone, offline, and only while you hold the button. Weight comes before reps, the way lifters say it; RPE is how hard it was on a scale to 10, and the app explains it wherever you rate a set. The rest clock is the length your program asked for. The app never records what you actually rested, because it does not know.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- HOW YOU USE IT ---------- */}
    <section class="block" id="how">
      <p class="section-label">How you use it</p>
      <h2 class="section-h2">Open it, log the first set, get on with it.</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step"><span class="step-n">{s.n}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></li>
        ))}
      </ol>
      <h3 class="sub-h3">And the rest</h3>
      <p class="prose">
        An exercise is not always a lift: the collection covers barbell, machines and bodybuilding, conditioning (twenty minutes on the air bike is a workout too), Pilates, barre and yoga, and strongman, browsable by muscle group, with search that finds "low impact" or "hotel" as well as a name.
        Every exercise has a load card that fits it: a loaded bar with plate math, a fixed bar, a stack, bodyweight or a band. Plate math switches itself off for cables, machines, dumbbells, kettlebells and bands.
        Home or Away on Today for workouts on the road, flipped by hand or automatically when you are far from home, and shared with MealStack if it is on the phone. A Home Screen widget, and badges that grow with you over years, not just the first week.
        Apple Health fills in your weigh-in, and can take each workout as strength training. Your whole log exports in one file, in a documented format, any time.
      </p>
    </section>

    <hr class="dashed" />

    {/* ---------- SIDE BY SIDE ---------- */}
    <section class="block" id="compare">
      <p class="section-label">Side by side</p>
      <h2 class="section-h2">Next to the app you use now.</h2>
      <p class="prose">Written against Hevy's and Strong's free tiers as of September 2026, and Hevy Coach as of October 2026. If a line is wrong, tell me and it changes.</p>
      <div class="versus" aria-label="IronStack compared with other apps">
        <div class="vh"><span></span><span>Other apps</span><span>IronStack</span></div>
        {versus.map((v) => (
          <div class:list={['vr', v.honest && 'honest']}><span class="vk">{v.k}</span><span>{v.them}</span><span>{v.us}</span></div>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- FINE PRINT ---------- */}
    <section class="block" id="fine-print">
      <p class="section-label">The fine print, in plain words</p>
      <h2 class="section-h2">Your data, and one thing I have not picked.</h2>
      <div class="lic three">
        <div class="lic-cell">
          <p class="k">The code</p>
          <p class="v">Closed app. Open data.</p>
          <p class="body">IronStack is a closed-source app from Mission Built. What is open is your data: everything you log exports in one file in the Mission Built Schema, a documented, versioned format, and imports back in. The IronStack name and the marks stay with Mission Built.</p>
        </div>
        <div class="lic-cell">
          <p class="k">Price</p>
          <p class="v">Not settled yet. Here is why.</p>
          <p class="body">Every Stack AI question runs on a server I pay for. I want Stack AI in the app and I am not willing to lose money keeping it there, so the launch price is open: free with Stack AI on an allowance, a one-time price, or Stack AI as the paid part of a free app. What is settled: logging, the clock, your whole history and Social will not be what you pay for.</p>
        </div>
        <div class="lic-cell" id="your-data">
          <p class="k">Your data</p>
          <p class="v">On your phone. Yours to take.</p>
          <p class="body">Your log is files on your phone, and one tap exports all of it in the Mission Built Schema, a documented, versioned format. Stack AI is off until you turn it on, and Stack AI and Social send only what they need to work. One screen deletes everything, everywhere, and tells you what it deleted. <a class="inline-link" href="/rack/ironstack/privacy">The privacy page</a> says exactly what, where and for how long.</p>
        </div>
      </div>
      <div class="fine">
        <p class="k">Not a doctor. Not your programmer.</p>
        <p>I am not a coach or a clinician, and nothing on this page or in the app is advice about how you should train. IronStack is how I log my own. Stack AI is an AI and can be wrong: it gives a starting weight under a ceiling it can show you, a cue from your own notes, or an alternative when the rack is taken. It writes down the program you send it and never makes one up, and any question about pain or injury gets pointed to a qualified person.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- JOIN THE BETA ---------- */}
    <section class="install-block" id="beta">
      <p class="section-label">Join the beta</p>
      <h2 class="section-h2">Private beta, on iPhone.</h2>
      <div class="status-panel">
        <div class="status-copy">
          <h3>On TestFlight now, with outside testers</h3>
          {build && <p class="build-line">Newest build: <a class="inline-link" href={releaseUrl(build)}>IronStack {build.data.version}</a> · {when(build.data, true)}</p>}
          <p>IronStack logs every workout I do, and a small group of outside testers is on it with me. New testers come in small batches, added by hand from the email on your Apple ID, and I would especially like people coming from Hevy or Strong, and training partners who want to try Social together.</p>
          <p>You get an email from TestFlight, Apple's own app for trying apps before they reach the App Store: install TestFlight, tap the link, and IronStack installs like any other app. Keep Hevy or Strong on your phone the whole time. The address is used for the invite and nothing else.</p>
          <p>Training with someone? Sign up together and put their name in the note, and I will add you in the same batch.</p>
          <form class="beta-form" id="beta-form" method="post" action="/api/beta" novalidate>
            <label class="field">
              <span class="field-k">Apple ID email</span>
              <input type="email" name="email" id="beta-email" required autocomplete="email" inputmode="email" placeholder="the address on your Apple ID" maxlength="254" />
            </label>
            <label class="field">
              <span class="field-k">What do you log in now? <em>optional</em></span>
              <input type="text" name="note" id="beta-note" autocomplete="off" placeholder="Hevy, Strong, a notebook · signing up with my partner" maxlength="200" />
            </label>
            <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <input type="hidden" name="t" id="beta-t" value="" />
            <input type="hidden" name="page" value="/rack/ironstack" />
            <div class="form-row">
              <button class="cta" type="submit" id="beta-submit">Join the beta →</button>
              <p class="cta-note" id="beta-status" role="status" aria-live="polite">Free during the beta · iPhone, iOS 26 and up · 18 and over · keep your app</p>
            </div>
          </form>
          <p class="cta-note" id="beta-fallback" hidden>The form is not taking names right now. Email <a href={MAILTO}>support@missionbuilt.io</a> with the address on your Apple ID and I will add you by hand.</p>
        </div>
        <div class="doors">
          <div class="door open"><div><div class="n">Beta</div><p class="d">By invite, from the form. Small batches, added by hand.</p></div><span class="s">Now</span></div>
          <div class="door dim"><div><div class="n">App Store</div><p class="d">The public door, published by Mission Built.</p></div><span class="s">After the beta</span></div>
        </div>
      </div>
    </section>

