<script>
  // ── The voice card: the app's own examples (Voice/VoiceExamples.swift) ──
  const chips = document.querySelectorAll<HTMLButtonElement>('#voice .chip');
  const vParse = document.getElementById('v-parse');
  const vMeans = document.getElementById('v-means');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.classList.toggle('on', x === c));
    if (vParse) vParse.textContent = c.dataset.parse || '';
    if (vMeans) vMeans.textContent = c.dataset.means || '';
  }));

  // ── The rest clock: the app's stages (Views/IntervalTimer.swift) ──
  // 10 to 4 seconds left: oxblood numerals and a wash. 3 to 1: solid panel, beating.
  const LEN = 20;
  const box = document.getElementById('clockdemo');
  const tEl = document.getElementById('cd-time');
  const bar = document.getElementById('cd-bar') as HTMLElement | null;
  const note = document.getElementById('cd-note');
  const go = document.getElementById('cd-go') as HTMLButtonElement | null;
  let timer: number | undefined;
  function show(left: number): void {
    if (!box || !tEl || !bar) return;
    tEl.textContent = '0:' + String(left).padStart(2, '0');
    bar.style.width = ((LEN - left) / LEN * 100) + '%';
    box.classList.toggle('closing', left <= 10 && left > 3);
    box.classList.toggle('final', left <= 3 && left > 0);
  }
  if (go) go.addEventListener('click', () => {
    if (timer) window.clearInterval(timer);
    let left = LEN;
    show(left);
    if (note) note.textContent = 'Rest started itself when the set landed.';
    go.textContent = 'Restart';
    timer = window.setInterval(() => {
      left -= 1;
      show(Math.max(left, 0));
      if (left === 10 && note) note.textContent = 'Ten seconds. In the gym, your earbuds heard "Thirty seconds" twenty seconds ago.';
      if (left === 3 && note) note.textContent = 'Three. At zero it says "Get to work".';
      if (left <= 0) {
        window.clearInterval(timer);
        timer = undefined;
        if (tEl) tEl.textContent = 'Go';
        box?.classList.remove('closing', 'final');
        if (note) note.textContent = 'Next set: Bench Press 205x5. Say it when it is done.';
      }
    }, 1000);
  });

  // ── Join the beta (same endpoint and behaviour as MealStack's form) ──
  const form = document.getElementById('beta-form') as HTMLFormElement | null;
  const status = document.getElementById('beta-status');
  const fallback = document.getElementById('beta-fallback');
  const tField = document.getElementById('beta-t') as HTMLInputElement | null;
  const submit = document.getElementById('beta-submit') as HTMLButtonElement | null;
  if (tField) tField.value = String(Date.now());
  function say(msg: string, tone: 'ok' | 'err' | ''): void {
    if (!status) return;
    status.textContent = msg;
    status.className = 'cta-note' + (tone ? ' ' + tone : '');
  }
  const params = new URLSearchParams(location.search);
  if (params.get('beta') === 'ok') say('You are on the list. Watch for an email from Apple; it can take a few days.', 'ok');
  if (params.get('beta') === 'err') say('That did not go through. Check the address and try again.', 'err');
  if (form && submit) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('beta-email') as HTMLInputElement).value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { say('That does not look like an email address.', 'err'); return; }
      submit.disabled = true;
      say('Adding you…', '');
      try {
        const res = await fetch('/api/beta', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form).entries())) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { say('You are on the list. Watch for an email from Apple; it can take a few days.', 'ok'); form.reset(); if (tField) tField.value = String(Date.now()); }
        else if (res.status === 503 || data.fallback) { if (fallback) fallback.hidden = false; say('', ''); }
        else if (res.status === 429) { say('Too many tries from here. Give it an hour.', 'err'); }
        else { say(data.error || 'That did not go through. Check the address and try again.', 'err'); }
      } catch { if (fallback) fallback.hidden = false; say('', ''); }
      finally { submit.disabled = false; }
    });
  }
</script>

