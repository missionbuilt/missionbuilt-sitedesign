---
/**
 * MissionStack (/rack/missionstack): the rebuild (Mike 2026-10-16 08:27 fix 11, 08:30 name cleared,
 * 08:32 less is more). A real product page: planning on iPad and Mac, the gym board, starter
 * programs and meal planning (both Coming soon), and how it works with IronStack and MealStack.
 * One idea per screen (hq/briefs/site/apple-duo-reference.md). Tagline: "MissionStack by Mission
 * Built". The product lead's MissionStack brief lands today; this is the first cut to it.
 *
 * Only what's in 0.1.0 is said as live. Said once, plainly (the panel 10-16): one lifter on the
 * board at a time, each lifter logs on an iPhone with IronStack, and a plan made on the iPad stays
 * there for now. COPY strings are drafts for Mike's yes.
 */
import ProductPage from '../../components/ProductPage.astro';
import BetaForm from '../../components/BetaForm.astro';
import { STACK } from '../../data/apps';
import { MISSIONSTACK_ANNOUNCED } from '../../data/missionstack-gate.mjs';

const IMG = '/images/missionstack/';
const pad = (f: string, alt: string) => ({ kind: 'tablet' as const, shot: { src: `${IMG}${f}.webp`, w: 1080, h: 751, alt } });
const [iron, meal] = STACK;

const description = 'MissionStack by Mission Built: plan your training on iPad or Mac, and put your live IronStack workout on the gym TV, an iPad or a Mac, big enough to read from the platform. No account. In a private beta; on the App Store January 1.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MissionStack',
  url: 'https://missionbuilt.io/rack/missionstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iPadOS 26, macOS 26, tvOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built LLC', url: 'https://missionbuilt.io' },
};
---
<ProductPage
  title="MissionStack: plan on iPad and Mac, lift on the big screen · Mission Built"
  description={description}
  ogImageAlt="MissionStack by Mission Built: your workout on the big screen."
  ld={ld}
  noindex={!MISSIONSTACK_ANNOUNCED}
  name="MissionStack"
  icon={STACK[2].icon}
  line="Your workout on the big screen."
  sub="Plan the weeks on your iPad or Mac. Put the live workout on the gym TV."
  hero={[
    { kind: 'tv', shot: { src: `${IMG}board-tv.webp`, w: 960, h: 540, alt: 'The MissionStack board on an Apple TV mid-workout: Lower A, Romanian deadlift 3 × 8, a 1:38 rest clock, then set 3; two sets of 245 × 8 done.' } },
  ]}
  cta={{ label: 'Join the beta', href: '#join' }}
  ctaNote="The gym board is free in MissionStack."
  chapters={[
    { title: 'Read it from the platform.', line: 'Your set, the load and the rest clock, big enough to read across the gym. You log on your iPhone or Apple Watch; the board shows it. One lifter at a time today.',
      devices: [pad('board-ipad', 'The board on an iPad mid-workout: Romanian deadlift 3 × 8, a 1:38 rest clock, two sets of 245 × 8 done and the third ready.')] },
    { title: 'Pair in one scan.', line: 'Scan the code with your iPhone\'s camera and your workout is on the board. Same Wi-Fi, no account.',
      devices: [pad('pair-ipad', 'The pairing card on the board: Scan with your iPhone camera, over a QR code, with Remember this iPhone.')] },
    { title: 'Plan the week.', line: 'Lay out the whole week on an iPad or a Mac. Drag workouts between days, make a superset, swap a lift, repeat a week.',
      devices: [{ kind: 'tablet', shot: { src: `${IMG}plan-week@2x.webp`, w: 1080, h: 751, alt: 'Plan on an iPad: a week of workouts down the side, with recovery days, and Monday\'s exercises with their sets, loads and effort.' } }] },
    { title: 'Type it like you say it.', line: 'Type "front squat 3x5 @7" and the sets, reps and effort fill in.',
      devices: [pad('plan-ipad', 'Plan on an iPad: Front squat just added from the typed line "front squat 3x5 @7", with 3 sets of 5 at an effort of 7 filled in.')] },
    { title: 'Stacked.', line: 'Finish and the board shows your time, your volume and any record you set.',
      devices: [pad('stacked-ipad', 'The board at the end of a workout: Stacked. Lower A, 52:14, 31 of 31 sets, 48,015 lb, and a rep record on back squat, 275 × 6.')] },
    { soon: true, title: 'Plan here, lift from your phone.', line: 'A week planned on the iPad or Mac, waiting on your iPhone. For now a plan stays where you made it.', devices: [] },
    { soon: true, title: 'Starter programs.', line: 'Start from a program with every week written out, then make it yours.',
      devices: [{ kind: 'tablet', shot: { src: `${IMG}starter-page-ipad@2x.webp`, w: 1080, h: 751, alt: 'A starter program\'s page on an iPad: 3 days a week for 8 weeks, with About this program and Use this program.' } }] },
    { soon: true, title: 'Meals on the big screen.', line: 'Plan the week\'s meals beside the week\'s training, with MealStack.', devices: [] },
  ]}
  family={{ title: 'Better as a stack.', items: [
    { name: iron.name, line: 'Each lifter logs on an iPhone with IronStack. The board shows what they log.', href: iron.href, icon: iron.icon },
    { name: meal.name, line: 'Times your meals around the workouts you plan.', href: meal.href, icon: meal.icon },
  ] }}
  promise={{ title: 'Nothing to sign up for.', line: 'No account. The board talks to your iPhone over your own Wi-Fi, encrypted, and keeps nothing.', href: '/rack/missionstack/privacy' }}
  closer={{ title: 'Plan it. Put it up. Lift it.', line: 'On iPad (iPadOS 26), a Mac with Apple silicon (macOS 26) and Apple TV (tvOS 26). The board needs IronStack on your iPhone.' }}
  more={[
    { label: 'Details', href: '/rack/missionstack/details' },
    { label: 'Privacy', href: '/rack/missionstack/privacy' },
    { label: 'Release notes', href: '/rack/missionstack/changelog' },
    { label: 'Support', href: '/rack/support' },
  ]}
>
  <BetaForm slot="join" page="/rack/missionstack" name="MissionStack" noteLabel="What screen is in your gym?" notePlaceholder="a TV on the wall · an iPad on the rack" />
  <p slot="after" class="first-alt">The invite brings IronStack's beta too. Not ready for a beta? <a href="/first">Get the App Store link first</a>.</p>
</ProductPage>

<style>
  .first-alt { margin: 18px auto 0; max-width: 46ch; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .first-alt a { color: var(--color-chalk); border-bottom: 1px solid var(--color-chalk-ghost); }
</style>
