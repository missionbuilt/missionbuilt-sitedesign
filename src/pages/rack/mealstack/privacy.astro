---
/**
 * MealStack — privacy.
 *
 * The page App Store Connect points at and the app's About screen links to. Written
 * from the code, not from a template: what stays on the phone, what leaves it, who
 * touches it, how long it lasts, how to make it go away. Apple's App Review
 * Guidelines 5.1.1(i) want three things said plainly (what is collected and every
 * use; that third parties protect it at least as well; retention, deletion and how
 * consent is withdrawn), 5.1.2(i) wants third-party AI disclosed with permission
 * asked first, and 5.1.3 wants the specific health data named and never marketed.
 * All of that is here, in the order a person would ask. Rewritten Sept 29, 2026 for
 * 0.9.1 (Health read, calendar, automatic travel, the IronStack shelf, Stack AI files and
 * web search), updated Sept 30, 2026 for Stack AI's permission screen, and Oct 3, 2026 when PostHog was
 * removed (usage data now stays in Mission Built's own record on Cloudflare) and for the
 * fueling summary IronStack's Coach mode can send (fueling-summary-mealstack.json). The Stack AI
 * cell says what that screen says, in the same order. /loadout/mealstack/privacy renders this page too. Draft for review by a
 * lawyer before public launch. MealStack is 18+.
 *
 * Color discipline: oxblood for the hero period, section labels and the one
 * emphasised word. No army green on this page.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TopNav from '../../../components/TopNav.astro';

const EFFECTIVE = 'October 10, 2026';
const ASK = 'mailto:support@missionbuilt.io?subject=MealStack%20data%20request';

const stats = [
  { key: 'Account',            value: 'None' },
  { key: 'Your plan and log',  value: 'On your phone' },
  { key: 'Leaves the phone',   value: 'Stack AI. Usage data if you say yes.' },
  { key: 'Sold or advertised', value: 'Never' },
];

type Party = { who: string; role: string; what: string; where: string };
const parties: Party[] = [
  { who: 'Cloudflare', role: 'Runs the Stack AI server', what: 'Sees each Stack AI request in transit and keeps the device record, the allowance counters, an answer for 10 minutes in case your connection drops, and the ninety-day accounting record. Discards your IP address.', where: 'Global edge, US account' },
  { who: 'Anthropic', role: 'Runs the Claude model behind Stack AI', what: 'Receives what the app sends when you ask Stack AI something, after you turn Stack AI on, and produces the answer; runs the web searches Stack AI writes from your question. Deletes it within 30 days and does not train its models on it; keeps it longer (up to 2 years) only if a request is flagged for breaking its usage policy. Stack AI is an AI and can be wrong; it isn\'t medical advice. Handles it under its Data Processing Addendum.', where: 'United States' },
  { who: 'Apple', role: 'Health, TestFlight, the App Store', what: 'Health receives the macros of meals you log, and gives the app food from other apps and your weight, each only if you allow it. Apple\'s own privacy terms cover TestFlight and the App Store.', where: 'Per Apple' },
];

type Keep = { what: string; how: string };
const keeps: Keep[] = [
  { what: 'Your plan, logs, ingredients, meals, stacks, About you', how: 'On your phone until you delete them, or delete the app. Included in your iPhone backup like any other app data.' },
  { what: 'Your Stack AI chats', how: 'On your phone until you delete them. Not synced anywhere.' },
  { what: 'What you send Stack AI, including photos and files', how: 'Mission Built never keeps what you said. The answer is held on the server for 10 minutes in case your connection drops, then deleted. Anthropic deletes what you sent within 30 days and doesn\'t train its models on it. It keeps it longer (up to 2 years) only if a request is flagged for breaking its usage policy.' },
  { what: 'The device record (App Attest key id, public key, receipt, timestamps)', how: 'Kept while the install exists. Removed the moment you delete your data in the app, or on request.' },
  { what: 'Stack AI allowance counters', how: 'Wiped at the start of each month.' },
  { what: 'Accounting record of Stack AI use (Cloudflare)', how: 'About ninety days, then gone.' },
  { what: 'Usage data', how: 'In Mission Built\'s own record on Cloudflare, about ninety days, then gone. Deleting your data in the app doesn\'t remove them sooner, but nothing in them can be matched to you once the install\'s key is gone.' },
];
---
<BaseLayout
  canonical="/rack/mealstack/privacy/"
  title="Privacy · MealStack · Mission Built"
  description="What MealStack keeps on your phone, what leaves it, who touches it, how long it lasts, and how to make it all go away."
  active="rack"
  ogImage="/images/mealstack/og.jpg"
  ogImageAlt="MealStack. Fueling is training. Meal timing for iPhone, by Mission Built, with a real screen of Today on a training day."
>
  <TopNav active="rack" />

  <main id="main" class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/rack">The Rack</a>
      <span aria-hidden="true"> / </span>
      <a href="/rack/mealstack">MealStack</a>
      <span aria-hidden="true"> / </span>
      <span class="here">Privacy</span>
    </nav>

    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>MealStack</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>
      <h1 class="display"><span>Privacy</span><span class="dot">.</span></h1>
      <p class="subtitle">
        <span class="line1">What the app keeps, what leaves your phone, and how to make it all go away.</span>
        <span class="line2">Short, because there is not much to tell.</span>
      </p>
      <p class="effective">Effective {EFFECTIVE} · Mission Built · Mike Nichols · Pittsburgh, PA</p>
    </section>

    <section class="meta-strip" aria-label="MealStack privacy at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          <div class="stat-value">{s.value}</div>
        </div>
      ))}
    </section>

    {/* ---------- WHO ---------- */}
    <section class="block">
      <p class="section-label">Who this is</p>
      <h2 class="section-h2">Mission Built makes MealStack. This page is the whole policy.</h2>
      <div class="prose-block">
        <p>MealStack is made by Mission Built, which is Mike Nichols, in Pittsburgh, Pennsylvania. For the purposes of privacy law, Mission Built is the controller of whatever this page says leaves your phone. There is no parent company, no subsidiary and no partner with access to your data. The app is not open source; this page is where to read what it does with your data, and the What the server holds screen shows you the rest, live.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- NO ACCOUNT ---------- */}
    <section class="block">
      <p class="section-label">No account</p>
      <h2 class="section-h2">The app never asks who you are.</h2>
      <div class="prose-block">
        <p>MealStack has no sign-up, no login and no password. Nothing you do in the app is tied to your name, email address or phone number, because the app never asks for them. The only identity the server ever sees is a key your phone creates in its secure hardware, which proves a request came from a real copy of MealStack and nothing more.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- ON YOUR PHONE ---------- */}
    <section class="block">
      <p class="section-label">On your phone</p>
      <h2 class="section-h2">Everything you put in stays in files on the phone.</h2>
      <div class="prose-block">
        <p>Your plan, every day's log, the ingredients you add, the meals and stacks you save, your Stack AI chats, and what you enter in About you: bodyweight, height, age, sex if you chose to say, how you train, and your goal. All of it lives in files inside the app's own container on your iPhone, written under the phone's encryption and protected until the first unlock after a restart. Those files are included in your iCloud or computer backup the way any app's data is; Mission Built has no access to your backups.</p>
        <p><strong>Apple Health, each way behind its own switch.</strong> With <em>Write the meals you log</em> on, the app writes four numbers for each meal you log into Apple Health, at the time you ate: protein, carbohydrates, fat and calories. Correct or un-log the meal and the app takes those entries back out. With <em>Read food and weight from other apps</em> on, the app reads two things: the food other apps logged today (calories, protein, carbohydrates and fat, and which app logged them), shown beside your totals and never added to them; and your latest weight, read when the app opens and offered on Today and in About you when it is newer than the weight in About you and differs by half a kilo or more. It is never put into About you unless you tap Use it. If you tap Not now, the app keeps that one weigh-in (its weight and date) in a file on your phone so it isn't offered again. MealStack's own entries are left out of what it reads. What it reads stays on the phone. If you put your weight in About you, it goes to Anthropic with every Stack AI request, like everything else in About you, once you have turned Stack AI on. Nothing from Health is used for marketing, advertising or anything but these screens. Both switches are in Settings › Apple Health, and in the Health app.</p>
        <p><strong>Your calendar, only if you ask.</strong> <em>Check my calendar</em> is off until you turn it on. On, the app reads today's events on the phone so it can offer to move a meal that lands in one. It never changes your calendar, keeps the events only while the app is open, and never sends them anywhere, Stack AI included. If you accept a move, the new meal time is part of your plan like any other.</p>
        <p><strong>Location, only for automatic travel.</strong> <em>Set travel automatically</em> is off until you turn it on. On, the app asks for your location, remembers where home is, rounded to about a kilometre, and turns Travel on when the phone is more than 100 km from there and off when you are back. The home area and the check stay on the phone; no location is sent anywhere. Turning the switch off stops the watching; <em>Forget home</em> erases the home area.</p>
        <p><strong>IronStack, if it is on the same phone.</strong> The two apps share a private shelf on your phone that only Mission Built apps can open. MealStack puts there the travel switch (and your rounded home area if you use automatic travel), today's session time when you move it, and, with <em>IronStack times my after-session meals</em> on, the name and contents of the first thing after the session, so IronStack can call it when you finish. It reads the same from IronStack, plus when your workout started and how long it ran, and a note that IronStack is installed and when it was last used, for the Double Stacked badges. Neither app moves anything in the other without asking, and nothing crosses to a server to do this.</p>
        <p id="fueling-summary"><strong>Your fueling summary, for IronStack's Coach mode.</strong> On the same shelf, MealStack keeps a short summary of each of your last 120 days: how many meals went in on time (4 of 5), how many minutes early or late the meal before your session and the shake after it were, your protein, carbohydrates, fat and calories as a percentage of your target, and whether it was a recovery day. Beyond the names of those two meals as they appear on your day, no foods and no amounts. Only IronStack on the same phone can read it, and it stays on the phone unless you link a coach in IronStack and switch Fueling on in Coach mode's consent screen (it is off until you do). Then IronStack sends it with your workouts to your coach through Mission Built's server, as <a href="/rack/ironstack/privacy#coach-mode">IronStack's privacy page</a> describes, and ending the link deletes your coach's copy. Delete all MealStack data removes the summary from the shelf.</p>
        <p class="note" id="health-data">This section also serves as the consumer health data notice some states require. The health data involved: the four nutrition figures the app writes to Health with your permission; the food totals from other apps and the weight it reads from Health with your permission; the body measurements you enter in About you; and what you log. Source: you and Apple Health. Purpose: the log, the day, the target, and Stack AI when you turn it on and ask it. Shared with: nobody, except what goes to Anthropic for Stack AI, only after you turn Stack AI on and then only when you ask it something, as described next; and your fueling summary, only if you switch Fueling on in IronStack's Coach mode, to the coach you linked there.</p>
        <p class="note"><strong>Consent and withdrawal.</strong> Nothing in this notice is read or shared until you allow it: the Health switches in Settings › Apple Health, and Stack AI only after you turn it on, and then only when you ask. Stack AI is off until you turn it on from its permission screen; Settings › Stack AI turns it off. Turning either off withdraws your consent from then on. Delete all MealStack data removes what is on your phone, the entries it wrote to Health, and the server's device record and counters (if the phone is offline, the next time it opens with a connection); usage data and the accounting record of Stack AI use expire in about ninety days. Your rights under Washington's My Health My Data Act and similar laws (to confirm, access, delete and withdraw consent) are the ones in Your rights below, at the same address. Mission Built does not sell consumer health data.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- WHAT LEAVES ---------- */}
    <section class="block">
      <p class="section-label">What leaves your phone</p>
      <h2 class="section-h2">Two things, and you decide both.</h2>

      <div class="two">
        <div class="cell">
          <p class="k">Stack AI</p>
          <p class="v">Off until you turn it on. Then only when you ask.</p>
          <p class="body">Stack AI is the one part of the app that talks to a server, and it is off until you turn it on. The first time you open it, the app shows a permission screen that names Anthropic, says what goes to it, asks you to confirm you are 18 or older, and asks first. Nothing goes to Anthropic until you turn Stack AI on, and then only when you ask it something. That yes is the permission this section describes. Turn it off any time in Settings › Stack AI; off, it sends nothing.</p>
          <p class="body"><strong>Sent to Anthropic, only when you ask:</strong></p>
          <ul class="list">
            <li>Your question and this chat</li>
            <li>Your plan and your day: meals, times, what you've eaten, targets, training days and your pantry</li>
            <li>What you entered in About you: weight, height, age, sex, activity and goal</li>
            <li>Photos (up to 5) with location removed, and PDFs and files you attach, with their names</li>
            <li>Links you paste: Mission Built's server opens the page and sends its text</li>
            <li>Web searches Stack AI runs through Anthropic, written from your question</li>
          </ul>
          <p class="body"><strong>Never sent:</strong> your name, email, Apple ID, location, contacts, or your calendar.</p>
          <p class="body">It goes to Mission Built's server at mealstack-ai.missionbuilt.io (earlier builds use coach.missionbuilt.io until they update; it is the same server code), which runs on Cloudflare. The server passes it to Anthropic's Claude model, checks every suggestion the model makes, and sends the answer back. Web searches are written by Stack AI from your question and run through Anthropic.</p>
          <p class="body"><strong>What happens to it.</strong> Anthropic deletes it within 30 days and doesn't train its models on it. It keeps it longer (up to 2 years) only if a request is flagged for breaking its usage policy. Mission Built keeps a cost count for your phone, never what you said. An answer is held for 10 minutes in case your connection drops, then deleted. Your chats stay on your phone until you delete them; they are not synced anywhere. Stack AI can be wrong. It isn't medical or nutrition advice. If you ask it to build a new plan, it builds it from the same plan, targets and pantry listed above, and it opens as a preview; nothing changes until you bring it in.</p>
          <p class="body">To run Stack AI without accounts, the server keeps one small device record per install, for the allowance: the App Attest key id and the public half of the key your phone created, the receipt Apple issued for it, when it registered and was last seen, and a count of how many Stack AI requests that install has made today and this month and roughly what they cost. It identifies the install, not you, never holds your name, and a reinstall creates a new one.</p>
        </div>
        <div class="cell">
          <p class="k">Usage data</p>
          <p class="v">Counts and timings, only if you say yes.</p>
          <p class="body">Once your plan is built, the app asks once whether you want to send usage data. Say no and nothing is sent. Say yes and the app sends Mission Built counts and timings: which tabs get used and for how long, when meals get logged against the plan and how, whether ingredients, meals or stacks get added, how Stack AI gets used and what it cost, and the app and iOS version. It never sends food names, anything from Health, your location or your IP address; the server discards the address and never looks it up. Your time zone name is included so the days line up.</p>
          <p class="body">The data is keyed to a hash of the same install key and stays with Mission Built, in its own record on Cloudflare, for about ninety days. Mission Built uses it for two things: accounting for the Stack AI allowance, and deciding what to build next. It is never sent to an analytics company or anyone else. Turn the switch off in Settings and nothing more is sent.</p>
        </div>
      </div>

      <div class="fine">
        <p class="k">Nothing else</p>
        <p>Meal alerts are scheduled on the phone, and the widgets and Lock Screen read the same files the app does; none of them sends anything anywhere. No advertising identifiers, no third-party software kits on the phone, no tracking in Apple's sense of the word, no selling, no sharing for anyone else's marketing. The App Store privacy label says the same, and <strong>Settings › Your data › What leaves the phone</strong> lists every kind of event the app can send.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- WHO TOUCHES IT ---------- */}
    <section class="block">
      <p class="section-label">Who touches it</p>
      <h2 class="section-h2">Three companies, each for one job.</h2>
      <p class="prose">Each of them is bound by its own terms and, where it processes data for Mission Built, by a data processing agreement, to protect your data at least as well as this page promises. None of them may use it for their own marketing.</p>
      <div class="parties">
        <div class="ph"><span>Who</span><span>Job</span><span>What they see</span><span>Where</span></div>
        {parties.map((p) => (
          <div class="pr">
            <span class="pk">{p.who}</span>
            <span class="role">{p.role}</span>
            <span>{p.what}</span>
            <span class="where">{p.where}</span>
          </div>
        ))}
      </div>
      <p class="note">Menu links: if you give Stack AI a link to a restaurant menu, Mission Built's server fetches that page (your phone never does), reduces it to text, and keeps the text for one day so the same link is not fetched twice. The restaurant sees a request from Cloudflare, not from you.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- HOW LONG ---------- */}
    <section class="block">
      <p class="section-label">How long</p>
      <h2 class="section-h2">What is kept, and for how long.</h2>
      <div class="keeps">
        {keeps.map((k) => (
          <div class="kr">
            <span class="kk">{k.what}</span>
            <span>{k.how}</span>
          </div>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- DELETE ---------- */}
    <section class="block">
      <p class="section-label">Seeing and deleting your data</p>
      <h2 class="section-h2">Two buttons on the phone. No email needed.</h2>
      <div class="prose-block">
        <p><strong>Settings › Stack AI › What the server holds</strong> asks the server, live, for everything it keeps for your install and shows it to you, with a share button. The request is signed by your phone's key, so the server can only ever answer for the install that asked.</p>
        <p><strong>Settings › Start over › Delete all MealStack data</strong> does the whole job in one tap: it tells the server to delete the install's device record and its allowance counters (usage events can't be deleted one install at a time: they hold only a hash of the install's key and expire in about ninety days), then removes every file on the phone, the entries this app wrote to Health, your answer to the usage question, and the install's key. If the phone is offline at that moment, the phone is still wiped and the server's record is deleted the next time the app opens with a connection. If the server can't confirm the install, the key is dropped and the record expires 400 days after it was last used. Turning off Send usage data in Settings withdraws that consent from then on; turning off Stack AI in Settings › Stack AI stops it from sending anything.</p>
        <p>The one case a button cannot cover is an app that was deleted before asking: with the key gone, nothing on the server can be matched to you, which also means nothing on the server can identify you. If you want to ask anyway, or ask anything else about your data, email <a href={ASK}>support@missionbuilt.io</a>. Mission Built will confirm within ten days and finish within thirty.</p>
        <p class="note">The routes behind those two buttons are tested for isolation on every change to the server (an install can never read or delete another's) and probed every hour in production by two synthetic installs; if a probe ever fails, both routes close until a person has looked.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- RIGHTS ---------- */}
    <section class="block">
      <p class="section-label">Your rights</p>
      <h2 class="section-h2">Wherever you are, the same answer.</h2>
      <div class="prose-block">
        <p>You can ask what Mission Built holds that relates to your install, ask for it to be corrected or deleted, ask for a copy, object to or restrict its use, and withdraw any consent you gave, all at the address above, and you will not be treated differently for asking. Under the GDPR, the legal bases are your explicit consent for anything involving health data (Stack AI, Apple Health), your consent for the usage-data question, and Mission Built's legitimate interest in running the Stack AI allowance and keeping the service from being abused. Mission Built has not appointed an EU or UK representative; write to the address above. If you are in the EU, the EEA or the UK you may also complain to your supervisory authority. Under California law, Mission Built does not sell or share personal information and has not done so in the past twelve months.</p>
        <p>Mission Built operates from the United States and the companies above process data there, so anything that leaves your phone leaves your country if you are outside the US. Cloudflare and Anthropic each rely on recognised transfer mechanisms such as standard contractual clauses or the EU–US Data Privacy Framework for that.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- STACK AI, CHILDREN ---------- */}
    <section class="block">
      <div class="two">
        <div class="cell">
          <p class="k">Stack AI is not a clinician</p>
          <p class="body">Stack AI can be wrong, and it isn't medical or nutrition advice. It gives general nutrition information for healthy adults and its numbers are estimates. It is not a doctor or a dietitian, it declines medical questions, and it will not set targets for anyone under 18. Check with your physician before making decisions about your health, and treat what Stack AI says as a starting point, not an instruction.</p>
        </div>
        <div class="cell">
          <p class="k">Age</p>
          <p class="body">MealStack is for adults, 18 and over: it sets targets, plans cuts and reads your weight. It is not directed at anyone under 18 and does not knowingly collect anything from them, and Stack AI's permission screen asks you to confirm your age. If you believe someone under 18 has used the app, email the address above and the device record will be removed.</p>
        </div>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- CHANGES ---------- */}
    <section class="block">
      <p class="section-label">Changes</p>
      <h2 class="section-h2">This page changes when the app does.</h2>
      <div class="prose-block">
        <p>If what the app collects or shares changes, this page changes first, with a new effective date at the top, and the app's About screen points here. A change that widens what leaves your phone will be asked about in the app before it applies to you. Effective {EFFECTIVE}.</p>
      </div>
    </section>

  </main>
  <SiteFooter links={[{ label: 'Back to MealStack', href: '/rack/mealstack' }, { label: 'Terms', href: '/rack/mealstack/terms' }, { label: 'Support', href: '/rack/support' }]} />
</BaseLayout>

<style>
  .page { max-width: 1280px; margin: 0 auto; }

  .breadcrumb {
    padding: 18px var(--pad-page-x) 0;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-chalk-faint);
  }
  .breadcrumb a { color: var(--color-chalk-dim); transition: color 120ms ease-out; }
  .breadcrumb a:hover { color: var(--color-chalk); }
  .breadcrumb .here { color: var(--color-chalk-faint); }

  .hero { padding: 40px var(--pad-page-x) 28px; text-align: center; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 14px; margin: 0 0 18px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em;
    color: var(--color-chalk-dim); text-transform: uppercase;
  }
  .eyebrow .dots { letter-spacing: 0.04em; color: var(--color-blood-bright); }
  .display {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(56px, 11vw, 108px); line-height: 0.95; letter-spacing: -0.02em;
    color: var(--color-chalk); text-transform: uppercase;
  }
  .display .dot { color: var(--color-blood-bright); }
  .subtitle {
    margin: 22px auto 0; max-width: 820px; display: grid; gap: 8px;
    font-family: var(--font-display); font-weight: 400; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .subtitle .line1 { font-size: clamp(16px, 2.4vw, 24px); font-weight: 500; color: var(--color-chalk); }
  .subtitle .line2 { font-size: clamp(13px, 1.9vw, 19px); color: var(--color-chalk-dim); }
