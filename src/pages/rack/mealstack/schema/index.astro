---
/**
 * The MealStack Schema, overview. /rack/mealstack/schema
 *
 * Content from the app repo's docs/schema, via scripts/sync_mealstack_schema.py:
 * the field sets and fields (src/data/mealstack-schema.json, from the YAML), and
 * the README (src/data/mealstack-schema-readme.md). The field sets are an index of
 * cards; each has its own page (schema/[set].astro), so this page stays short.
 * The schema is below 1.0 and names can still change; the page says so. No
 * license is named: it is not decided.
 */
import ToolNoteLayout from '../../../../layouts/ToolNoteLayout.astro';
import schema from '../../../../data/mealstack-schema.json';
import { Content as Readme } from '../../../../data/mealstack-schema-readme.md';
import { SCHEMA, setUrl } from '../../../../data/schema';

const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;
---
<ToolNoteLayout
  title={`The MealStack Schema ${schema.version} · Mission Built`}
  description="One set of names for everything MealStack keeps, ingredients, meals, stacks, plans and days, in every place the data lives. Modeled on the Elastic Common Schema."
  crumbs={[{ label: 'MealStack', href: '/rack/mealstack' }, { label: 'Schema' }]}
  eyebrow={`The MealStack Schema ${schema.version}`}
  heading="One vocabulary"
  accent="vocabulary"
  standfirst="Ingredients make meals, meals make stacks. One set of names for all of it, in every place MealStack data lives: the app, the plan file, the skill, Coach and the telemetry."
  tool="mealstack"
  back={{ label: 'MealStack', href: '/rack/mealstack' }}
  footLinks={[{ label: 'Plan skill', href: '/rack/mealstack/skill' }, { label: 'Release notes', href: '/rack/mealstack/changelog' }, { label: 'Privacy', href: '/rack/mealstack/privacy' }]}
>
  <Fragment slot="byline">
    Version {schema.version} · {schema.fieldSets} field sets · {schema.fields} fields · Modeled on ECS
  </Fragment>

  <Fragment slot="lead">
    <p class="pre">Below 1.0, and still moving with the app: a release may rename a field. From 1.0, a rename is a major version.</p>
    <div class="get">
      <a class="dl-btn" href={schema.download} download>
        <span class="dl-ico" aria-hidden="true">↓</span>
        <span class="dl-text">
          <span class="dl-name">mealstack-schema-{schema.version}.json</span>
          <span class="dl-meta">Every field, one flat map · for tools and validators</span>
        </span>
      </a>
    </div>
  </Fragment>

  <section aria-labelledby="field-sets">
    <h2 class="rule" id="field-sets">Field sets</h2>
    <ol class="sets">
      {schema.sets.map((s) => (
        <li>
          <a class="set" href={setUrl(s.name)}>
            <span class="t">{s.title}</span>
            <span class="k">{s.root ? 'root' : `${s.name}.*`} · {plural(s.fields.length, 'field')}</span>
            <span class="d">{s.short}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="readme">
    <Readme />
  </div>
</ToolNoteLayout>

<style>
  .pre {
    margin: 22px 0 0; padding-left: 12px; border-left: 2px solid var(--color-army);
    font-family: var(--font-mono); font-size: 11px; line-height: 1.6; letter-spacing: 0.06em; color: var(--color-chalk-dim);
  }
  .get { margin-top: 20px; }
  .dl-btn {
    display: inline-flex; align-items: center; gap: 16px; padding: 16px 22px;
    background: var(--color-panel); border: var(--border-thin); border-left: 3px solid var(--color-blood);
    text-decoration: none; transition: background 120ms ease-out;
  }
  .dl-btn:hover { background: rgba(255,255,255,0.02); }
  .dl-ico { font-family: var(--font-mono); font-size: 18px; color: var(--color-blood); line-height: 1; }
  .dl-text { display: flex; flex-direction: column; gap: 4px; }
  .dl-name { font-family: var(--font-display); font-weight: 600; font-size: 16px; letter-spacing: 0.02em; color: var(--color-chalk); }
  .dl-meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-chalk-faint); }

  .sets { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: var(--border-thin); border-left: var(--border-thin); }
  .sets li { border-right: var(--border-thin); border-bottom: var(--border-thin); }
  .set { display: flex; flex-direction: column; gap: 5px; height: 100%; padding: 14px 16px; text-decoration: none; transition: background 120ms ease-out; }
  .set:hover { background: rgba(255,255,255,0.015); }
  .set .t { font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: 0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .set:hover .t { color: var(--color-blood); }
  .set .k { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--color-chalk-faint); }
  .set .d { font-family: var(--font-serif); font-size: 14px; line-height: 1.5; color: var(--color-chalk-dim); }

  .readme :global(h2) {
    margin: 46px 0 6px; padding-top: 18px; border-top: var(--border-thin);
    font-family: var(--font-display); font-weight: 600; font-size: 25px; line-height: 1.15; letter-spacing: 0.02em; text-transform: uppercase;
    color: var(--color-chalk);
  }
  .readme :global(h2 + p) { margin-top: 12px; }
  .readme > :global(p:first-child) { margin-top: 36px; }
  .readme :global(ul) { list-style: none; margin: 0 0 22px; padding: 0; }
  .readme :global(ul > li) { position: relative; padding-left: 20px; margin-bottom: 12px; font-size: 16px; }
  .readme :global(ul > li::before) { content: ""; position: absolute; left: 0; top: 11px; width: 9px; height: 2px; background: var(--color-blood); }
  .readme :global(table) {
    display: block; overflow-x: auto; margin: 0 0 22px; border-collapse: collapse;
    font-family: var(--font-serif); font-size: 13.5px; line-height: 1.5;
  }
  .readme :global(th) {
    text-align: left; padding: 8px 10px; border-bottom: var(--border-thin);
    font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-chalk-faint);
  }
  .readme :global(td) { vertical-align: top; padding: 10px; border-bottom: var(--border-thin); min-width: 160px; }
  .readme :global(td:first-child) { min-width: 120px; color: var(--color-chalk); }

  @media (max-width: 720px) {
    .dl-btn { display: flex; }
    .sets { grid-template-columns: 1fr; }
  }
</style>
