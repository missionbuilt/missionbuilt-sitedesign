---
/**
 * MealStack — release notes, the index. /rack/mealstack/changelog
 *
 * The app's About links here. One row per build, newest first: version and build, status,
 * how many changes, and the groups they fall in. The release testers have or are
 * about to get (the newest one submitted or shipped) also shows its highlights: each
 * group's first lines. Every build has its own page (changelog/[release].astro),
 * so this page stays short however many builds there are.
 *
 * A weekly update keeps the version and bumps the build, so one version can have
 * several rows: the next build (in progress) first, then its shipped builds by number.
 * Each row's anchor is its build (`#b86`, `#v0-9-1-next` for the one in progress);
 * the version's anchor (`#v0-9-1`, which the apps' About screens link to) sits on the
 * version's newest build only, the one testers can have (see versionHeads).
 * A build not yet shipped carries the page's one army-green micro-mark.
 */
import { getCollection } from 'astro:content';
import ToolNoteLayout from '../../../../layouts/ToolNoteLayout.astro';
import { longDate, isoDay } from '../../../../data/logs';
import { byOrder, releaseUrl, releaseAnchor, releaseLabel, versionHeads, versionSlug, when, plural, type Release } from '../../../../data/releases';

const releases = (await getCollection('releases', ({ data }) => data.app === 'mealstack')).sort(byOrder);
const latest = releases.find((r) => r.data.status === 'shipped');
const lastDated = releases.find((r) => r.data.date)?.data.date;
const featured = releases.find((r) => r.data.status !== 'in-progress');
const heads = new Set(versionHeads(releases).values());
const PER_GROUP = 3;
/** The row's status line: a build number is already beside the version, so a build
 *  with no date just says it shipped. */
const rowWhen = (r: Release) => (r.data.status === 'shipped' && r.data.build && !r.data.date ? 'Shipped' : when(r.data, true));
/** The row's build line under the version. */
const buildLine = (r: Release) => (r.data.status === 'in-progress' ? 'next build' : r.data.build ? `build ${r.data.build}` : '');
---
<ToolNoteLayout
  title="Release notes · MealStack · Mission Built"
  description="What changed in each MealStack build, written for the people testing it. Newest first."
  crumbs={[{ label: 'MealStack', href: '/rack/mealstack' }, { label: 'Release notes' }]}
  eyebrow="MealStack release notes"
  heading="What changed"
  accent="changed"
  standfirst="Every build that goes to TestFlight, in plain words. If you can see it or feel it in the app, it gets a line here before it ships."
  tool="mealstack"
  back={{ label: 'MealStack', href: '/rack/mealstack' }}
  footLinks={[{ label: 'Schema', href: '/rack/mealstack/schema' }, { label: 'Privacy', href: '/rack/mealstack/privacy' }]}
>
  <Fragment slot="byline">
    MealStack · Private beta{latest && <> · Latest {releaseLabel(latest.data)}</>}
    {lastDated && <> · Updated <time datetime={isoDay(lastDated)}>{longDate(lastDated)}</time></>}
  </Fragment>

  {featured && (
    <section class="featured" aria-labelledby="featured-h">
      <header class="f-head">
        <p class="f-k">{featured.data.status === 'shipped' ? 'Latest build' : 'Next build'}</p>
        <h2 id="featured-h"><a class="plain" href={releaseUrl(featured)}>{featured.data.version}</a></h2>
        <p class:list={['status', featured.data.status !== 'shipped' && 'next']}>{when(featured.data)}</p>
      </header>
      {featured.data.groups.map((g) => (
        <div class="f-group">
          {g.title && <h3><a class="plain" href={`${releaseUrl(featured)}#${g.slug}`}>{g.title}</a></h3>}
          <ul class="leads">
            {g.leads.slice(0, PER_GROUP).map((l) => <li>{l}</li>)}
          </ul>
          {g.leads.length > PER_GROUP && (
            <a class="more" href={`${releaseUrl(featured)}#${g.slug}`}>{plural(g.leads.length - PER_GROUP, 'more change')} →</a>
          )}
        </div>
      ))}
      <a class="read" href={releaseUrl(featured)}>Read all {plural(featured.data.changes, 'change')} in {releaseLabel(featured.data)} →</a>
    </section>
  )}

  <section class="all" aria-labelledby="all-h">
    <h2 id="all-h" class="rule">Every release</h2>
    <ol class="rows">
      {releases.map((r) => {
        const own = releaseAnchor(r);
        const version = `v${versionSlug(r.data.version)}`;
        const holdsVersion = heads.has(r) && own !== version;
        return (
        <li id={holdsVersion ? version : own}>
          <a href={releaseUrl(r)} class="row" id={holdsVersion ? own : undefined}>
            <span class="v">{r.data.version}{buildLine(r) && <><span class="sr-only"> · </span><span class="b">{buildLine(r)}</span></>}</span>
            <span class="mid">
              <span class:list={['w', r.data.status !== 'shipped' && 'next']}>{rowWhen(r)} · {plural(r.data.changes, 'change')}</span>
              {r.data.groups.some((g) => g.title) && (
                <span class="g">{r.data.groups.map((g) => g.title).filter(Boolean).join(' · ')}</span>
              )}
              {!r.data.groups.some((g) => g.title) && r.data.groups[0] && (
                <span class="g">{r.data.groups[0].leads[0]}</span>
              )}
            </span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        </li>
        );
      })}
    </ol>
    {releases.length === 0 && <p>Nothing here yet. The first notes land with the next build.</p>}
  </section>
</ToolNoteLayout>

<style>
  .featured { margin-top: 30px; padding: 20px 22px 22px; border: var(--border-thin); }
  .f-head { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; align-items: baseline; }
  .f-k { grid-column: 1 / -1; margin: 0 0 6px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .f-head h2 { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 34px; line-height: 1; letter-spacing: 0.02em; }
  .f-head h2 a { color: var(--color-chalk); text-decoration: none; }
  .status { margin: 0; justify-self: start; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .status.next { padding: 3px 7px; border: 1px solid var(--color-army); color: var(--color-army); }

  .f-group { margin-top: 20px; }
  .f-group h3 { margin: 0 0 8px; font-family: var(--font-display); font-weight: 500; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; }
  .f-group h3 a { color: var(--color-chalk); text-decoration: none; }
  .f-group h3 a:hover { color: var(--color-blood-text); }
  .leads { list-style: none; margin: 0; padding: 0; }
  .leads li { position: relative; padding-left: 18px; margin: 0 0 6px; font-size: 15px; line-height: 1.5; }
  .leads li::before { content: ""; position: absolute; left: 0; top: 10px; width: 8px; height: 2px; background: var(--color-blood); }
  .more, .read { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-chalk-dim); text-decoration: none; transition: color 120ms ease-out; }
  .more { display: inline-block; margin: 2px 0 0 18px; }
  .read { display: inline-block; margin-top: 22px; padding-top: 14px; border-top: var(--border-thin); width: 100%; color: var(--color-chalk); }
  .more:hover, .read:hover { color: var(--color-blood-text); }

  .rows { list-style: none; margin: 14px 0 0; padding: 0; border-top: var(--border-thin); }
  .rows li, .rows .row { scroll-margin-top: 24px; }
  .rows li { border-bottom: var(--border-thin); }
  .row { display: grid; grid-template-columns: 104px 1fr auto; gap: 14px; align-items: center; padding: 14px 4px; text-decoration: none; transition: background 120ms ease-out; }
  .row:hover { background: rgba(255,255,255,0.015); }
  .row .v { display: flex; flex-direction: column; gap: 2px; font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: 0.02em; color: var(--color-chalk); }
  .row .v .b { font-family: var(--font-mono); font-weight: 400; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .row .mid { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .row .w { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .row .w.next { color: var(--color-chalk-dim); }
  .row .g { font-family: var(--font-serif); font-size: 14px; line-height: 1.45; color: var(--color-chalk-dim); }
  .row .go { font-family: var(--font-mono); font-size: 14px; color: var(--color-chalk-faint); transition: color 120ms ease-out; }
  .row:hover .go { color: var(--color-blood-text); }

  @media (max-width: 720px) {
    .featured { padding: 18px 16px; }
    .row { grid-template-columns: 88px 1fr auto; }
    .row .v { font-size: 20px; }
  }
</style>
