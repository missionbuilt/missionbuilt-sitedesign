---
/**
 * /rack/plans: one row per app (Mike 2026-10-16 15:21 to 15:27; hq/inbox/marketing/2026-10-16-1525
 * and -1530). The Full Stack leads as the best deal (the page's one oxblood accent, a Best deal tag,
 * the three-icon mark). Then IronStack, MealStack and MissionStack, each on its own row reading free
 * to paid for that app only. Free is marked green only where it is truly free to use (IronStack
 * logging, the MissionStack gym board); MealStack's free tier is a small "Try free" tier and MealStack
 * Pro carries that row. Pro is the hero of its row: more weight, the payoff, the price slot.
 *
 * No prices (Mike 15:27). Every slot reads from src/data/plans.ts (PRICES, null today), whose
 * assertNoPrices() stops the build if a number slips in. noindex until Mike's yes. COPY strings are
 * drafts for Mike.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TopNav from '../../components/TopNav.astro';
import StackAIMark from '../../components/StackAIMark.astro';
import { STACK } from '../../data/apps';
import { rows, fullStack, principles, coach, priceText, FULL_STACK_SLOT, FULL_STACK_TOGETHER, PRICING_LINE, STACK_AI_LINE, assertNoPrices } from '../../data/plans';

assertNoPrices();
const icon = (key: string) => STACK.find((a) => a.key === key)!.icon;
---
<BaseLayout
  title="Plans for IronStack, MealStack and MissionStack · Mission Built"
  description="One row per app: IronStack Free and Pro, MealStack Free and Pro, MissionStack Free, and The Full Stack for all three. Pricing coming soon."
  noindex
>
  <TopNav active="plans" />

  <main id="main" class="page">
    <section class="hero">
      <p class="eyebrow"><span class="dots" aria-hidden="true">▮▮▮</span> <span>The plans</span> <span class="dots" aria-hidden="true">▮▮▮</span></p>
      {/* COPY */}
      <h1 class="display">Pick your plan.</h1>
      <p class="subtitle">{PRICING_LINE}</p>
    </section>

    {/* ---------- THE FULL STACK: the best deal, first ---------- */}
    <section class="full" aria-labelledby="full-h">
      <div class="full-head">
        <span class="best">{fullStack.tag}</span>
        <StackAIMark size={72} />
        <h2 id="full-h" class="full-name">{fullStack.name}</h2>
        <p class="full-line">{fullStack.line}</p>
      </div>
      <div class="full-items-wrap">
        <ul class="checks full-items">
          {fullStack.items.map((i) => <li>{i.text}{i.soon && <span class="soon">Coming soon</span>}</li>)}
        </ul>
        <p class="ai-line">{STACK_AI_LINE}</p>
      </div>
      <div class="full-side">
        <p class="together">{FULL_STACK_TOGETHER}</p>
        <div class="slot full-slot">
          <p class="slot-price small">{priceText(fullStack.price)}</p>
          <p class="slot-note">{FULL_STACK_SLOT}</p>
        </div>
      </div>
    </section>

    {/* ---------- ONE ROW PER APP ---------- */}
    <section class="rows" aria-label="Or pick one app">
      <p class="section-label">Or pick one app</p>
      {rows.map((r) => (
        <article class:list={['row', `row-${r.app}`, r.tiers.length === 1 && 'single']}>
          <header class="row-head">
            <img src={icon(r.app).src} srcset={`${icon(r.app).src} 1x, ${icon(r.app).src2x} 2x`} width="48" height="48" alt="" loading="lazy" />
            <h2 class="row-name"><a href={r.href}>{r.name}</a></h2>
            {r.note && <p class="row-note">{r.note}</p>}
          </header>
          <div class="tiers">
            {r.tiers.map((t) => (
              <div class:list={['tier', t.kind]}>
                {t.tag && <span class:list={['tag', t.kind]}>{t.tag}</span>}
                <h3 class="tier-name">{t.name}</h3>
                <p class="tier-line">{t.line}</p>
                {t.kind === 'pro' && <p class="slot-price small">{priceText(t.price)}</p>}
                <ul class:list={['checks', t.kind]}>
                  {t.items.map((i) => <li>{i.text}{i.soon && <span class="soon">Coming soon</span>}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="block" aria-labelledby="keeps-h">
      <h2 class="section-label" id="keeps-h">What every plan keeps</h2>
      <ul class="checks keeps">
        {principles.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <section class="block" aria-labelledby="coach-h">
      <h2 class="section-label" id="coach-h">For coaches</h2>
      <p class="coach-line">{coach.line}</p>
      <div class="coach-grid">
        <div class="tier free coach-free">
          <span class="tag free">{coach.free.tag}</span>
          <h3 class="tier-name">{coach.free.name}</h3>
          <p class="tier-line">{coach.free.lifters}. {coach.free.line}</p>
        </div>
        <div class="coach-addons">
          <p class="addon-line">{coach.addonLine}</p>
          <ul class="coach-tiers">
            {coach.addons.map((t) => (
              <li><b>{t.name}</b><span>{t.lifters}</span><span class="slot-price small">{priceText(t.price)}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <a class="soft" href="/coach">Coach mode, for coaches →</a>
    </section>

    <section class="block end">
      {/* COPY */}
      <p class="end-line">Train on it now in the beta, and get the App Store link before January 1.</p>
      <a class="btn" href="/first">Get in first →</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page { width: 100%; max-width: calc(1180px + 2 * var(--pad-page-x)); margin: 0 auto; padding: 0 var(--pad-page-x) 72px; }
  .hero { padding: 56px 0 8px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 14px; margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em; color: var(--color-chalk-dim); text-transform: uppercase; }
  .eyebrow .dots { letter-spacing: 0.04em; color: var(--color-chalk-faint); }
  .display { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(44px, 7vw, 84px); line-height: 0.95; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .subtitle { margin: 16px 0 0; max-width: 60ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.6; color: var(--color-chalk-dim); }
  .section-label { margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-chalk-dim); }

  /* Checks: green where it's free to use; chalk for what Pro adds. */
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .checks li { position: relative; padding-left: 24px; font-family: var(--font-serif); font-size: 16px; line-height: 1.5; color: var(--color-chalk); }
  .checks li::before { content: '✓'; position: absolute; left: 0; top: 0; font-family: var(--font-mono); color: var(--color-chalk); }
  .checks.free li::before, .checks.keeps li::before { color: var(--color-army); }
  .checks.try li { color: var(--color-chalk-dim); font-size: 15px; }
  .checks.try li::before { color: var(--color-chalk-faint); }
  .soon { display: inline-block; margin-left: 8px; padding: 1px 6px; border: 1px dashed var(--color-chalk-ghost); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-chalk-dim); vertical-align: 2px; }

  /* THE FULL STACK: the one oxblood accent on the page. */
  .full { position: relative; margin-top: 40px; padding: 40px 40px 36px; background: var(--color-panel); border: 1px solid var(--color-blood); box-shadow: inset 6px 0 0 var(--color-blood); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-template-areas: 'head slot' 'items slot'; gap: 24px 48px; }
  .full-head { grid-area: head; }
  .best { display: inline-block; margin-bottom: 18px; padding: 5px 10px; background: var(--color-blood); color: var(--color-chalk); font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .full-head :global(.stackai-mark) { margin-bottom: 18px; }
  .full-name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(40px, 5.4vw, 64px); line-height: 0.95; letter-spacing: -0.01em; text-transform: uppercase; color: var(--color-chalk); }
  .full-line { margin: 12px 0 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.2; color: var(--color-chalk); }
  .full-items-wrap { grid-area: items; }
  .ai-line { margin: 16px 0 0; max-width: 52ch; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .full-items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; }
  .full-items li { font-size: 17px; }
  .full-side { grid-area: slot; align-self: center; display: grid; gap: 18px; }
  .together { margin: 0; font-family: var(--font-serif); font-size: 18px; line-height: 1.55; color: var(--color-chalk); }
  .full-slot { padding: 16px 18px; }
  .full-slot .slot-price.small { margin: 0; }
  .row-name a { color: inherit; border-bottom: 1px solid var(--color-chalk-ghost); }
  .row-name a:hover { border-bottom-color: var(--color-chalk); }

  /* Price slots: one look everywhere; the numbers drop in from src/data/plans.ts. */
  .slot { padding: 24px; border: 1px dashed var(--color-chalk-ghost); background: var(--color-bg); }
  .slot-price { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 26px; letter-spacing: 0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .slot-price.small { margin: 12px 0 16px; font-size: 15px; letter-spacing: 0.08em; color: var(--color-chalk-dim); }
  .slot-note { margin: 10px 0 0; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }

  /* ONE ROW PER APP */
  .rows { margin-top: 64px; }
  .row { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; padding: 32px 0; border-top: var(--border-thin); }
  .row-head img { display: block; margin-bottom: 14px; border-radius: 22.37%; border: 1px solid var(--color-rule); }
  .row-name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 28px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-chalk); }
  .row-note { margin: 10px 0 0; max-width: 24ch; font-family: var(--font-serif); font-size: 15px; line-height: 1.5; color: var(--color-chalk-dim); }
  .tiers { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 20px; align-items: stretch; }
  /* One column grid for every row: Free on the left, Pro on the right; MissionStack's Free takes the Free column (QA 10-16). */
  .single .tier ul { grid-template-columns: minmax(0, 1fr) !important; }
  .tier.try { align-self: start; }
  @media (max-width: 1000px) { .single .tier { grid-column: 1 / -1; } }
  .tier { padding: 26px 26px 28px; border: var(--border-thin); }
  .tier.pro { background: var(--color-panel); border-color: var(--color-chalk-ghost); }
  .tag { display: inline-block; margin-bottom: 14px; padding: 3px 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .tag.free { border: 1px solid var(--color-army); color: var(--color-army); }
  .tag.try { border: 1px dashed var(--color-chalk-ghost); color: var(--color-chalk-dim); }
  .tag.pro { background: var(--color-chalk); color: var(--color-bg); border: 1px solid var(--color-chalk); }
  .tier-name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 24px; letter-spacing: 0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .tier.pro .tier-name { font-size: 30px; }
  .tier.try .tier-name { font-size: 19px; color: var(--color-chalk-dim); }
  .tier-line { margin: 8px 0 18px; font-family: var(--font-serif); font-size: 16px; line-height: 1.5; color: var(--color-chalk-dim); }
  .tier.pro .tier-line { margin-bottom: 0; font-size: 18px; color: var(--color-chalk); }
  .tier.try .tier-line { font-size: 15px; }

  .block { margin-top: 56px; padding-top: 28px; border-top: var(--border-thin); }
  .keeps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 32px; max-width: 900px; }
  .coach-line { margin: 0 0 18px; max-width: 60ch; font-family: var(--font-serif); font-size: 16px; line-height: 1.6; color: var(--color-chalk-dim); }
  .coach-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 20px; margin-bottom: 20px; }
  .addon-line { margin: 0 0 12px; font-family: var(--font-serif); font-size: 15px; color: var(--color-chalk-dim); }
  .coach-tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--border-thin); border-left: var(--border-thin); }
  .coach-tiers li { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; border-right: var(--border-thin); border-bottom: var(--border-thin); }
  .coach-tiers b { font-family: var(--font-display); font-weight: 600; font-size: 20px; letter-spacing: 0.03em; text-transform: uppercase; color: var(--color-chalk); }
  .coach-tiers span { font-family: var(--font-serif); font-size: 15px; color: var(--color-chalk-dim); }
  .coach-tiers .slot-price.small { margin: 6px 0 0; font-family: var(--font-display); }
  .soft { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-dim); border-bottom: 1px solid var(--color-chalk-ghost); }
  .end { text-align: center; padding-top: 48px; }
  .end-line { margin: 0 auto 22px; max-width: 44ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.55; color: var(--color-chalk); }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 15px 26px; border: 1px solid var(--color-chalk-dim); font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-chalk); }
  .btn:hover { background: var(--color-panel); }

  @media (max-width: 1000px) {
    .page { padding-left: var(--pad-page-x-mid); padding-right: var(--pad-page-x-mid); }
    .full { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'items' 'slot'; padding: 32px 28px; }
    .row { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .row-head { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 4px 16px; align-items: center; }
    .row-head img { margin: 0; grid-row: span 2; }
    .row-note { max-width: none; margin: 0; }
  }
  @media (max-width: 720px) {
    .page { padding-left: var(--pad-page-x-mobile); padding-right: var(--pad-page-x-mobile); }
    .full { padding: 26px 20px; box-shadow: inset 4px 0 0 var(--color-blood); gap: 18px; }
    .full-head :global(.stackai-mark) { width: 52px !important; height: 52px !important; margin-bottom: 12px; }
    .full-items li { font-size: 15px; }
    .full-items, .single .tier ul, .keeps { grid-template-columns: minmax(0, 1fr); }
    .soon { display: block; width: fit-content; margin: 4px 0 0; }
    .tiers, .coach-tiers, .coach-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
