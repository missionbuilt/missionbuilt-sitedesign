<script>
  // ── The cascade rule on fictional data ──
  // Sliding meals chain off the logged breakfast time; gaps compress evenly
  // toward a 2-hour floor (rounded to 5 minutes); the pre-workout meal is
  // pinned 90 minutes before the session.
  const SESSION = 18 * 60;
  const PRE = SESSION - 90;
  const FLOOR = 120;
  const GAP = 180;
  const slider = document.getElementById('d-slider') as HTMLInputElement | null;
  const rows = document.getElementById('d-rows');
  const foot = document.getElementById('d-foot');
  const m1lab = document.getElementById('d-m1');
  const names = [
    { code: 'M1', name: 'Breakfast', sub: 'moves with you' },
    { code: 'M2', name: 'Mid-morning', sub: 'moves with you' },
    { code: 'M3', name: 'Lunch', sub: 'moves with you' },
    { code: 'M4', name: 'Pre-workout', sub: 'stays put · 90 min before the bar' },
  ];
  const planned = [420, 600, 780, PRE];

  function fmt(m: number): string {
    let h = Math.floor(m / 60);
    const mm = m % 60;
    const ap = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    if (h === 0) h = 12;
    return h + ':' + (mm < 10 ? '0' : '') + mm + ' ' + ap;
  }
  function r5(x: number): number { return Math.round(x / 5) * 5; }

  function build(m1: number): void {
    if (!rows || !foot || !m1lab) return;
    const avail = PRE - m1;
    const gap = Math.max(FLOOR, Math.min(GAP, r5((avail - FLOOR) / 2)));
    const t = [m1, m1 + gap, m1 + 2 * gap, PRE];
    let html = '';
    for (let i = 0; i < 4; i++) {
      const locked = i === 3;
      const shifted = !locked && i > 0 && t[i] !== planned[i];
      html += '<div class="drow' + (locked ? ' locked' : '') + '">'
        + '<span class="code">' + names[i].code + '</span>'
        + '<span class="name">' + names[i].name + '<small>' + (shifted ? 'moved · gap ' + gap + ' min' : names[i].sub) + '</small></span>'
        + '<span class="time">' + (shifted ? '<s>' + fmt(planned[i]) + '</s>' : '') + fmt(t[i]) + '</span>'
        + '</div>';
    }
    rows.innerHTML = html;
    m1lab.textContent = fmt(m1);
    const lastGap = PRE - t[2];
    if (m1 === 420) {
      foot.innerHTML = 'Nothing late. Three-hour gaps as planned. <b>Pre-workout at ' + fmt(PRE) + '.</b>';
    } else if (gap > FLOOR) {
      const late = m1 - 420;
      const lh = Math.floor(late / 60);
      const lm = late % 60;
      foot.innerHTML = 'Breakfast ' + (lh ? lh + ' h ' : '') + (lm ? lm + ' min ' : '') + 'late. Remaining gaps compress evenly to ' + gap + ' min. <b>Pre-workout holds at ' + fmt(PRE) + '.</b>';
    } else {
      foot.innerHTML = 'At the two-hour floor. Lunch is now ' + lastGap + ' min before the pre-workout meal, and flagged. <b>Pre-workout still holds at ' + fmt(PRE) + '. The session is what we protect.</b>';
    }
  }

  if (slider) {
    slider.addEventListener('input', () => build(parseInt(slider.value, 10)));
    build(420);
  }

  // ── Join the beta ──
  // Posts to the Pages Function at /api/beta. Without JS the form still posts
  // and the function answers with a redirect back to this page.
  const form = document.getElementById('beta-form') as HTMLFormElement | null;
  const status = document.getElementById('beta-status');
  const fallback = document.getElementById('beta-fallback');
  const tField = document.getElementById('beta-t') as HTMLInputElement | null;
  const submit = document.getElementById('beta-submit') as HTMLButtonElement | null;
  if (tField) tField.value = String(Date.now());

  function say(msg: string, tone: 'ok' | 'err' | ''): void {
    if (!status) return;
    status.textContent = msg;
    status.className = 'cta-note' + (tone ? ' ' + tone : '');
  }

  const params = new URLSearchParams(location.search);
  if (params.get('beta') === 'ok') say('You are on the list. Watch for an email from Apple; it can take a few days.', 'ok');
  if (params.get('beta') === 'err') say('That did not go through. Check the address and try again.', 'err');

  if (form && submit) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('beta-email') as HTMLInputElement).value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { say('That does not look like an email address.', 'err'); return; }
      submit.disabled = true;
      say('Adding you…', '');
      try {
        const res = await fetch('/api/beta', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          say('You are on the list. Watch for an email from Apple; it can take a few days.', 'ok');
          form.reset();
          if (tField) tField.value = String(Date.now());
        } else if (res.status === 503 || data.fallback) {
          if (fallback) fallback.hidden = false;
          say('', '');
        } else if (res.status === 429) {
          say('Too many tries from here. Give it an hour.', 'err');
        } else {
          say(data.error || 'That did not go through. Check the address and try again.', 'err');
        }
      } catch {
        if (fallback) fallback.hidden = false;
        say('', '');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

