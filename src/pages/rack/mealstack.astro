---
/**
 * MealStack (/rack/mealstack): the rebuild (Mike 2026-10-16 08:27 and 08:32). One page whose only
 * job is the beta join, one idea per screen, a real screen each (hq/briefs/site/apple-duo-reference.md).
 * The whole day around the workout leads (Mike 08:27, fix 10: "the point is the training session
 * itself"). No tour, simulated logging or live rule; those leave the site. Detail lives on
 * /rack/mealstack/details.
 *
 * Words: workout (not session) except the app's own labels; no barcode line until the product lead
 * settles it (panel 10-16); nothing says what MealStack's free offering is (Mike 10-15 19:06).
 * COPY strings are drafts for Mike's yes.
 */
import ProductPage from '../../components/ProductPage.astro';
import BetaForm from '../../components/BetaForm.astro';
import { STACK } from '../../data/apps';

const IMG = '/images/mealstack/';
const phone = (f: string, alt: string) => ({ kind: 'phone' as const, shot: { src: `${IMG}${f}.webp`, w: 540, h: 1174, alt } });
const [iron, , mission] = STACK;

const description = 'MealStack times your meals around your workout on iPhone: the meal before you train, the shake after, and the rest of the day around it. Log when you actually ate and the day moves with you. In a private beta; on the App Store January 1.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MealStack',
  url: 'https://missionbuilt.io/rack/mealstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built LLC', url: 'https://missionbuilt.io' },
};
---
<ProductPage
  title="MealStack: meals timed to your workout · Mission Built"
  description={description}
  ogImageAlt="MealStack, meals timed to your workout, by Mission Built."
  ld={ld}
  name="MealStack"
  icon={STACK[1].icon}
  line="Meals timed to your workout."
  sub="Your tracker says what you ate. MealStack says when: open it and the next meal is the screen."
  hero={[
    phone('today-training', 'MealStack Today on a training day with the workout at 6:30 PM: lunch at 2:40 PM is next, 6 oz chicken, rice and broccoli, with Log.'),
  ]}
  cta={{ label: 'Join the beta', href: '#join' }}
  ctaNote="Every app has a free way in, plus paid plans."
  chapters={[
    { title: 'Built around your workout.', line: 'Tell it when you train, and the day builds around the workout: the carb meal before it, the shake after it, dinner when you get home.',
      day: [
        { time: '7:00 AM', label: 'Breakfast' },
        { time: '10:06 AM', label: 'Yogurt and whey' },
        { time: '1:06 PM', label: 'Lunch' },
        { time: '5:00 PM', label: 'Carb surge' },
        { time: '6:30 PM', label: 'Your workout', workout: true },
        { time: '7:30 PM', label: 'The shake' },
        { time: '9:00 PM', label: 'Dinner' },
      ],
      devices: [] },
    { title: 'Workout moved? So does the day.', line: 'Change the time and every meal around it moves with it. One tap undoes it.',
      devices: [phone('session-moved', 'MealStack with the workout at 6:30 PM: one line says the carb surge is at 5:00 PM, the after-workout shake at 7:30 PM and dinner at 9:00 PM, with Undo.')] },
    { title: 'Ate late? Just log it.', line: 'Log when you actually ate. The rest of the day moves, and the meal before your workout holds.',
      devices: [phone('log-late', 'Logging the 10:06 AM yogurt and whey at 11:40: lunch moves from 1:06 to 2:40 PM and the carb surge holds at 5:00 PM.')] },
    { title: 'A week of real plates.', line: 'Plan the week with meals you like, and see each day\'s protein, carbs and fat before you shop.',
      devices: [phone('stack', 'This week\'s plan: training day totals of 201 g protein, 268 g carbs, 45 g fat and 2,280 kcal, and every plate with its ingredients.')] },
    { title: 'Scored on what landed.', line: 'A day counts when the meals landed on time. Nothing scolds you for the ones that didn\'t.',
      devices: [phone('history', 'MealStack History: four full days in a row, and the last seven days on protein and on time.')] },
  ]}
  family={{ title: 'Better as a stack.', items: [
    { name: iron.name, line: 'Tells MealStack when you train, and your day moves with it.', href: iron.href, icon: iron.icon },
    { name: mission.name, line: 'Plan your weeks on the big screen. Meal planning there is coming soon.', href: mission.href || undefined, icon: mission.icon },
  ] }}
  promise={{ title: 'No account. Nothing sold.', line: 'Your plan lives on your phone. Usage data only if you say yes, and never anything you typed.', href: '/rack/mealstack/privacy' }}
  closer={{ title: 'Fueling is training.', line: 'Join the beta and eat on it now. It reaches the App Store January 1.' }}
  more={[
    { label: 'Details', href: '/rack/mealstack/details' },
    { label: 'Compare', href: '/rack/compare/macrofactor' },
    { label: 'Privacy', href: '/rack/mealstack/privacy' },
    { label: 'Release notes', href: '/rack/mealstack/changelog' },
    { label: 'Support', href: '/rack/support' },
  ]}
>
  <BetaForm slot="join" page="/rack/mealstack" name="MealStack" noteLabel="What do you train for?" notePlaceholder="powerlifting, a marathon, getting off the couch" />
  <p slot="after" class="first-alt">MealStack is for adults 18 and over who train. It isn't medical or dietary advice. Not ready for a beta? <a href="/first">Get the App Store link first</a>.</p>
</ProductPage>

<style>
  .first-alt { margin: 18px auto 0; max-width: 46ch; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .first-alt a { color: var(--color-chalk); border-bottom: 1px solid var(--color-chalk-ghost); }
</style>
