---
/**
 * MealStack — product page on the Rack.
 *
 * An iPhone app for meal timing built backward from the training session.
 * Open source with 1.0; the license itself is not settled (MIT or copyleft),
 * and the copy must not commit to one. Private beta (TestFlight, added by hand
 * from the form below); the App Store listing and the source open with 1.0.
 *
 * The page has one job: someone who has never heard of the app learns why it
 * exists, what it does differently, how you use it, and how to get it. In
 * order: hero → try it (the click-through demo, /demos/mealstack.html) →
 * why (the four pillars, linking to the Log) → the rule (live cascade)
 * → what it does differently → how you use it → side by side → fine print →
 * join the beta (form → /api/beta) → the kit (plan skill, release notes,
 * schema, privacy) → FAQ → tester quotes (rendered only when there are real ones) →
 * related.
 *
 * How we talk about it: the Log "Fueling is training"
 * (src/content/logs/fueling-is-training.mdx) is the source of truth. Four
 * pillars: protect the protein, the session, the day, the record. Meals are
 * plates; fuel is what you drink around the session; the meal count is a
 * default, never a fixed number. Not a nutrition app.
 *
 * Color discipline: oxblood for the hero period, eyebrows, section labels,
 * the one marked card (Timing), the two Join buttons, and the closer accent.
 * Army green for the license stat only. No em-dashes in UI strings.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import DemoEmbed from '../../components/DemoEmbed.astro';
import { getCollection } from 'astro:content';
import { byNewest, logUrl } from '../../data/logs';

/** Logs about MealStack, newest first. The first is the story the Why section links to. */
const logs = (await getCollection('logs', ({ data }) => data.tool === 'mealstack' && !data.draft)).sort(byNewest);
const story = logs[0];
const storyHref = story ? logUrl(story) : '/logs';
const storyTitle = story ? story.data.title : 'Logs';

const MAILTO = 'mailto:mike@missionbuilt.io?subject=MealStack%20beta&body=Apple%20ID%20email%3A%20';

const stats = [
  { key: 'Runs on',            value: 'iPhone',     sub: 'iOS 26 and up',            army: false },
  { key: 'Account',            value: 'None',       sub: undefined,                  army: false },
  { key: 'Leaves your phone',  value: 'Nothing',    sub: 'unless you switch it on',  army: false },
  { key: 'License',            value: 'Open source', sub: 'settled with 1.0',         army: true  },
];

type Card = { label: string; pillar: string; verdict: string; evidence: string; them: string; mark?: boolean };
const cards: Card[] = [
  { mark: true, label: 'Timing', pillar: 'Protect the session', verdict: 'The day is anchored to the session, not the clock.', evidence: 'Pre-workout, post-workout and dinner are tied to the session. Everything before them is worked out from the time you actually ate. A late morning tightens the gaps and says what moved; it never pushes the pre-workout meal into the bar.', them: 'Alarms every N hours, or routines that roll lateness forward into the session.' },
  { label: 'Macros', pillar: 'Protect the protein', verdict: 'Weighed from the plate, or typed. Never both.', evidence: 'A meal is a list of ingredients and quantities, so the numbers come from the ingredients and editing a portion moves them. The daily target lives apart from the plan, so the editor can say "this plate puts the day 40 g of carbs over" while you are still building it.', them: 'A food database and a total. No plan to measure the plate against.' },
  { label: 'Logging', pillar: 'Protect the record', verdict: 'Log when you eat, not when it was due.', evidence: 'The sheet opens on now with 15, 30 and 60 minutes ago one tap away, and shows what every remaining meal does at that time before you commit. Move today\'s session from the Today screen and the meals tied to it move with it.', them: '"Done" means now, so the day keys off the wrong number.' },
  { label: 'Travel', pillar: 'Protect the day', verdict: 'A day runs in the zone it started in.', evidence: 'Cross three time zones and the spacing holds. The app says so and offers one tap to switch when local time becomes the truth. Skip a meal and it stays a decision, not a miss. History compares home days to travel days.', them: 'Alarms drift with the phone clock. Breakfast at 9, lunch at 10.' },
  { label: 'Surfaces', pillar: 'Protect the protein', verdict: 'You should rarely have to open it.', evidence: 'Notifications carry the plate and two actions: "Ate it now" and "Not yet, ask in 20." Home and Lock Screen widgets with a live countdown. A card on the Lock Screen from an hour before each meal to thirty minutes after, with a Log button on it and at the top of the screen.', them: 'A badge, and a screen you unlock to answer it.' },
  { label: 'Coach', pillar: 'Protect the day', verdict: 'An AI that proposes. You decide.', evidence: 'Ask for targets and a fixed formula does the arithmetic, not the model. Ask for meal ideas, or hand it a menu photo, a link or a restaurant name, and it fits options to this meal\'s numbers. Nothing changes until you tap a card. Not a doctor, and it says so before you ask.', them: 'A chatbot that talks, or a coach that edits your plan without asking.' },
];

type Step = { n: string; title: string; body: string };
const steps: Step[] = [
  { n: '01', title: 'Answer two questions.', body: 'When is your first meal, and when do you train. Quick start builds a working day from that, no AI and no account: the morning meals follow one another from your first meal, the pre-workout meal and everything after are tied to the session. Five meals by default; change the number in Settings. Put food on the plates when you are ready, or let Coach fill them.' },
  { n: '02', title: 'Log when you actually ate.', body: 'One tap for now, one for thirty minutes ago. The sheet shows what every remaining meal does before you commit, and the notification can log it without opening the app. The pre-workout meal holds. The rest of the day bends around you.' },
  { n: '03', title: 'Ask when the plan breaks.', body: 'Client lunch, airport, empty fridge. Send Coach the menu, a link or what is in the kitchen and it fits an order to this meal\'s numbers. Nothing changes until you tap. History keeps score, so you can see what the road does to you.' },
];

type Versus = { k: string; them: string; us: string; honest?: boolean };
const versus: Versus[] = [
  { k: 'Anchor', them: 'The clock.', us: 'Your session.' },
  { k: 'A late meal', them: 'The next alarm fires anyway.', us: 'The rest of the day re-flows. The pre-workout meal holds.' },
  { k: 'Macros', them: 'Typed in, or scanned, then summed.', us: 'Weighed from the plate, measured against a target you set.' },
  { k: 'Logging time', them: 'Now.', us: 'When you actually ate, with the consequence shown first.' },
  { k: 'Time zones', them: 'Alarms drift with the phone.', us: 'Spacing holds. You choose when to switch.' },
  { k: 'Eating out', them: 'Search the database, guess the portion.', us: 'Coach reads the menu against this meal\'s numbers.' },
  { k: 'Your data', them: 'Their servers, your account.', us: 'Your phone. Coach and usage data are switches, off until you say.' },
  { k: 'Best at', them: 'A database of a million foods and a barcode scanner.', us: 'Timing. Keep the other app for the barcode if you like.', honest: true },
];

type Faq = { q: string; a: string };
const faqs: Faq[] = [
  { q: 'Is it free?', a: 'During the beta, yes, Coach included, on an allowance. The launch price is not settled. The fine print above says why, and the answer lands on this page before it lands in the store.' },
  { q: 'Does it need an account?', a: 'No. There is nothing to sign up for. Your plan, your log and your history are files on your phone. One button in Settings wipes them, and the little the server holds for Coach along with them.' },
  { q: 'What leaves my phone?', a: 'Nothing, unless you switch it on. Coach sends what you type or photograph to a server I run, and only while Coach is on. Usage data goes to an analytics service only if you say yes when the app asks. The privacy page says exactly what, where and for how long.' },
  { q: 'Is Coach a doctor?', a: 'No. Coach is an AI. Its targets come from a formula you can read, its meal ideas are estimates, and it declines questions about medical conditions, medication, pregnancy and supplement doses. Nothing it proposes changes your plan until you tap.' },
  { q: 'Can I keep my macro tracker?', a: 'Yes, and if you lean on a barcode scanner you should. MealStack is the timing layer. It knows the plate, weighs macros from it, and writes them to Apple Health at the time you ate, so the two live side by side.' },
  { q: 'Does it have streaks?', a: 'No. A streak rewards you for tapping the button, and the easiest way to keep one alive is to lie a little. The log is the input for tomorrow, so it has to be true. History scores the week on what actually landed, and that is the only score.' },
  { q: 'Android, iPad, watch?', a: 'iPhone only, iOS 26 and up. No Android, no iPad layout, no watch app, and none planned for 1.0. The Lock Screen, the widgets and the notifications are where the app lives when it is not open.' },
  { q: 'Which license?', a: 'Not decided. It will be open source, and the source opens with 1.0; whether it is MIT like the rest of the kit or a copyleft license that keeps forks open is the part I have not settled. The name and the marks stay with Mission Built either way.' },
  { q: 'When is 1.0?', a: 'After the meet it is being tested through, in October 2026, once a fresh install has been proven on phones that are not mine.' },
];

/** Tester quotes. Empty until there are real ones; the section does not render while empty. */
type Quote = { text: string; who: string };
const quotes: Quote[] = [];

const title = 'MealStack: meal timing built around your training session · Mission Built';
const description = 'Fueling is training. MealStack is a meal timing tracker for people who train: protein stacked across the day, a pre-workout meal that holds its time, a day you can change on the road, and a log of when you actually ate. Not a nutrition app. iPhone, no account, open source with 1.0. Private beta.';

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'MealStack',
      url: 'https://missionbuilt.io/rack/mealstack',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS 26',
      description,
      author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
      publisher: { '@type': 'Organization', name: 'Mission Built', url: 'https://missionbuilt.io' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', description: 'Free during the private beta. Launch price not yet set.' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  ogImageAlt="MealStack. Fueling is training. A meal timing tracker for people who train, on iPhone, by Mission Built."
  active="rack"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <TopNav active="rack" />

  <main class="page">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/rack">The Rack</a>
      <span aria-hidden="true"> / </span>
      <span class="here">MealStack</span>
    </nav>

    {/* ---------- HERO ---------- */}
    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>An iPhone app from the Rack</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>

      <h1 class="display">
        <span>MealStack</span><span class="dot">.</span>
      </h1>

      <div class="testing-tag" aria-label="Private beta, for iPhone">
        <span class="tag-sq" aria-hidden="true"></span>
        <span>Private beta</span>
        <span class="tag-sep" aria-hidden="true">·</span>
        <svg class="ph-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 18.5h4"/></svg>
        <span>iPhone</span>
      </div>

      <p class="subtitle">
        <span class="line1">Fueling is training.</span>
        <span class="line2">A meal timing tracker for people who train. Your session doesn't move. Your meals do.</span>
      </p>

      <div class="hero-ctas">
        <a class="cta" href="#beta">Join the beta →</a>
        <a class="cta-soft" href="#demo">See how it works ↓</a>
      </div>
    </section>

    {/* ---------- META STRIP ---------- */}
    <section class="meta-strip" aria-label="MealStack at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          <div class:list={['stat-value', s.army && 'army']}>{s.value}{s.sub && <span class="stat-sub">{s.sub}</span>}</div>
        </div>
      ))}
    </section>

    {/* ---------- TRY IT: click-through demo ---------- */}
    <section class="block" id="demo">
      <p class="section-label">Try it</p>
      <h2 class="section-h2">Click through a training day.</h2>
      <p class="prose">
        A hand-drawn copy of the app on invented numbers, not a video. Four short parts: setting
        up from a blank app and having Coach fill the plates, a late morning and what it does to
        the afternoon, swapping lunch for a restaurant order with Coach, then the Lock Screen and
        History. Tap where it tells you, or let it drive.
      </p>
      <DemoEmbed
        src="/demos/mealstack.html"
        title="MealStack click-through demo"
        caption="Click-through demo · drawn by hand on invented numbers · the tabs work"
        mobileHeight={900}
      />
    </section>

    <hr class="dashed" />

    {/* ---------- WHY ---------- */}
    <section class="block" id="why">
      <p class="section-label">Why it exists</p>
      <h2 class="section-h2">Fueling is training.</h2>
      <div class="story">
        <p>I sat in a nutrition seminar at the Shaw Strength Summit and heard Nathan Payton say it plainly: if you are not eating properly, you are failing your training. Eating is part of your training.</p>
        <p>That sent me home to rebuild how I eat, and then looking for an app that understood it. The meal-timer apps are alarm clocks. The routine apps roll a late morning into the session. The macro trackers know what I ate to the gram and have no opinion about when. Not one of them asks what time you train. So I built the one I needed. Four ideas hold up everything it does.</p>
      </div>

      <ol class="pillars" aria-label="The four pillars">
        <li><span class="num">01</span><span class="label">Protect the protein</span><span class="say">Protein has no storage tank. Stack it across the day, and never send it out alone.</span></li>
        <li><span class="num">02</span><span class="label">Protect the session</span><span class="say">Your pre-workout meal is equipment, not a snack. It anchors backward from when you train and holds its time.</span></li>
        <li><span class="num">03</span><span class="label">Protect the day</span><span class="say">Flights, time zones, a session that moved to 8pm. Change the day to rest, move the session, swap the plate, keep going.</span></li>
        <li><span class="num">04</span><span class="label">Protect the record</span><span class="say">Log when you eat, not when it was due. Today shows what actually landed, so tomorrow is built on the real day.</span></li>
      </ol>

      <p class="story-link">
        <a href={storyHref}>Read the whole story: {storyTitle} →</a>
        <span class="story-meta">Where the four came from, and what I got wrong first.</span>
      </p>

      {logs.length > 1 && (
        <div class="from-logs">
          <p class="k">From the logs</p>
          <ul>
            {logs.map((n) => (
              <li><a href={logUrl(n)}>{n.data.title}</a><span class="desc">{n.data.description}</span></li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <hr class="dashed" />

    {/* ---------- THE RULE: live cascade ---------- */}
    <section class="block" id="rule">
      <p class="section-label">The rule</p>
      <h2 class="section-h2">Breakfast was late. Your pre-workout meal shouldn't be.</h2>
      <p class="prose">
        Two kinds of meal. The morning meals follow on from the time you actually ate.
        The meals around your session stay where they are. Drag breakfast late and watch which ones move.
      </p>

      <div class="demo" id="cascade">
        <div class="demo-top">
          <span><span class="k">Logged breakfast at</span><br /><span class="val" id="d-m1">7:00 AM</span></span>
          <span><span class="k">Session</span><br /><span class="val">6:00 PM</span></span>
        </div>
        <input type="range" id="d-slider" min="420" max="720" step="15" value="420" aria-label="Breakfast time" />
        <div class="demo-rows" id="d-rows"></div>
        <p class="demo-foot" id="d-foot"></p>
      </div>
      <p class="note">Gaps compress evenly toward a two-hour floor, rounded to five minutes. The pre-workout meal never moves for a late morning. Move the session itself and every meal tied to it moves with it.</p>
    </section>

    <hr class="dashed" />

    {/* ---------- WHAT IT DOES DIFFERENTLY ---------- */}
    <section class="block" id="different">
      <p class="section-label">What it does differently</p>
      <h2 class="section-h2">Six things the market didn't have in one place.</h2>

      <div class="cards">
        {cards.map((c) => (
          <article class:list={['card', c.mark && 'mark']}>
            <p class="label">{c.label}<span class="pillar"> · {c.pillar}</span></p>
            <p class="verdict">{c.verdict}</p>
            <p class="evidence">{c.evidence}</p>
            <p class="them"><b>Other apps:</b> {c.them}</p>
          </article>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- HOW YOU USE IT ---------- */}
    <section class="block" id="how">
      <p class="section-label">How you use it</p>
      <h2 class="section-h2">Two questions, then get on with your day.</h2>

      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <h3 class="sub-h3">And the rest</h3>
      <p class="prose">
        Meals are plates. Fuel is what you take for training that is not a meal: pre-workout, creatine,
        the intra bottle, hydration. It gets its own alert and its own line on the record, and it never
        counts against your meals.
        Three shelves on the Plan tab: stacks, meals, and ingredients (about two hundred built in, plus
        your own, entered like the label). Drop a saved meal onto any plate. Apple Health gets the macros at the real
        eat time, and never reads anything back. Light and dark. History that scores against the target you set.
        Your plan is a file on your phone. No account, no sign-in, nothing to sync.
      </p>
    </section>

    <hr class="dashed" />

    {/* ---------- SIDE BY SIDE ---------- */}
    <section class="block" id="compare">
      <p class="section-label">Side by side</p>
      <h2 class="section-h2">What other apps do, and what this one does instead.</h2>

      <div class="versus" aria-label="MealStack compared with other apps">
        <div class="vh"><span></span><span>Other apps</span><span>MealStack</span></div>
        {versus.map((v) => (
          <div class:list={['vr', v.honest && 'honest']}><span class="vk">{v.k}</span><span>{v.them}</span><span>{v.us}</span></div>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- FINE PRINT ---------- */}
    <section class="block" id="fine-print">
      <p class="section-label">The fine print, in plain words</p>
      <h2 class="section-h2">Open source, your data, and two things I have not picked.</h2>
      <div class="lic three">
        <div class="lic-cell">
          <p class="k">License</p>
          <p class="v">Open source. Which license, not yet.</p>
          <p class="body">The source goes public with 1.0; that part is settled. The license is not. The Loadout skills and Ironstack are MIT, take them and do what you like. For an app the question is whether a fork has to stay open, which is what a copyleft license like the GPL does and MIT does not. I have gone back and forth. The answer lands here with 1.0, and either way you will be able to read, change and ship it.</p>
        </div>
        <div class="lic-cell">
          <p class="k">Price</p>
          <p class="v">Not settled yet. Here is why.</p>
          <p class="body">Every Coach question runs on a server I pay for. I want Coach in the app, and I am not willing to lose money keeping it there, so the launch price is an open question: free with Coach on an allowance, a one-time price, or Coach as the paid part of a free app. What is settled: timing, the log, the plan and the widgets cost nothing to run and will not be what you pay for, and the answer lands here before it lands in the store.</p>
        </div>
        <div class="lic-cell">
          <p class="k">Your data</p>
          <p class="v">On your phone. Two switches.</p>
          <p class="body">The plan, the log and the day never leave the phone. Coach is a switch, off by default; when it is on, what you send it goes to a server Mission Built runs, and it is metered. Usage data is a second switch the app asks about once. <a class="inline-link" href="/rack/mealstack/privacy">The privacy page</a> says exactly what, where, and for how long.</p>
        </div>
      </div>
      <div class="fine">
        <p class="k">Not a doctor. Neither is Coach.</p>
        <p>I am not a doctor or a dietitian, and nothing on this page or in the app is advice about how you should eat. It is how I manage my own diet. Coach is an AI and is not one either: its targets are estimates from a formula you can read, it declines questions about medical conditions, medication, pregnancy and supplement doses, and it points you to a professional instead. Nothing it proposes changes your plan until you tap.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- JOIN THE BETA ---------- */}
    <section class="install-block" id="beta">
      <p class="section-label">Join the beta</p>
      <h2 class="section-h2">Private beta, on iPhone, right now.</h2>

      <div class="status-panel">
        <div class="status-copy">
          <h3>Running through a meet prep, October 2026</h3>
          <p>MealStack is on one phone every day right now: five meals and the fuel around the session, an evening session, a pre-workout meal that does not move. I add testers by hand, in small batches, from the email on your Apple ID. You get an invite from Apple, a link to install, the quick start, and a short list of things I would like you to break.</p>
          <p>Builds expire every ninety days and you get the next one. The address is used for the invite and nothing else; you can leave from the invite email at any time.</p>

          <form class="beta-form" id="beta-form" method="post" action="/api/beta" novalidate>
            <label class="field">
              <span class="field-k">Apple ID email</span>
              <input type="email" name="email" id="beta-email" required autocomplete="email" inputmode="email" placeholder="the address on your Apple ID" maxlength="254" />
            </label>
            <label class="field">
              <span class="field-k">What do you train for? <em>optional</em></span>
              <input type="text" name="note" id="beta-note" autocomplete="off" placeholder="powerlifting, a marathon, a wedding, getting off the couch" maxlength="200" />
            </label>
            <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <input type="hidden" name="t" id="beta-t" value="" />
            <input type="hidden" name="page" value="/rack/mealstack" />
            <div class="form-row">
              <button class="cta" type="submit" id="beta-submit">Join the beta →</button>
              <p class="cta-note" id="beta-status" role="status" aria-live="polite">iPhone only · iOS 26 and up · no account</p>
            </div>
          </form>
          <p class="cta-note" id="beta-fallback" hidden>The form is not taking names right now. Email <a href={MAILTO}>mike@missionbuilt.io</a> with the address on your Apple ID and I will add you by hand.</p>
        </div>
        <div class="doors">
          <div class="door open"><div><div class="n">Beta</div><p class="d">By invite, from the form. Small batches, added by hand.</p></div><span class="s">Now</span></div>
          <div class="door dim"><div><div class="n">App Store</div><p class="d">The public door.</p></div><span class="s">With 1.0</span></div>
          <div class="door dim"><div><div class="n">Source</div><p class="d">github.com/missionbuilt/mealstack, open source.</p></div><span class="s">With 1.0</span></div>
        </div>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- THE KIT ---------- */}
    <section class="block" id="kit">
      <p class="section-label">For testers</p>
      <h2 class="section-h2">Build a plan, see what changed, read the fine print.</h2>

      <div class="related four">
        <a href="/rack/mealstack/skill" class="related-card">
          <h3>Plan skill</h3>
          <p>Teach Claude to write a MealStack plan file. Ask for a week of meals, tap the file on your phone, and it lands on your shelves.</p>
          <span class="related-cta">Download →</span>
        </a>
        <a href="/rack/mealstack/changelog" class="related-card">
          <h3>Release notes</h3>
          <p>What changed in each build, in plain words, newest first. The app's About links here.</p>
          <span class="related-cta">Read →</span>
        </a>
        <a href="/rack/mealstack/schema" class="related-card">
          <h3>Schema</h3>
          <p>One set of names for ingredients, meals, stacks, plans and days, in the app, the plan file, the skill and Coach. Every field, with a download for tools.</p>
          <span class="related-cta">Read →</span>
        </a>
        <a href="/rack/mealstack/privacy" class="related-card">
          <h3>Privacy</h3>
          <p>What stays on your phone, what leaves it, who touches it, how long it lasts, and how to make it all go away.</p>
          <span class="related-cta">Read →</span>
        </a>
      </div>
    </section>

