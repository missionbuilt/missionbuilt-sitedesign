---
/**
 * MealStack landing page (/rack/mealstack). Short on purpose: what is different,
 * the key features with real screens, how to get it. Everything else (the click-through
 * tour, the live rule, side by side, fine print, the kit, FAQ, Better Together) is on
 * /rack/mealstack/details. See AppLanding.astro.
 *
 * Language from the Log "Fueling is training": meals are plates, the meal before the
 * session is the carb surge, fuel is never a meal. Not a nutrition app.
 * Screens are the tour's real Simulator captures (public/demos/mealstack, MealStack 0.9.1).
 */
import AppLanding from '../../components/AppLanding.astro';

const IMG = '/images/mealstack/';
const s = (f: string, alt: string) => ({ src: `${IMG}${f}.webp`, w: 540, h: 1174, alt });

const title = 'MealStack: meal timing built around your training · Mission Built';
const description = 'MealStack is a meal timing app for iPhone, built backward from your training session. Log when you actually ate and the day re-flows while your pre-workout carb surge holds. Holds up across time zones. No account. Free during the private beta.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MealStack',
  url: 'https://missionbuilt.io/rack/mealstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built', url: 'https://missionbuilt.io' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', description: 'Free during the private beta. Launch price not yet set.' },
};
---
<AppLanding
  app="mealstack"
  name="MealStack"
  title={title}
  description={description}
  ogImageAlt="MealStack. Fueling is training. A meal timing tracker for people who train, on iPhone, by Mission Built."
  ld={ld}
  promise="Your tracker says what you ate."
  promiseAccent="This says when."
  sub="Tell it when you train and the day builds backward from the session: the meal before it, the fuel around it, the shake after. Breakfast ran late? Log it when you actually ate; the rest of the day re-flows and your pre-workout meal still lands before you train. Keep your tracker for the barcode. MealStack does the timing."
  subShort="Tell it when you train. Eat late and the day re-flows; your pre-workout meal still lands before the session."
  trust={['Free during the beta', 'iPhone, iOS 26+', 'No account', 'Works next to your tracker']}
  hero={[
    { src: '/images/mealstack/today-training.webp', w: 540, h: 1176, alt: 'MealStack Today on my iPhone, a training day with the session at 6 PM: next is yogurt and berries at 12:03 PM, a note that the gaps tightened so the carb surge still lands before the session, and totals against a 2,927 kcal target.' },
    s('session-moved', 'MealStack after the session moved to 6:30 PM: the next meal moves to 12:10 PM and the carb surge to 5:00 PM, with an Undo.'),
  ]}
  soft={{ label: 'Take the one-minute tour →', href: '/rack/mealstack/details#demo' }}
  diffLabel="Why it is different"
  diffH2="Your session doesn't move. Your meals do."
  themLabel="Other apps:"
  diffs={[
    { claim: 'Anchored to the session.', body: 'The carb surge (the carb-heavy meal before you train), the fuel around the session and the meals after it are set from the session, not the clock. Move the session and they move with it.', them: 'Alarms every few hours, or routines that roll a late morning into the session.' },
    { claim: 'Log when you ate.', body: 'Now, 30 minutes ago, or an hour ago, with what every remaining meal does shown before you commit. A late morning tightens the gaps. The carb surge holds.', them: '"Done" means now, so the day keys off the wrong number.' },
    { claim: 'Holds up on the road.', body: 'Cross three time zones and the spacing holds until you say local time is the truth. Skip a meal and it stays a decision, not a miss. History compares home days to travel days.', them: 'Alarms follow the phone clock, so a flight across two time zones throws every meal off by two hours.' },
    { claim: 'A coach in your corner.', body: 'Ask for targets and a fixed formula does the arithmetic, not the model. Hand it a menu photo, a link or a restaurant name and it fits an order to this meal\'s numbers. Nothing changes until you tap.', them: 'A chatbot that talks, or a coach that edits your plan without asking.' },
  ]}
  featH2="Real screens, from the app."
  features={[
    { ...s('log-late', 'MealStack log sheet: eaten 1 hr ago, with the yogurt bowl and paprika chicken box moving and the carb surge holding at 4:30 PM.'), k: 'Log', title: 'When did you eat it?', body: 'Now, 30 minutes ago, an hour ago. See what the rest of the day does before you commit.' },
    { ...s('session-moved', 'MealStack after the session moved to 6:30 PM: the next meal moves to 12:10 PM, with an Undo.'), k: 'Session', title: 'Move the session. Meals follow.', body: 'Gym at 6:30 instead of 6? Everything tied to the session moves with it, and one tap undoes it.' },
    { src: '/images/mealstack/coach-eating-out.webp', w: 540, h: 1176, alt: 'MealStack Coach, eating out at Chipotle in place of the planned meal: two bowls built from Chipotle items, each with its macros, how it compares with the plan, and a Use it today button.', k: 'Coach', title: 'Eating out? Name the place.', body: 'Coach builds orders that fit this meal and says how far each one lands from the plan. Nothing changes until you tap.' },
    { ...s('stack', 'MealStack stack The Base: training day totals of 224 g protein, 312 g carbs, 57 g fat, and every plate listed with its ingredients.'), k: 'Plan', title: 'A week of plates.', body: 'Training days and rest days, each with its own plates and totals. Drop a saved meal on any plate.' },
    { ...s('meal-editor', 'MealStack meal editor for a paprika chicken box: 7 oz chicken breast, 225 g jasmine rice and 150 g broccoli, with the macros each one brings.'), k: 'Macros', title: 'Weighed from the plate.', body: 'A meal is ingredients and grams, so the numbers come from the food and move when the portion does.' },
    { ...s('history', 'MealStack History: last 7 days averaging 224 g protein and 77 percent on time, home against travelling, and protein for the last 14 days.'), k: 'History', title: 'Scored on what landed.', body: 'On time, protein, and home days against travel days. No streaks to keep alive.' },
  ]}
  featNote="Real screens: a debug build in the iPhone Simulator with four weeks of sample history, and Today and Coach on my iPhone, Sept 20, 2026."
  steps={[
    { title: 'Leave your Apple ID email.', body: 'Testers come in small batches, added by hand. The address is used for the invite and nothing else.' },
    { title: 'Install from TestFlight.', body: 'Apple emails you an invite. TestFlight is Apple\'s own app for betas; MealStack installs like any other app.' },
    { title: 'Answer two questions.', body: 'When is your first meal, and when do you train. Quick start builds the day. Fill the plates now, or let Coach do it.' },
  ]}
  noteLabel="What do you train for?"
  notePlaceholder="powerlifting, a marathon, a wedding, getting off the couch"
  details={[
    { label: 'The one-minute tour', body: 'Real screens, click through the four pillars.', href: '/rack/mealstack/details#demo' },
    { label: 'The rule, live', body: 'Drag breakfast late and watch which meals move.', href: '/rack/mealstack/details#rule' },
    { label: 'Side by side', body: 'Against meal timers and macro trackers, including what they do better.', href: '/rack/mealstack/details#compare' },
    { label: 'Questions', body: 'Price, accounts, what leaves your phone, keeping your tracker.', href: '/rack/mealstack/details#faq' },
    { label: 'Price, license, your data', body: 'What is free, what is not settled yet, and why.', href: '/rack/mealstack/details#fine-print' },
    { label: 'Better with Ironstack', body: 'The lifting log. What the two share today, and what is next.', href: '/rack/mealstack/details#better-together' },
  ]}
  closer={{ four: 'Protein · Session · Day · Record', line: 'Fueling is training.' }}
  footLinks={[{ label: 'The details', href: '/rack/mealstack/details' }, { label: 'Plan skill', href: '/rack/mealstack/skill' }, { label: 'Release notes', href: '/rack/mealstack/changelog' }, { label: 'Schema', href: '/rack/mealstack/schema' }, { label: 'Privacy', href: '/rack/mealstack/privacy' }]}
/>
