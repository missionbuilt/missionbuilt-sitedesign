---
/**
 * MealStack landing page (/rack/mealstack). Short on purpose: what is different,
 * the key features with real screens, how to get it. Everything else (the click-through
 * tour, the live rule, side by side, fine print, the kit, FAQ, Better Together) is on
 * /rack/mealstack/details. See AppLanding.astro.
 *
 * Language from the Log "Fueling is training": meals are plates, the meal before the
 * session is the carb surge, fuel is never a meal. Not a nutrition app.
 * Screens are the tour's real Simulator captures (public/demos/mealstack, MealStack 0.9.1).
 * Stack AI is a key highlight: in the sub, the trust row, the second hero screen and diff #2.
 * The tagline "Fueling is training." is the hero eyebrow, above the fold.
 */
import AppLanding from '../../components/AppLanding.astro';

const IMG = '/images/mealstack/';
const s = (f: string, alt: string) => ({ src: `${IMG}${f}.webp`, w: 540, h: 1174, alt });

const title = 'MealStack: Fueling is training · Mission Built';
const description = 'Fueling is training. MealStack is a meal timing app for iPhone, built backward from your training session. Log when you actually ate and the day re-flows while your carb surge holds. Stack AI builds the plan, brings in your coach\'s plan from a photo or PDF, and fits a restaurant menu to the meal. No account. Free during the TestFlight beta.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MealStack',
  url: 'https://missionbuilt.io/rack/mealstack',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS 26',
  description,
  author: { '@type': 'Person', name: 'Mike Nichols', url: 'https://missionbuilt.io/about' },
  publisher: { '@type': 'Organization', name: 'Mission Built', url: 'https://missionbuilt.io' },
};
---
<AppLanding
  app="mealstack"
  name="MealStack"
  title={title}
  description={description}
  ogImageAlt="MealStack. Fueling is training. A meal timing tracker for people who train, on iPhone, by Mission Built."
  ld={ld}
  eyebrow="Fueling is training · Private beta · iPhone"
  promise="Your tracker says what you ate."
  promiseAccent="This says when."
  sub="Tell it when you train and the day builds backward from the session: the meal before it, the fuel around it, the shake after. Breakfast ran late? Log it when you actually ate; the rest of the day re-flows and your carb surge still lands before you train. Stack AI builds the plan with you, brings in your coach's plan from a photo or PDF, and fits a restaurant menu to the meal. Keep your tracker for the barcode. MealStack does the timing."
  subShort="Tell it when you train. Eat late and the day re-flows; your carb surge still lands before the session. Stack AI builds the plan."
  trust={['Stack AI built in', 'Free during the beta', 'iPhone, iOS 26+', 'No account']}
  hero={[
    { src: '/images/mealstack/today-training.webp', w: 540, h: 1174, alt: 'MealStack Today on a training day with the session at 6:30 PM: the yogurt logged late at 11:40, lunch next at 2:40 PM, and the Home travel chip under the MealStack header.' },
    { src: '/images/mealstack/coach-eating-out.webp', w: 540, h: 1176, alt: 'Stack AI in MealStack, eating out at Chipotle in place of the planned meal: two bowls built from Chipotle items, each with its macros, how it compares with the plan, and a Use it today button.' },
  ]}
  soft={{ label: 'Take the one-minute tour →', href: '/rack/mealstack/details#demo' }}
  diffLabel="Why it is different"
  diffH2="Your session doesn't move. Your meals do."
  themLabel="Other apps:"
  diffs={[
    { claim: 'Anchored to the session.', body: 'The carb surge (the carb-heavy meal before you train), the fuel around the session and the meals after it are set from the session, not the clock. Move the session and they move with it.', them: 'Alarms every few hours, or routines that roll a late morning into the session.' },
    { claim: 'Knows your training.', body: 'Let Stack AI build the plan, or send it your coach\'s plan as a photo or PDF and it brings it in. Eating out, hand it up to five menu photos, a link or a restaurant name and it fits an order to this meal\'s numbers. Targets come from a fixed formula, not the model. Nothing changes until you tap.', them: 'A chatbot that talks, or an AI that edits your plan without asking.' },
    { claim: 'Log when you ate.', body: 'Now, 30 minutes ago, or an hour ago, with what every remaining meal does shown before you commit. A late morning tightens the gaps. The carb surge holds.', them: '"Done" means now, so the day keys off the wrong number.' },
    { claim: 'Holds up on the road.', body: 'Home or Away in one tap, shared with IronStack, or automatic when you are far from home. Skip a meal and it stays a decision, not a miss. History compares home days to travel days.', them: 'One schedule, and it assumes you are home.' },
  ]}
  featH2="Real screens, from the app."
  features={[
    { ...s('log-late', 'MealStack log sheet for the 10:06 AM yogurt, logged at 11:40: lunch moves from 1:06 to 2:40 PM, and the carb surge holds at 5:00 PM.'), k: 'Log', title: 'When did you eat it?', body: 'Now, 30 minutes ago, an hour ago. See what the rest of the day does before you commit.' },
    { ...s('session-moved', 'MealStack after the session moved to 6:30 PM: one line says the carb surge moved to 5:00 PM, the shake to 7:30 PM and dinner to 9:00 PM, with an Undo.'), k: 'Session', title: 'Move the session. Meals follow.', body: 'Gym at 6:30 instead of 6? Everything tied to the session moves with it, and one tap undoes it.' },
    { src: '/images/mealstack/coach-eating-out.webp', w: 540, h: 1176, alt: 'Stack AI in MealStack, eating out at Chipotle in place of the planned meal: two bowls built from Chipotle items, each with its macros, how it compares with the plan, and a Use it today button.', k: 'Stack AI', title: 'Eating out? Send the menu.', body: 'Up to five menu photos, a link or the place\'s name. Stack AI builds orders that fit this meal and says how far each one lands from the plan. Nothing changes until you tap.' },
    { ...s('stack', 'MealStack stack The Base with its Training and Recovery toggle: training day totals of 224 g protein, 312 g carbs, 57 g fat and 2,658 kcal, and every plate with its ingredients.'), k: 'Plan', title: 'A week of plates.', body: 'Training days and recovery days, each with its own plates and totals. Drop a saved meal on any plate.' },
    { ...s('meal-editor', 'MealStack meal editor for a paprika chicken box: 7 oz chicken breast, 225 g jasmine rice, 150 g broccoli and half a tablespoon of olive oil, with the macros each one brings.'), k: 'Macros', title: 'Weighed from the plate.', body: 'A meal is ingredients and grams, so the numbers come from the food and move when the portion does.' },
    { ...s('history', 'MealStack History: a streak of eight full days, the badges earned with the next one up, and the last seven days on protein and on time.'), k: 'History', title: 'Scored on what landed.', body: 'Your streak of full days, your badges, and what actually landed: on time, protein, home days against travel days. Only good habits earn anything.' },
  ]}
  featNote="Real screens from MealStack 0.9.1: a debug build in the iPhone Simulator on the sample plan with four weeks of sample history, Sept 29, 2026. Stack AI, eating out, is from my iPhone, Sept 20."
  steps={[
    { title: 'Leave your Apple ID email.', body: 'Testers come in small batches, added by hand. The address is used for the invite and nothing else.' },
    { title: 'Install from TestFlight.', body: 'Apple emails you an invite. TestFlight is Apple\'s own app for betas; MealStack installs like any other app.' },
    { title: 'Pick how to start.', body: 'Just the times, your coach\'s plan, let Stack AI build it, or build it yourself. Or see a finished day first.' },
  ]}
  noteLabel="What do you train for?"
  notePlaceholder="powerlifting, a marathon, a wedding, getting off the couch"
  details={[
    { label: 'The one-minute tour', body: 'Real screens, click through the four pillars.', href: '/rack/mealstack/details#demo' },
    { label: 'The rule, live', body: 'Drag breakfast late and watch which meals move.', href: '/rack/mealstack/details#rule' },
    { label: 'Side by side', body: 'Against meal timers and macro trackers, including what they do better.', href: '/rack/mealstack/details#compare' },
    { label: 'Questions', body: 'Price, accounts, what leaves your phone, keeping your tracker.', href: '/rack/mealstack/details#faq' },
    { label: 'Price and your data', body: 'What is settled, what is not, and how your data comes with you.', href: '/rack/mealstack/details#fine-print' },
    { label: 'Better with IronStack', body: 'The lifting log. What the two share today, and what is next.', href: '/rack/mealstack/details#better-together' },
  ]}
  closer={{ four: 'Protein · Session · Day · Record', line: 'Fueling is training.' }}
  footLinks={[{ label: 'The details', href: '/rack/mealstack/details' }, { label: 'Release notes', href: '/rack/mealstack/changelog' }, { label: 'Schema', href: '/rack/mealstack/schema' }, { label: 'Privacy', href: '/rack/mealstack/privacy' }, { label: 'Terms', href: '/rack/mealstack/terms' }, { label: 'Support', href: '/rack/support' }]}
/>
