---
import { SHOW_APP_SCREENS } from '../data/screens';
/**
 * Home — landing page.
 *
 * Rebuilt Sept 20, 2026 (focus pass, same as the app landing pages). The old home
 * gave the book, the Loadout, the Rack and Logs equal weight in four card bands plus
 * a stat strip, and nothing told a visitor where to go. Mike's call: the book and the
 * two iPhone apps are the goals; the Loadout skills are great but niche.
 *
 *   1. Hero: the book. One primary button (Start reading), Download beside it,
 *      the facts as one mono line, the author.
 *   2. The apps: IronStack and MealStack, each with a real screen, its promise and
 *      Join the beta. IronStack's card lays its Apple Watch screen over the phone (Oct 1, 2026). Chalk only here: oxblood stays with "Built." and Start reading.
 *   3. More: one quiet row with the Loadout (for product leaders) and the latest log.
 *
 * Ambient: a fixed radial gradient overlay (chalk-dust top-left, oxblood bottom-right).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TopNav from '../components/TopNav.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import WatchFrame from '../components/WatchFrame.astro';
import { getCollection } from 'astro:content';
import { MB, TOTAL_CHAPTERS, totalReadTime, sectionUrl } from '../data/book.ts';
import { byNewest, logUrl } from '../data/logs';

const latestLog = (await getCollection('logs', ({ data }) => !data.draft)).sort(byNewest)[0];

const apps = [
  {
    name: 'IronStack', href: '/rack/ironstack',
    tag: 'Private beta · iPhone + Apple Watch',
    promise: 'Log fast. See progress. A coach in your corner.',
    line: 'A lifting log for your phone and your wrist, with big timers, insights, a real coach who sends your plan, and Stack AI, which picks your next weight from your own sets.',
    shot: { src: '/images/ironstack/hero-session.webp', w: 540, h: 1174, alt: 'IronStack on iPhone mid-workout on a coach\'s plan: Box Squat, set 1 of 5, 275 for 3, with Log lit.' },
    watch: { src: '/images/ironstack/watch-set.webp', w: 422, h: 514, alt: 'The same set on Apple Watch: Box Squat, 275 lb for 3, Tap to log.' },
  },
  {
    name: 'MealStack', href: '/rack/mealstack',
    tag: 'Private beta · iPhone',
    promise: 'Your tracker says what you ate. This says when.',
    line: 'Meal timing built backward from your training session. Eat late and the day re-flows; your pre-workout meal still lands.',
    shot: { src: '/images/mealstack/today-training.webp', w: 540, h: 1174, alt: 'MealStack Today on a training day with the session at 6:30 PM: the yogurt logged late at 11:40, lunch next at 2:40 PM, and the Home travel chip under the MealStack header.' },
    watch: undefined,
  },
];
---
<BaseLayout title="Mission Built · A Field Guide for Building Things That Matter" active="book">
  <div class="ambient" aria-hidden="true"></div>
  <TopNav active="book" />

  <main id="main" class="page">
    {/* ---------- 1. THE BOOK ---------- */}
    <section class="hero">
      <div class="hero-head">
        <p class="eyebrow">
          <span class="dots" aria-hidden="true">▮▮▮</span>
          <span>An open-source book by Mike Nichols</span>
          <span class="dots" aria-hidden="true">▮▮▮</span>
        </p>
        <h1 class="display"><span class="line">Mission</span><span class="line built">Built.</span></h1>
        <p class="subtitle">A field guide for building things that matter.</p>
      </div>

      <div class="hero-side">
        <p class="blurb">{MB.blurbLong}</p>
        <div class="buttons">
          <a href={sectionUrl(MB.prologue.n, MB.prologue.title)} class="btn primary">Start reading <span aria-hidden="true">→</span></a>
          <a href="/download" class="btn ghost"><span aria-hidden="true">↓</span> Download</a>
        </div>
        <p class="facts">{TOTAL_CHAPTERS} chapters · {totalReadTime()} · free to read · <a href="/chapters">All chapters →</a></p>
        <div class="author">
          <div class="avatar" aria-hidden="true">MN</div>
          <div class="author-meta">
            <a href="/about" class="author-name">{MB.author}</a>
            <div class="author-tag">{MB.authorTagline}</div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- 2. THE APPS ---------- */}
    <section class="band" aria-labelledby="apps-h">
      <div class="band-head">
        <h2 id="apps-h" class="band-title">The apps. <span class="band-sub">Two iPhone apps for people who train.</span></h2>
        <a href="/rack" class="band-link">The Rack <span aria-hidden="true">→</span></a>
      </div>
      <div class="apps">
        {apps.map((a) => (
          <a class:list={['app', a.watch && 'has-watch']} href={a.href}>
            {SHOW_APP_SCREENS && <div class:list={['shot', a.watch && 'with-watch']}>
              <div class="shot-phone"><PhoneFrame shot={a.shot} fill /></div>
              {a.watch && <div class="shot-watch"><WatchFrame shot={a.watch} /></div>}
            </div>}
            <div class="app-body">
              <p class="tag"><span class="sq" aria-hidden="true"></span>{a.tag}</p>
              <h3 class="app-name">{a.name}</h3>
              <p class="promise">{a.promise}</p>
              <p class="app-line">{a.line}</p>
              <span class="app-cta">Join the beta →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* ---------- 3. MORE ---------- */}
    <section class="band more" aria-label="More from Mission Built">
      <a class="more-item" href="/loadout">
        <span class="k">The Loadout</span>
        <span class="t">For product leaders: open-source Claude skills for the boardroom half of the book.</span>
        <span class="c" aria-hidden="true">→</span>
      </a>
      {latestLog && (
        <a class="more-item" href={logUrl(latestLog)}>
          <span class="k">Latest log</span>
          <span class="t">{latestLog.data.title}</span>
          <span class="c" aria-hidden="true">→</span>
        </a>
      )}
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .ambient { position: fixed; inset: 0; pointer-events: none; opacity: 0.55; z-index: 0;
    background: radial-gradient(1200px 600px at 20% -10%, rgba(255,250,235,.04), transparent 60%),
                radial-gradient(800px 500px at 110% 110%, rgba(168,33,26,.10), transparent 60%); }
  .page { position: relative; z-index: 1; }

  /* HERO */
  .hero { padding: 64px var(--pad-page-x) 8px; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: end; }
  .eyebrow { display: inline-flex; align-items: center; gap: 14px; margin: 0 0 20px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em; color: var(--color-chalk-dim); text-transform: uppercase; }
  .eyebrow .dots { letter-spacing: 0.04em; color: var(--color-blood-bright); }
  .display { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(56px, 11vw, 132px); line-height: 0.88; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .display .line { display: block; }
  .display .built { color: var(--color-blood-bright); }
  .subtitle { margin: 22px 0 0; font-family: var(--font-display); font-weight: 400; font-size: 22px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-chalk-dim); }
  .blurb { margin: 0; max-width: 52ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.6; color: var(--color-chalk); }
  .buttons { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 15px 24px; font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--color-rule); color: var(--color-chalk); transition: background 120ms ease-out; }
  .btn.primary { background: var(--color-blood); border-color: var(--color-blood); }
  .btn.primary:hover { background: var(--color-blood-bright); }
  .btn.ghost:hover { background: var(--color-panel); }
  .facts { margin: 16px 0 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .facts a { color: var(--color-chalk-dim); border-bottom: 1px solid var(--color-chalk-ghost); }
  .facts a:hover { color: var(--color-chalk); }
  .author { margin-top: 26px; padding-top: 18px; border-top: 1px dashed var(--color-rule); display: flex; gap: 14px; align-items: center; }
  .avatar { width: 40px; height: 40px; display: grid; place-items: center; border: var(--border-thin); background: var(--color-panel); font-family: var(--font-display); font-size: 15px; color: var(--color-chalk-dim); }
  .author-name { font-family: var(--font-display); font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-chalk); }
  .author-tag { margin-top: 2px; font-family: var(--font-serif); font-size: 13px; color: var(--color-chalk-faint); }

  /* BANDS */
  .band { padding: 80px var(--pad-page-x) 0; }
  .band-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; margin-bottom: 24px; }
  .band-title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 26px; letter-spacing: 0.03em; text-transform: uppercase; color: var(--color-chalk); }
  .band-sub { color: var(--color-chalk-dim); }
  .band-link { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-dim); border-bottom: 1px solid var(--color-chalk-ghost); padding-bottom: 2px; white-space: nowrap; }
  .band-link:hover { color: var(--color-chalk); }

  /* APPS */
  .apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--border-thin); border-left: var(--border-thin); }
  .app { min-width: 0; display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 28px; padding: 28px 28px 0; border-right: var(--border-thin); border-bottom: var(--border-thin); transition: background 120ms ease-out; }
  .app:hover { background: var(--color-panel); }
  /* The card crops the phone at its foot: the crop is on .shot, around the whole PhoneFrame, so
     the frame and the screen are cut together. Sideways it stays open for the side buttons. */
  .shot { height: 250px; overflow-x: visible; overflow-y: clip; align-self: end; }
  /* IronStack: a 200px column, the phone 160px pushed right, the watch in front of it at the left,
     its case about 118px down. --s scales the group on phones. */
  .app.has-watch { grid-template-columns: 200px minmax(0, 1fr); }
  .shot.with-watch { --s: 1; position: relative; }
  .shot.with-watch .shot-phone { position: relative; z-index: 2; width: calc(160px * var(--s)); margin-left: auto; }
  .shot-watch { position: absolute; left: 0; top: calc(80px * var(--s)); font-size: calc(11px * var(--s)); }
  .app-body { padding-bottom: 28px; display: grid; gap: 10px; align-content: start; }
  .tag { margin: 0; display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-chalk-dim); }
  .tag .sq { width: 7px; height: 7px; border: 1px solid var(--color-chalk-dim); }
  .app-name { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 28px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-chalk); }
  .promise { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 18px; line-height: 1.2; text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-chalk); }
  .app-line { margin: 0; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .app-cta { margin-top: 6px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk); }
  .app:hover .app-cta { color: var(--color-blood-text); }

  /* MORE */
  .more { padding-top: 56px; padding-bottom: 72px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
  .more-item { display: grid; grid-template-columns: 130px minmax(0, 1fr) auto; gap: 18px; align-items: baseline; padding: 18px 0; border-top: 1px dashed var(--color-rule); margin-right: 28px; }
  .more-item .k { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .more-item .t { font-family: var(--font-serif); font-size: 15px; line-height: 1.5; color: var(--color-chalk-dim); }
  .more-item .c { font-family: var(--font-mono); color: var(--color-chalk-faint); }
  .more-item:hover .t, .more-item:hover .c { color: var(--color-chalk); }

  @media (max-width: 1099px) {
    .hero, .band { padding-left: var(--pad-page-x-mid); padding-right: var(--pad-page-x-mid); }
    .hero { grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: start; }
    .apps { grid-template-columns: minmax(0, 1fr); }
    .more { grid-template-columns: minmax(0, 1fr); }
    .more-item { margin-right: 0; }
  }
  @media (max-width: 720px) {
    .hero, .band { padding-left: var(--pad-page-x-mobile); padding-right: var(--pad-page-x-mobile); }
    .hero { padding-top: 36px; }
    .subtitle { font-size: 17px; }
    .blurb { font-size: 17px; }
    .btn { flex: 1 1 auto; justify-content: center; padding: 14px 16px; }
    .band { padding-top: 56px; }
    .band-head { flex-direction: column; gap: 10px; }
    .band-title { font-size: 21px; }
    .app { grid-template-columns: 112px minmax(0, 1fr); gap: 18px; padding: 22px 18px 0; }
    .shot { height: 190px; }
    .app.has-watch { grid-template-columns: 124px minmax(0, 1fr); }
    .shot.with-watch { --s: 0.62; }
    .app-name { font-size: 22px; }
    .promise { font-size: 15px; }
    .app-line { display: none; }
    .more-item { grid-template-columns: minmax(0, 1fr) auto; }
    .more-item .k { grid-column: 1 / -1; }
  }
</style>
