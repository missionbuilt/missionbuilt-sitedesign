---
/**
 * Ironstack — standalone page.
 *
 * A training partner with your whole history in its head. Two Claude skills,
 * seven Kibana dashboards, and a Kibana Agent Builder coach over a private
 * Elasticsearch you own. No MCP server, nothing phones home. In testing:
 * the code is public in the Loadout repo; the install doors open with v1.0.
 *
 * Color discipline: oxblood for the hero period, eyebrows, section labels,
 * the one marked verdict card, and the closer accent. Army green for the
 * license stat only.
 *
 * The three "app" frames are HTML replicas of the real dashboards on Kibana's
 * navy ground with fictional data. They use Inter for the Kibana chrome and
 * the coach chat, on purpose: they depict Kibana, not the site. They are laid
 * out at a fixed design width and scaled to their container by the script at
 * the foot of the page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';

const SOURCE = 'https://github.com/missionbuilt/loadout/tree/main/ironstack';

const stats = [
  { key: 'Dashboards', value: '7',          sub: undefined,       href: undefined },
  { key: 'Skills',     value: '2',          sub: '+ 1 coach',     href: undefined },
  { key: 'Status',     value: 'In testing', sub: 'v1 to follow',  href: undefined },
  { key: 'Source',     value: 'GitHub',     sub: undefined,       href: SOURCE },
];

type QA = { q: string; a: string; body: string };
const atTheRack: QA[] = [
  { q: 'Comp bench today and the program gives no opener.', a: 'Open at 185.', body: 'Under your 228 ceiling, from the Sept 4 set. Your all-time best is older; not the number to chase today.' },
  { q: 'Third set felt like a 9 and the sheet says 8.', a: 'Hold the load, drop a rep.', body: 'Last time you pushed through a 9 in week 3 you wrote "slow off the chest" for the next two sessions.' },
  { q: 'Squat rack is taken. What covers it in this block?', a: 'Belt squat or front squat.', body: 'Same pattern, and you have logged both in a strength phase before.' },
  { q: 'Cue me on the next set.', a: 'Brace before the unrack.', body: 'Your own note from the last three chain sessions.' },
];
const atTheTable: QA[] = [
  { q: 'How heavy was this week?', a: 'Heavier than 10 of your last 12.', body: 'Heavy means heavy for you now: measured against your best in the trailing 90 days, not an all-time PR.' },
  { q: 'Am I ramping?', a: 'Ramping.', body: 'Seven-day load 37% above your four-week average. The last two times you were here: Jul 2026, May 2026.' },
  { q: 'What am I neglecting?', a: 'Calves: 17 days. Normally every 6.', body: 'Beside it, in your own words, you wrote "grip" five times this month. The gap between the two is the finding.' },
  { q: 'Was I flat every time I trained on the road?', a: 'Four of five sessions.', body: 'Found by meaning, not keyword: "no pop", "dragging" and "tired" all count. Joined to what you lifted on those days.' },
];

type Card = { label: string; verdict: string; evidence: string; scope: string; mark?: boolean };
const cards: Card[] = [
  { mark: true, label: 'Heavy means heavy for you now', verdict: 'Heavier than 10 of your last 12 weeks.', evidence: 'Every set is measured against your best in the trailing 90 days, not an all-time PR. Come back from a layoff and other apps call everything light. Ironstack knows what heavy is this month.', scope: 'Overview · intensity' },
  { label: 'Precedent', verdict: 'The last two times you were here.', evidence: 'Ramping is a number on a chart until something holds seven years of your history and can say: this load band, this phase, Jul 2026 and May 2026, and what happened next.', scope: 'Overview · load' },
  { label: 'The machine versus your own words', verdict: 'It says calves. You wrote grip.', evidence: 'The computed drift and what you told yourself to watch sit on the same screen. When they disagree, that is the most interesting thing on the page, and nothing else shows it.', scope: 'Overview · drift, in your own words' },
  { label: 'Notes with meaning', verdict: 'Flat, dragging, no pop: one question.', evidence: 'Your notes are indexed for meaning, not keywords, and joined to the sets. How you felt and what you lifted have never been in the same query before. Optional, and it degrades to full text without it.', scope: 'Elastic semantic text · recall and the coach' },
  { label: 'A coach with a ceiling', verdict: 'Open at 185. Here is why.', evidence: 'Starting loads, a cue from your own notes, an alternative in the same pattern, a rep off the plan when the set said 9. Never above your ceiling, and it names the set the ceiling came from. Not your program. Not a doctor.', scope: 'Coach · Kibana Agent Builder' },
  { label: 'It names its threshold', verdict: 'Two meets is a comparison, not a rule.', evidence: 'When the data is thin the card says how much it needs and when the verdict unlocks, in the same type as a finding. A logging app shows you a zero. This tells you why.', scope: 'Every card · honest declines' },
];

type Versus = { k: string; them: string; us: string };
const versus: Versus[] = [
  { k: 'Logs a set', them: 'Three taps at the rack.', us: 'Tell Claude, in your own words, with the bar and how it felt.' },
  { k: 'Compares against', them: 'Your all-time PR.', us: 'Your best in the trailing 90 days. Heavy for you now.' },
  { k: 'Tells you', them: 'A chart, going up and to the right.', us: 'A sentence, the number behind it, the window it counted.' },
  { k: 'When it cannot say', them: 'Shows a zero.', us: 'Says what it needs and when the verdict unlocks.' },
  { k: 'Your notes', them: 'A text box per set nobody can search.', us: 'Indexed for meaning, joined to the sets, read by the coach.' },
  { k: 'Answers a question', them: 'No.', us: 'Ask the coach, over your actual history, with a ceiling it shows you.' },
  { k: 'Your data', them: 'On their servers.', us: 'In your repo and your Elastic. Nothing phones home.' },
  { k: 'Best at', them: 'Logging. They have spent years on it, and Ironstack will not try to beat them.', us: 'Reading. Keep your logging app for the rack if you like; come here for the verdict.' },
];

type Rung = { n: string; name: string; what: string; needs: string; gives: string };
const rungs: Rung[] = [
  { n: '1', name: 'The skill', what: 'Claude as your workout partner. It logs what you say, keeps the count, and offers a cue when you want one. A markdown journal, one file per session, in a repo only you can read.', needs: 'Claude. A private repo.', gives: 'A log you own, in words you wrote.' },
  { n: '2', name: 'The stack', what: 'Elasticsearch, free self-hosted or Serverless. The starter ships the schema, the mappings, and a GitHub Action that indexes every session on push. Reindex is safe: the ids are deterministic.', needs: 'An Elastic endpoint and a write key, as two repo secrets.', gives: 'Recall. Ask about any lift, any day, any note. Semantic search when the tier has it.' },
  { n: '3', name: 'The dashboards', what: 'Seven Kibana pages linked by drilldowns, in Iron Log. One saved-objects file, one import. The verdict cards, the honest declines, the method written once at the foot of each page.', needs: 'Kibana. One import script, or Stack Management.', gives: 'The read of your training, not a copy of your log.' },
  { n: '4', name: 'The coach', what: 'A Kibana Agent Builder agent. The prompt, the tools it runs, and the ceiling rule are files in the repo. Ask your training partner from any dashboard, top right.', needs: 'Agent Builder on your Elastic tier. Ten minutes in Kibana with the README.', gives: 'A starting weight with its reasoning. A decline when you ask for a program.' },
];

const dashboards = [
  ['Overview', 'Signals and verdicts'],
  ['Program', 'Block, week, phase'],
  ['Session', 'One day, top set first'],
  ['Lift', 'e1RM over time'],
  ['History', 'Every session'],
  ['Meets', 'Attempts and tapers'],
  ['Mindset', 'Your notes, read back'],
];
---
<BaseLayout
  title="Ironstack · The Loadout · Mission Built"
  description="Weight is a number. Heavy is a feeling. A training partner with your whole history in its head: two Claude skills, seven Kibana dashboards, and a coach with a ceiling, over an Elasticsearch you own. Open source, nothing phones home. In testing."
  active="loadout"
>
  <TopNav active="loadout" />

  {/* Inter is for the Kibana replicas only. The site's three faces are loaded by BaseLayout. */}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" />

  <main class="page">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/loadout">The Loadout</a>
      <span aria-hidden="true"> / </span>
      <span class="here">Ironstack</span>
    </nav>

    {/* ---------- HERO ---------- */}
    <section class="hero">
      <p class="eyebrow">
        <span class="dots" aria-hidden="true">▮▮▮</span>
        <span>A skill from the Loadout</span>
        <span class="dots" aria-hidden="true">▮▮▮</span>
      </p>

      <h1 class="display">
        <span>Ironstack</span><span class="dot">.</span>
      </h1>

      <div class="testing-tag" aria-label="In testing">
        <span class="tag-sq" aria-hidden="true"></span>
        <span>In testing</span>
      </div>

      <p class="subtitle">
        <span class="line1">Weight is a number. Heavy is a feeling.</span>
        <span class="line2">Other apps know the number. Ironstack knows how it felt.</span>
      </p>
    </section>

    {/* ---------- META STRIP ---------- */}
    <section class="meta-strip" aria-label="Ironstack at a glance">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-key">{s.key}</div>
          {s.href ? (
            <a class="stat-value linked" href={s.href} target="_blank" rel="noopener">{s.value}<span class="ext" aria-hidden="true"> ↗</span></a>
          ) : (
            <div class="stat-value">{s.value}{s.sub && <span class="stat-sub">{s.sub}</span>}</div>
          )}
        </div>
      ))}
    </section>

    {/* ---------- WHAT THIS IS ---------- */}
    <section class="block">
      <p class="section-label">What this is</p>
      <h2 class="section-h2">A training partner with your whole history in its head.</h2>
      <p class="prose">
        Other apps know the number: the weight, the reps, the date. Ironstack holds
        every set you have ever done and every note you wrote about how it felt, which
        bar you had in your hands, where you were, and what you told yourself to watch
        next time. Then it uses all of it, in two places.
      </p>

      <div class="moments">
        <div class="moment">
          <p class="k">At the rack · in the moment</p>
          <h3>It adjusts the day with you.</h3>
          <p class="how">Talk to it between sets. It answers from your ceiling, your notes, and your program, and it shows its reasoning.</p>
          <ul class="ask">
            {atTheRack.map((x) => (
              <li><span class="q">{x.q}</span><span class="a"><b>{x.a}</b>{x.body}</span></li>
            ))}
          </ul>
        </div>
        <div class="moment">
          <p class="k">At the table · the deep read</p>
          <h3>It tells you what the week meant.</h3>
          <p class="how">Seven dashboards, verdict first. A sentence, the number behind it, the window it counted, and an honest decline when it cannot say.</p>
          <ul class="ask">
            {atTheTable.map((x) => (
              <li><span class="q">{x.q}</span><span class="a"><b>{x.a}</b>{x.body}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- WHY IT IS NOT A LOGGING APP ---------- */}
    <section class="block">
      <p class="section-label">Why it is not a logging app</p>
      <h2 class="section-h2">What no logging app can say.</h2>
      <p class="prose">
        Each of these needs your whole history, your notes, and a reader that has both.
        Other apps have the sets. They have never had the rest.
      </p>

      <div class="cards">
        {cards.map((c) => (
          <article class:list={['card', c.mark && 'mark']}>
            <p class="label">{c.label}</p>
            <p class="verdict">{c.verdict}</p>
            <p class="evidence">{c.evidence}</p>
            <p class="scope">{c.scope}</p>
          </article>
        ))}
      </div>

      <div class="versus" aria-label="Ironstack compared with other apps">
        <div class="vh"><span></span><span>Other apps</span><span>Ironstack</span></div>
        {versus.map((v) => (
          <div class="vr"><span class="vk">{v.k}</span><span>{v.them}</span><span>{v.us}</span></div>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- SEE IT: replicas on fictional data ---------- */}
    <section class="block">
      <p class="section-label">See it</p>
      <h2 class="section-h2">The first screen is a verdict.</h2>
      <p class="prose">
        Three screens from the app, redrawn with invented numbers. The real ones look
        like this with your history behind them.
      </p>

      <div class="shots">
        <figure class="shot wide">
          <div class="frame">
            <div class="app" data-w="1460">
              <div class="brand"><span class="lock">Iron <span class="sq"></span> Stack <span class="pg">Overview</span></span><span class="right"><span class="a-tag">A Mission Built training system</span><span class="coach">Ask the coach ↗</span></span></div>
              <div class="a-nav sans"><span class="on">Overview</span><span>Program</span><span>Session</span><span>History</span><span>Meets</span><span>Mindset</span></div>
              <div class="a-cards">
                <div class="a-card">
                  <p class="k">How heavy was this week <span class="pill">Open week</span></p>
                  <p class="a-verdict">Heavier than 8 of your last 12 weeks.</p>
                  <p class="ev"><b>6</b> of <b>61</b> main-lift reps at 80% or more of your 90-day best.</p>
                  <p class="mono">Open week, so ranked per training day: 1.5 across 4 so far.</p>
                  <div class="gauge"><i style="width:9%"></i><b style="left:12%"></b></div>
                  <p class="mono">Tick: your 12-week average, 4.1 reps a week.</p>
                  <div class="dsh"></div>
                  <p class="ptr">Main lifts only, ranked against your last 13 weeks<br />History › reps by week</p>
                </div>
                <div class="a-card">
                  <p class="k">Am I ramping</p>
                  <p class="a-verdict">Ramping.</p>
                  <p class="ev">7-day load <b>24%</b> above your 4-week average.<br />Monotony 1.12.<br />Measured to 2026-09-06; you last trained 2026-09-05.</p>
                  <p class="mono">The last two times you were here: <b>Jun 2026, Mar 2026.</b></p>
                  <div class="dsh"></div>
                  <p class="ptr">Tonnage, 7 days against the trailing 28<br />History › acute vs chronic</p>
                </div>
                <div class="a-card">
                  <p class="k">What am I neglecting</p>
                  <p class="a-verdict">Rear delts: 16 days.<span class="sq"></span></p>
                  <p class="ev">Normally every <b>5</b> days.</p>
                  <div class="gauge blood"><i style="width:100%"></i><b style="left:31%"></b></div>
                  <p class="mono">Tick: your normal gap.<br />Indexed 2026-09-06.</p>
                  <div class="dsh"></div>
                  <p class="ptr">Working sets over the whole log, not this page's range<br />Session › every set</p>
                </div>
              </div>
            </div>
          </div>
          <figcaption class="cap"><span class="k">Overview</span>The first screen is verdicts, not your log. Each card states a finding, shows one number, names its window, and declines when it cannot say.</figcaption>
        </figure>

        <figure class="shot">
          <div class="frame">
            <div class="app" data-w="1460">
              <div class="brand"><span class="lock">Iron <span class="sq"></span> Stack <span class="pg">Session</span></span><span class="right"><span class="a-tag">A Mission Built training system</span><span class="coach">Ask the coach ↗</span></span></div>
              <div class="a-nav sans"><span>Overview</span><span>Program</span><span class="on">Session</span><span>History</span><span>Meets</span><span>Mindset</span></div>
              <div class="sess">
                <div>
                  <p class="k">Session</p>
                  <h4>Strength <span class="sq"></span> Week 6 <span class="sq"></span> Day 2 of 4</h4>
                  <p class="mono">Friday, Sep 5, 2026 · Home gym<br />prev 2026-09-03 &nbsp; next none &nbsp; the table on the right walks to either</p>
                </div>
                <div>
                  <p class="sans th-label">Prev / next</p>
                  <div class="table"><div class="th"><span>Session ↓</span><span>Prev</span><span>Next</span></div><div class="td"><span>2026-09-05</span><span>2026-09-03</span><span class="null">(null)</span></div></div>
                </div>
              </div>
              <div class="top">
                <div><p class="k">Top set</p><p class="big">205<small>lb</small><span class="x">×</span>5<span class="x">@</span>8</p><p class="lift">Comp bench</p></div>
                <div class="tile"><p class="k">Tonnage</p><p class="v">12,480 <small>lb</small></p><p class="mono">moved this session</p></div>
                <div class="tile"><p class="k">Length</p><p class="v">1h 12m</p><p class="mono">3 day streak</p></div>
                <div class="tile"><p class="k">Avg working RPE</p><p class="v">7.4</p><p class="mono">14 working sets</p></div>
                <div class="tile"><p class="k">Sets</p><p class="v">26</p><p class="mono">218 reps · 12 lifts</p></div>
              </div>
            </div>
          </div>
          <figcaption class="cap"><span class="k">Session</span>One day. The main lift's top set in the header, the comparison with last time, your notes underneath.</figcaption>
        </figure>

        <figure class="shot">
          <div class="frame">
            <div class="app chat" data-w="1165">
              <div class="who"><span class="av">IC</span><span class="name">Ironstack Coach</span><span class="agent">Agent</span><span class="t">· 6:41 AM</span></div>
              <p class="tools">8 tools ran ›</p>
              <p>Here is the read for today's bench (9/7), two days out from your last bench session (9/5):</p>
              <p><b>Start your working sets at 200 ×5</b>, straight bar. That is one step under what you actually hit for reps last time.</p>
              <p><b>Why:</b></p>
              <ul>
                <li>Ceiling check: <code>lift_ceiling</code> on comp-bench caps at <b>241 lb</b> (estimated), from the 9/5 session, 205 ×5 @RPE 8, and you wrote "last rep slowed" on that set. Nothing today should approach that number.</li>
                <li>Heaviest weight you have actually lifted in the last 90 days is <b>205 lb</b>. Your all-time meet best is 248 lb (4/12/2025), an old PR, not the number to chase today.</li>
              </ul>
              <p>Want a warm-up progression up to 200?</p>
            </div>
          </div>
          <figcaption class="cap"><span class="k">Coach</span>A starting load, the ceiling it sits under, and the set that ceiling came from. Then a decline when asked for a program.</figcaption>
        </figure>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- WHAT SHIPS ---------- */}
    <section class="block" id="ships">
      <p class="section-label">What ships</p>
      <h2 class="section-h2">Start with a file. Add a stack when you want one.</h2>
      <p class="prose">
        Each rung is optional. The skill works on its own with nothing but Claude and a
        folder. Every rung after it adds one thing, and nothing you have already logged
        changes.
      </p>

      <div class="ladder">
        {rungs.map((r) => (
          <div class="rung">
            <span class="n">{r.n}</span>
            <div><h3>{r.name}</h3><p class="what">{r.what}</p></div>
            <div class="col"><p class="k">Needs</p><p>{r.needs}</p></div>
            <div class="col"><p class="k">Gives</p><p>{r.gives}</p></div>
          </div>
        ))}
      </div>

      <div class="dash" aria-label="The seven dashboards">
        {dashboards.map(([name, sub]) => (
          <span>{name}<small>{sub}</small></span>
        ))}
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- GET IT ---------- */}
    <section class="install-block" id="get">
      <p class="section-label">Get it</p>
      <h2 class="section-h2">Three ways in, when it ships.</h2>
      <p class="install-intro">
        One repo is the source of truth for all three. Pick the door that matches how
        much of the stack you want.
      </p>

      <div class="status" role="status">
        <span class="pill">In testing</span>
        <p><strong>Ironstack is in daily use by its author before v1.</strong> The code is public in the Loadout repo today and you are welcome to read it. The doors below open with the v1.0 release, once a fresh install has been proven on a machine that is not mine.</p>
        <a class="status-link" href={SOURCE} target="_blank" rel="noopener">Watch the repo <span aria-hidden="true">↗</span></a>
      </div>

      <div class="doors closed">
        <article class="door lead">
          <p class="k">Door 1 · recommended</p>
          <h3>Let Claude install it</h3>
          <p>Add the Ironstack skills to Claude Code and say <em>set up Ironstack</em>. The setup skill creates your private repo from the starter, asks for your Elastic endpoint and key once, indexes the example session, imports the dashboards, and walks you through the coach. It stops at every step that touches your account.</p>
          <pre class="code"><span class="c"># skills only, no server, nothing phones home</span>
git clone https://github.com/missionbuilt/loadout
cp -r loadout/ironstack/skills/* ~/.claude/skills/
<span class="c"># then, in Claude Code:</span>
&gt; set up Ironstack</pre>
          <p class="foot-line">Rungs 1 to 4 · opens with v1.0</p>
        </article>
        <article class="door">
          <p class="k">Door 2</p>
          <h3>Do it yourself</h3>
          <p>Use the template repo for your private instance, add two secrets, run the setup script, and import the dashboards from the latest release in Stack Management. The coach README takes it from there.</p>
          <pre class="code">github.com/missionbuilt/ironstack-template
<span class="c">  → Use this template → private</span>
Secrets: ES_ENDPOINT, ES_API_KEY
python ingest/setup_indices.py
python ingest/index_workouts.py
<span class="c"># dashboards.ndjson from Releases</span></pre>
          <p class="foot-line">Rungs 2 to 4 · opens with v1.0</p>
        </article>
        <article class="door">
          <p class="k">Door 3</p>
          <h3>Just the skill</h3>
          <p>Download the workout-partner skill as a folder and start logging today. No Elastic, no dashboards. Your journal is markdown in a folder you choose. Add the stack whenever you want the verdicts.</p>
          <pre class="code">workout-partner.zip
workout-recall.zip
<span class="c"># drop into ~/.claude/skills/</span></pre>
          <p class="foot-line">Rung 1 · opens with v1.0</p>
        </article>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- FINE PRINT ---------- */}
    <section class="block">
      <div class="fine">
        <p class="k">Fine print</p>
        <p>Ironstack is a training partner, not a programmer and not a doctor. It will give you a starting weight under a ceiling it can show you, a cue for the set in front of you, or an alternative when the plan calls for a lift you cannot do today. It will not write your program. Any question about pain or injury gets a pointer to reputable material and a qualified person, and nothing else.</p>
        <p>Your logs stay in your repo and your Elastic project. The Loadout has no server in the loop, collects nothing, and cannot see your data.</p>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- ALSO IN THE KIT ---------- */}
    <section class="block">
      <p class="section-label">Also in the kit</p>
      <h2 class="section-h2">The full Loadout.</h2>

      <div class="related">
        <a href="/loadout/warmup" class="related-card">
          <h3>The Warmup</h3>
          <p>A daily intelligence brief for your first coffee. Curated sources, link safety scanning, live artifact.</p>
          <span class="related-cta">Open →</span>
        </a>
        <a href="/loadout/floodlight" class="related-card">
          <h3>Floodlight</h3>
          <p>Build your security visibility plan from three inputs. Standalone and offline, like this one.</p>
          <span class="related-cta">Open →</span>
        </a>
      </div>
    </section>

    <hr class="dashed" />

    {/* ---------- OPEN SOURCE ---------- */}
    <section class="block">
      <h2 class="section-h2">Open source.</h2>
      <p class="prose">
        Ironstack ships under MIT, like the rest of the kit. The skills, the starter,
        the dashboards, and the coach's prompt and tools live in
        <a class="inline-link" href={SOURCE} target="_blank" rel="noopener">github.com/missionbuilt/loadout</a>.
        Your data never does.
      </p>
    </section>

    {/* ---------- CLOSER ---------- */}
    <section class="closer">
      <p>
        Weight is a number. <strong>Heavy is a feeling.</strong>
      </p>
    </section>

    {/* ---------- FOOTER ---------- */}
    <footer class="foot">
      <span>Real strength is lifting others</span>
      <a href="https://github.com/missionbuilt/loadout" target="_blank" rel="noopener">github.com/missionbuilt/loadout</a>
    </footer>
  </main>
</BaseLayout>

<script>
  // Scale each fixed-width app replica to its frame. Design widths come from data-w.
  function fit() {
    document.querySelectorAll<HTMLElement>('.app').forEach((a) => {
      const w = Number(a.dataset.w);
      const box = a.parentElement as HTMLElement;
      const s = box.clientWidth / w;
      a.style.width = w + 'px';
      a.style.transform = 'scale(' + s + ')';
      box.style.height = Math.round(a.offsetHeight * s) + 'px';
    });
  }
  fit();
  window.addEventListener('resize', fit);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
</script>

