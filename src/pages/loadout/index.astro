---
/**
 * The Loadout — overview page (/loadout).
 *
 * Rebuilt Sept 20, 2026 in the site-wide focus pass. The Loadout is the niche half
 * (product leaders), so the page does two jobs, fast: show the three skills on real
 * screens, and get them into Claude. Order: hero (one action: Add to Claude) → the
 * three skills, each with its demo screen → install (one URL, two ways; the zips and
 * git clone folded under "Other ways") → closer.
 * Screens: public/images/loadout/*.webp, captured from the site's own demos
 * (public/demos/*.html) with the tour overlay hidden.
 * Backup: Claude outputs/loadout-index-before-2026-09-20.astro.bak.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TopNav from '../../components/TopNav.astro';

const skills = [
  { name: 'The Warmup', href: '/loadout/warmup', img: 'warmup', when: 'Before your first meeting',
    line: 'A daily brief for your first coffee: what moved in your field overnight, every link scanned for safety.' },
  { name: 'The Approach', href: '/loadout/approach', img: 'approach', when: 'Before a customer call',
    line: 'A pre-call brief for enterprise meetings and QBRs: the account, the decision makers, live signals.' },
  { name: 'The Spotter', href: '/loadout/spotter', img: 'spotter', when: 'Before an epic ships',
    line: 'Walk an epic through nine product-leadership areas and get a worksheet back, area by area.' },
];
const URL_SSE = 'https://mcp.missionbuilt.io/sse';
---
<BaseLayout
  title="The Loadout · Mission Built"
  description="Three open-source Claude skills for product leaders: the Warmup, the Approach and the Spotter. One MCP connection, MIT licensed."
  active="loadout"
>
  <TopNav active="loadout" />

  <main id="main" class="page">
    <section class="hero">
      <p class="eyebrow"><span class="dots" aria-hidden="true">▮▮▮</span><span>Open-source skills from Mission Built</span><span class="dots" aria-hidden="true">▮▮▮</span></p>
      <h1 class="display">The Loadout<span class="dot">.</span></h1>
      <p class="sub">Three Claude skills for product leaders: the boardroom half of the book, put to work. One connection, all three, MIT.</p>
      <div class="ctas">
        <a class="cta" href="#install">Add to Claude →</a>
        <a class="soft" href="https://github.com/missionbuilt/loadout" target="_blank" rel="noopener">Source on GitHub ↗</a>
      </div>
    </section>

    <section class="skills" aria-label="The skills">
      {skills.map((s) => (
        <a class="skill" href={s.href}>
          <div class="shot"><img src={`/images/loadout/${s.img}.webp`} width="1200" height="760" alt={`${s.name}, from its live demo.`} loading="lazy" decoding="async" /></div>
          <div class="skill-body">
            <p class="when">{s.when}</p>
            <h2>{s.name}</h2>
            <p class="line">{s.line}</p>
            <span class="more">See it work →</span>
          </div>
        </a>
      ))}
    </section>

    <section class="install" id="install">
      <p class="section-label">One connection. All three skills.</p>
      <h2 class="section-h2">Add to Claude.</h2>
      <div class="url"><span class="k">Server URL</span><code>{URL_SSE}</code></div>
      <div class="ways">
        <div class="way">
          <h3>Claude · app</h3>
          <p>Settings → Connections → Add MCP Server. Paste the URL above and save.</p>
        </div>
        <div class="way">
          <h3>Claude Code · CLI</h3>
          <pre tabindex="0">claude mcp add loadout {URL_SSE}</pre>
        </div>
      </div>
      <details class="other">
        <summary>Other ways: offline downloads and git</summary>
        <p>Each skill is also a self-contained folder. The hosted server stays current; a download is pinned and runs offline. Drop one into any AI coding tool's skills folder.</p>
        <div class="dl">
          <a href="/downloads/warmup.zip" download>↓ warmup.zip</a>
          <a href="/downloads/the-approach.zip" download>↓ the-approach.zip</a>
          <a href="/downloads/spotter.zip" download>↓ spotter.zip</a>
        </div>
        <pre tabindex="0">git clone https://github.com/missionbuilt/loadout.git</pre>
      </details>
      <p class="note">Any MCP-compatible agent can connect. Tested on Claude. Want the barbell half? <a href="/rack">The Rack →</a></p>
    </section>

    <section class="closer"><p>The book is the plan. <strong>The Loadout is the execution.</strong></p></section>
  </main>
  <SiteFooter links={[{ label: 'github.com/missionbuilt/loadout', href: 'https://github.com/missionbuilt/loadout', external: true }]} />
</BaseLayout>

<style>
  .hero { padding: 56px var(--pad-page-x) 8px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 14px; margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em; color: var(--color-chalk-dim); text-transform: uppercase; }
  .eyebrow .dots { letter-spacing: 0.04em; color: var(--color-blood-bright); }
  .display { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(48px, 8vw, 96px); line-height: 0.95; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-chalk); }
  .dot { color: var(--color-blood-bright); }
  .sub { margin: 18px 0 0; max-width: 60ch; font-family: var(--font-serif); font-size: 18px; line-height: 1.6; color: var(--color-chalk-dim); }
  .ctas { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .cta { display: inline-flex; padding: 14px 22px; background: var(--color-blood); color: var(--color-chalk); font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; }
  .cta:hover { background: var(--color-blood-bright); }
  .soft { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-dim); border-bottom: 1px solid var(--color-chalk-ghost); padding-bottom: 2px; }
  .soft:hover { color: var(--color-chalk); }

  .skills { margin: 48px var(--pad-page-x) 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: var(--border-thin); border-left: var(--border-thin); }
  .skill { min-width: 0; display: grid; grid-template-rows: auto 1fr; border-right: var(--border-thin); border-bottom: var(--border-thin); transition: background 120ms ease-out; }
  .skill:hover { background: var(--color-panel); }
  .shot { padding: 22px 22px 0; background: var(--color-panel); border-bottom: var(--border-thin); overflow: hidden; height: 210px; }
  .shot img { display: block; width: 100%; height: auto; outline: 1px solid var(--color-rule); }
  .skill-body { padding: 22px 24px 26px; display: grid; gap: 10px; align-content: start; }
  .when { margin: 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .skill h2 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 26px; letter-spacing: 0.03em; text-transform: uppercase; color: var(--color-chalk); }
  .line { margin: 0; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .more { margin-top: 4px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk); }
  .skill:hover .more { color: var(--color-blood-text); }

  .install { padding: 72px var(--pad-page-x) 0; }
  .section-label { margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.24em; color: var(--color-blood-text); text-transform: uppercase; }
  .section-h2 { margin: 0 0 20px; font-family: var(--font-display); font-weight: 600; font-size: clamp(28px, 3.4vw, 40px); text-transform: uppercase; color: var(--color-chalk); }
  .url { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; padding: 16px 20px; background: var(--color-panel); border: var(--border-thin); max-width: 760px; }
  .url .k { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-chalk-faint); }
  .url code { font-family: var(--font-mono); font-size: 16px; color: var(--color-chalk); word-break: break-all; }
  .ways { margin-top: 20px; max-width: 760px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .way { min-width: 0; padding: 18px 20px; border: var(--border-thin); }
  .way h3 { margin: 0 0 8px; font-family: var(--font-display); font-weight: 500; font-size: 17px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-chalk); }
  .way p { margin: 0; font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  pre { margin: 0; padding: 10px 12px; overflow-x: auto; background: var(--color-bg); border: var(--border-thin); font-family: var(--font-mono); font-size: 13px; color: var(--color-chalk); }
  .other { margin-top: 20px; max-width: 760px; border-top: 1px dashed var(--color-rule); padding-top: 14px; }
  .other summary { cursor: pointer; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-chalk-dim); }
  .other p { font-family: var(--font-serif); font-size: 15px; line-height: 1.55; color: var(--color-chalk-dim); }
  .dl { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
  .dl a { padding: 8px 12px; border: var(--border-thin); font-family: var(--font-mono); font-size: 12px; color: var(--color-chalk); }
  .dl a:hover { background: var(--color-panel); }
  .note { margin: 22px 0 0; font-family: var(--font-mono); font-size: 12px; line-height: 1.6; color: var(--color-chalk-faint); }
  .note a { color: var(--color-chalk-dim); border-bottom: 1px solid var(--color-chalk-ghost); }

  .closer { margin-top: 72px; padding: 44px var(--pad-page-x); border-top: var(--border-thin); text-align: center; }
  .closer p { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 22px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-chalk); }
  .closer strong { font-weight: 500; color: var(--color-blood-text); }

  @media (max-width: 1099px) {
    .hero, .install, .closer { padding-left: var(--pad-page-x-mid); padding-right: var(--pad-page-x-mid); }
    .skills { margin-left: var(--pad-page-x-mid); margin-right: var(--pad-page-x-mid); grid-template-columns: minmax(0, 1fr); }
    .shot { height: 260px; }
  }
  @media (max-width: 720px) {
    .hero, .install, .closer { padding-left: var(--pad-page-x-mobile); padding-right: var(--pad-page-x-mobile); }
    .hero { padding-top: 32px; }
    .sub { font-size: 17px; }
    .skills { margin: 32px var(--pad-page-x-mobile) 0; }
    .shot { height: 170px; padding: 14px 14px 0; }
    .ways { grid-template-columns: minmax(0, 1fr); }
    .closer p { font-size: 18px; }
  }
</style>
